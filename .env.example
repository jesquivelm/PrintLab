PORT=3000
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require&channel_binding=require
PGSSLMODE=require
PGCHANNELBINDING=require

# Token compartido con el middleware DIAPI (debe coincidir con PrintLabApiKeyEncrypted
# configurado en el conector). Si se deja vacío, los endpoints /api/sap/outbox/pending,
# /api/sap/inbox/pending y /api/sap/mirror/push quedan sin autenticación.
DIAPI_SHARED_TOKEN=
