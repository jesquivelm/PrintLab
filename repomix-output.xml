                destinoInterno: {
                    metodo: 'GET',
                    url: buildSapQueryUrl()
                },
                serviceLayer: {
                    proveedor: getSapProviderLabel(),
                    origen: sourceLabel,
                    ruta: getSapProvider() === 'di-api' ? `/${sapQueryEntity?.value || 'business-partners'}` : buildSapServiceLayerQueryPath(),
                    urlFinal: buildSapProviderAbsoluteUrl()
                }
            });
            setSapQueryTrace([
                '1. El navegador prepara los filtros y arma la ruta interna del ERP.',
                `2. El navegador enviará: GET ${buildSapQueryUrl()}`,
                `3. El backend del ERP transformará esa solicitud y la reenviará a: GET ${buildSapProviderAbsoluteUrl()}`,
                '4. El ERP esperará la respuesta del servidor SAP y luego la mostrará en el panel de resultado.'
            ]);
        }

