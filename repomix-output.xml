                },
                productionOrder: {
                    sapObject: 'oProductionOrders',
                    sapTables: 'OWOR'
                }
            },
            payloads,
            staged
        });
    } catch (error) {
        res.status(500).json({ error: error.message || 'No fue posible preparar la salida SAP.' });
    }
});

