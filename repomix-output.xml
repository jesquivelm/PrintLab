:root {
    --mobile-bg: #eef7f8;
    --mobile-bg-glow: #e7deff;
    --mobile-surface: rgba(255, 255, 255, 0.84);
    --mobile-surface-strong: #ffffff;
    --mobile-surface-tint: #f5f8fd;
    --mobile-border: rgba(63, 92, 130, 0.12);
    --mobile-text: #1e2331;
    --mobile-text-soft: #6f7791;
    --mobile-accent: #17b8c6;
    --mobile-accent-strong: #0c8f9c;
    --mobile-accent-soft: rgba(23, 184, 198, 0.12);
    --mobile-purple: #8b6df2;
    --mobile-purple-soft: rgba(139, 109, 242, 0.14);
    --mobile-success: #1f7a55;
    --mobile-warning: #b56a16;
    --mobile-danger: #b9352c;
    --mobile-shadow: 0 22px 48px rgba(60, 75, 110, 0.1);
    --mobile-radius: 28px;
}

body[data-theme="dark"] {
    --mobile-bg: #16171d;
    --mobile-bg-glow: #2d2148;
    --mobile-surface: rgba(24, 26, 34, 0.88);
    --mobile-surface-strong: #1c1f28;
    --mobile-surface-tint: #232733;
    --mobile-border: rgba(255, 255, 255, 0.08);
    --mobile-text: #f5ede8;
    --mobile-text-soft: #b7ada7;
    --mobile-accent: #3ed6df;
    --mobile-accent-strong: #89eef4;
    --mobile-accent-soft: rgba(62, 214, 223, 0.16);
    --mobile-purple: #a78bfa;
    --mobile-purple-soft: rgba(167, 139, 250, 0.16);
    --mobile-success: #52b788;
    --mobile-warning: #f0a542;
    --mobile-danger: #ff6b6b;
    --mobile-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
}

* { box-sizing: border-box; }

body {
    margin: 0;
    min-height: 100vh;
    font-family: "Trebuchet MS", "Segoe UI", sans-serif;
    color: var(--mobile-text);
    background:
        radial-gradient(circle at top left, var(--mobile-bg-glow) 0%, transparent 34%),
        linear-gradient(180deg, var(--mobile-bg) 0%, color-mix(in srgb, var(--mobile-bg) 78%, #ffffff) 100%);
}

button,
input {
    font: inherit;
}

input,
button {
    -webkit-appearance: none;
    appearance: none;
}

.seller-mobile-app {
    min-height: 100vh;
    padding: 18px 14px 28px;
}

.mobile-shell {
    width: min(100%, 460px);
    margin: 0 auto;
    display: grid;
    gap: 16px;
}

.hero-card,
.list-panel,
.detail-card {
    background: var(--mobile-surface);
    backdrop-filter: blur(18px);
    border: 1px solid var(--mobile-border);
    border-radius: var(--mobile-radius);
    box-shadow: var(--mobile-shadow);
}

.hero-card {
