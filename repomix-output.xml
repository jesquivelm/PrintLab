        function buildSapServiceLayerAbsoluteUrl() {
            const protocol = sapProtocolSelect?.value || 'https';
            const host = (sapHostInput?.value || '').trim();
            const port = (sapPortInput?.value || '').trim();
            const path = buildSapServiceLayerQueryPath();
            if (!host) return `(pendiente de configurar host SAP)${path}`;
            return `${protocol}://${host}${port ? `:${port}` : ''}${path}`;
        }

