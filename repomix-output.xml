            return getSapProvider() === 'di-api' ? 'DI API' : 'Service Layer';
        }

        function buildSapProviderAbsoluteUrl() {
            if (getSapProvider() === 'di-api') {
                const baseUrl = (sapDiApiBaseUrlInput?.value || '').trim().replace(/\/+$/, '');
                const path = `/${(sapQueryEntity?.value || 'business-partners').trim()}`;
                return baseUrl ? `${baseUrl}${path}` : `(pendiente de configurar URL DI API)${path}`;
            }
            return buildSapServiceLayerAbsoluteUrl();
        }

