        if (row.is_active === false) {
            return res.status(403).json({ error: 'Este usuario se encuentra inactivo.' });
        }
        res.json({
            ok: true,
            user: {
                id: Number(row.id || 0),
                name: sanitizeAdminUserText(row.full_name),
                username: sanitizeAdminUserText(row.username),
