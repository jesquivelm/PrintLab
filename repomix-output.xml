        function buildSapQueryUrl() {
            const entity = sapQueryEntity?.value || 'business-partners';
            const params = new URLSearchParams();
            const source = (sapQuerySource?.value || '').trim();
            const filter = (sapQueryFilterInput?.value || '').trim();
            const search = (sapQuerySearchInput?.value || '').trim();
            const top = (sapQueryTopInput?.value || '').trim();
            if (source) params.set('source', source);
            if (search) params.set('search', search);
            if (top) params.set('top', top);
            if (filter) {
                if (entity === 'business-partners') params.set('type', filter);
                if (entity === 'items') params.set('group', filter);
                if (entity === 'orders') params.set('status', filter);
            }
            return `/api/sap/${entity}${params.toString() ? `?${params.toString()}` : ''}`;
        }

        async function runSapConnectorQuery() {
            await saveSapConnectorConfig();
            setSapConfigStatus('Consultando...', false);
            const queryUrl = buildSapQueryUrl();
            const serviceUrl = buildSapProviderAbsoluteUrl();
            const providerLabel = getSapProviderLabel();
            renderSapQueryRequestPreview();
            setSapResult(sapQueryResult, 'Consultando SAP...');
            setSapQueryTrace([
                formatSapTraceEntry('Preparando consulta en el navegador.'),
                formatSapTraceEntry('Solicitud interna lista para el ERP.', `GET ${queryUrl}`),
                formatSapTraceEntry(`Destino final calculado para ${providerLabel}.`, `GET ${serviceUrl}`),
                formatSapTraceEntry('Esperando respuesta del ERP y del servidor SAP...')
            ]);
            const startedAt = Date.now();
            try {
                const response = await fetch(queryUrl);
                const payload = await response.json().catch(() => ({}));
                const elapsed = Date.now() - startedAt;
                if (!response.ok) throw new Error(payload.error || 'No fue posible consultar SAP.');
                setSapQueryTrace([
                    formatSapTraceEntry('Preparando consulta en el navegador.'),
                    formatSapTraceEntry('Solicitud interna enviada al ERP.', `GET ${queryUrl}`),
                    formatSapTraceEntry(`ERP reenvía la consulta a ${providerLabel}.`, `GET ${serviceUrl}`),
                    formatSapTraceEntry('Respuesta recibida.', `HTTP ${response.status}${response.statusText ? ` ${response.statusText}` : ''}\nTiempo aproximado: ${elapsed} ms`),
                    formatSapTraceEntry('Resultado entregado al panel inferior.')
                ]);
                setSapResult(sapQueryResult, payload);
                setSapConfigStatus('Consulta completada.', false);
            } catch (error) {
                const elapsed = Date.now() - startedAt;
                setSapResult(sapQueryResult, 'La consulta falló. No hay resultados para mostrar.');
                setSapQueryTrace([
                    formatSapTraceEntry('Preparando consulta en el navegador.'),
                    formatSapTraceEntry('Solicitud interna enviada al ERP.', `GET ${queryUrl}`),
                    formatSapTraceEntry(`ERP intentó reenviar la consulta a ${providerLabel}.`, `GET ${serviceUrl}`),
                    formatSapTraceEntry('La consulta falló.', `${error.message || 'Error no controlado.'}\nTiempo aproximado: ${elapsed} ms`)
                ]);
                throw error;
            }
        }

