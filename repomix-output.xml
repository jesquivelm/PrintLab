        function buildSingleIconGeneralPayload(iconKey, item) {
            const suffix = toIconSuffix(iconKey);
            const general = {};
            ['iconColor', 'iconColor2', 'iconColorHover', 'iconSize'].forEach(prefix => {
                const input = item?.querySelector(`input[name="general.${prefix}${suffix}"]`) || document.querySelector(`input[name="general.${prefix}${suffix}"]`);
