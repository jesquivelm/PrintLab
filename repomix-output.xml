    width: var(--mobile-header-icon-size, 18px);
    min-width: var(--mobile-header-icon-size, 18px);
    height: var(--mobile-header-icon-size, 18px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
