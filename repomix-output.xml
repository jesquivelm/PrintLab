function formatTimelineStamp(value) {
  if (!value) return "Pendiente";
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return String(value);
  return new Intl.DateTimeFormat("es-CR", {
    dateStyle: "short",
    timeStyle: "medium"
  }).format(parsed);
}

