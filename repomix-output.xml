        async function saveSingleIconConfig(iconKey, iconValue, item) {
            const saveStatus = document.getElementById('saveStatus');
            const floatingStatus = document.getElementById('saveStatusFloating');
            if (saveStatus) saveStatus.textContent = 'Guardando icono...';
            if (floatingStatus) floatingStatus.textContent = 'Guardando icono...';

            const response = await fetch('/api/config/general/icon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    key: iconKey,
                    value: iconValue,
                    general: buildSingleIconGeneralPayload(iconKey, item)
                })
            });

            if (!response.ok) {
                let errorMessage = 'Error al guardar';
                try {
                    const errorPayload = await response.json();
                    errorMessage = errorPayload?.error || errorMessage;
                } catch (_) {}
                throw new Error(errorMessage);
            }

            const savedPatch = await response.json();
            loadedConfig.icons = { ...(loadedConfig.icons || {}), ...(savedPatch.icons || {}) };
            loadedConfig.general = { ...(loadedConfig.general || {}), ...(savedPatch.general || {}) };
            window.dispatchEvent(new CustomEvent('erp-general-config-updated', { detail: loadedConfig }));
            try {
                localStorage.setItem('erp-general-config-updated', JSON.stringify({ at: Date.now() }));
            } catch (_) {}
            if (saveStatus) saveStatus.textContent = 'Configuración guardada.';
            if (floatingStatus) floatingStatus.textContent = 'Configuración guardada.';
            return loadedConfig;
        }

        function bindIconUploadHandlers() {
            document.querySelectorAll('[data-icon-upload]').forEach(uploadInput => {
                if (uploadInput.dataset.iconUploadBound === 'true') return;

                const iconInputName = uploadInput.dataset.iconUpload || '';
                const iconKey = iconInputName.replace(/^icons\./, '');
                const isOrderIconUpload = ORDER_ICON_UPLOAD_KEYS.has(iconKey);
                const item = uploadInput.closest('.icon-item');
                const textInput = item?.querySelector(`[name="${iconInputName}"]`) || document.querySelector(`[name="${iconInputName}"]`);
                const previewEl = item?.querySelector('.icon-preview') || document.getElementById(`preview-icons.${iconKey}`);

                uploadInput.addEventListener('change', async (e) => {
                    const file = e.target.files[0];
                    if (file) {
                        try {
                            const dataUrl = await new Promise((resolve, reject) => {
                                const reader = new FileReader();
                                reader.onload = (ev) => resolve(String(ev.target?.result || ''));
                                reader.onerror = reject;
                                reader.readAsDataURL(file);
                            });

                            const resizedDataUrl = await new Promise((resolve, reject) => {
                                if (/^data:image\/svg\+xml/i.test(dataUrl)) {
                                    resolve(dataUrl);
                                    return;
                                }
                                const img = new Image();
                                img.onload = () => {
                                    const maxDim = isOrderIconUpload ? 256 : 512;
                                    let width = img.width;
                                    let height = img.height;
                                    if (width > maxDim || height > maxDim) {
                                        if (width > height) {
                                            height *= maxDim / width;
                                            width = maxDim;
                                        } else {
                                            width *= maxDim / height;
                                            height = maxDim;
                                        }
                                    }
                                    const canvas = document.createElement('canvas');
                                    canvas.width = Math.max(1, Math.round(width));
                                    canvas.height = Math.max(1, Math.round(height));
                                    const ctx = canvas.getContext('2d');
                                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                                    if (!isOrderIconUpload) {
                                        resolve(canvas.toDataURL('image/png'));
                                        return;
                                    }
                                    const webpDataUrl = canvas.toDataURL('image/webp', 0.82);
                                    resolve(webpDataUrl.startsWith('data:image/webp') ? webpDataUrl : canvas.toDataURL('image/png'));
                                };
                                img.onerror = () => reject(new Error('No fue posible leer el icono.'));
                                img.src = dataUrl;
                            });

                            if (textInput) textInput.value = resizedDataUrl;
                            loadedConfig.icons = loadedConfig.icons || {};
                            loadedConfig.icons[iconKey] = resizedDataUrl;

                            const suffix = toIconSuffix(iconKey);
                            const colorInput = item?.querySelector(`input[name="general.iconColor${suffix}"]`) || document.querySelector(`input[name="general.iconColor${suffix}"]`);
                            const sizeInput = item?.querySelector(`input[name="general.iconSize${suffix}"]`) || document.querySelector(`input[name="general.iconSize${suffix}"]`);
                            renderIconPreview(previewEl, resizedDataUrl, colorInput?.value || '#9ba2ab', Number(sizeInput?.value) || 20);

                            renderAdminUserCreateButton();
                            renderAdminUserList();
                            renderPermissionAdminCreateButton();
                            renderPermissionAdminDeleteButton();

                            updatePreviews();
                            if (isOrderIconUpload) {
                                await saveSingleIconConfig(iconKey, resizedDataUrl, item);
                            } else {
                                await saveConfig({ throwOnError: true });
                            }
                            uploadInput.value = '';
                        } catch (err) {
                            console.error('Error al procesar el icono:', err);
                            const message = err?.message || 'No fue posible procesar o guardar el icono.';
                            document.getElementById('saveStatus').textContent = 'Error al guardar: ' + message;
                            const floatingStatus = document.getElementById('saveStatusFloating');
                            if (floatingStatus) floatingStatus.textContent = 'Error al guardar: ' + message;
                        }
                    }
                });

                if (previewEl) {
                    previewEl.style.cursor = 'pointer';
                    previewEl.addEventListener('click', () => uploadInput.click());
                }

                uploadInput.dataset.iconUploadBound = 'true';
            });
        }

