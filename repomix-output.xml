                    <td>
                        <div class="sap-accounting-table-actions">
                            <button type="button" class="action-btn" data-sap-salesperson-save="${escapeHtml(item.id)}">Guardar</button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        async function loadSapAccountingState() {
            const [salespersonResponse, productionResponse] = await Promise.all([
                fetch('/api/sap/salesperson-profit-centers'),
                fetch('/api/sap/production-cost-center')
            ]);
            const salespersonPayload = await salespersonResponse.json().catch(() => ({}));
            const productionPayload = await productionResponse.json().catch(() => ({}));
            if (!salespersonResponse.ok) throw new Error(salespersonPayload.error || 'No fue posible cargar los ejecutivos SAP.');
            if (!productionResponse.ok) throw new Error(productionPayload.error || 'No fue posible cargar el centro de costo de producción.');
            sapSalespersonProfitCenters = Array.isArray(salespersonPayload.items)
                ? salespersonPayload.items.map(normalizeSapSalespersonProfitCenter)
                : [];
            sapSalespersonOptionsLoadedOnce = true;
            sapProductionCostCenterConfig = productionPayload || {};
            if (sapProductionCostCenterInput) {
                sapProductionCostCenterInput.value = String(productionPayload.defaultCostCenterCode || '').trim();
            }
            renderSapSalespersonProfitCenters();
            setSapAccountingStatus(`Configuración cargada. Ejecutivos SAP: ${sapSalespersonProfitCenters.length}.`, false);
        }

        function renderSapStatus(payload = {}) {
            const config = payload.config || {};
            const providerLabel = (config.provider || getSapProvider()) === 'di-api' ? 'DI API' : 'Service Layer';
            if (sapStatusRow) {
                sapStatusRow.innerHTML = `<span class="sap-security-pill">${escapeHtml(providerLabel)}</span>`;
            }
            applySapConfigToForm(config);
        }

        function populateSapActivityFilterOptions(select, values = [], fallbackLabel = 'Todos') {
            if (!select) return;
            const current = select.value;
            const options = [`<option value="">${fallbackLabel}</option>`]
                .concat((Array.isArray(values) ? values : []).filter(Boolean).map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`));
            select.innerHTML = options.join('');
            if ([...select.options].some((option) => option.value === current)) {
                select.value = current;
            }
        }

        function collectSapActivityFilters() {
            return {
                type: sapActivityTypeFilter?.value || '',
                status: sapActivityStatusFilter?.value || '',
                entity: sapActivityEntityFilter?.value || '',
                actor: sapActivityActorFilter?.value?.trim() || '',
                from: sapActivityDateFromFilter?.value || '',
                to: sapActivityDateToFilter?.value || '',
                search: sapActivitySearchFilter?.value?.trim() || '',
                limit: 100
            };
        }

        function buildSapActivityUrl() {
            const params = new URLSearchParams();
            const filters = collectSapActivityFilters();
            Object.entries(filters).forEach(([key, value]) => {
                if (value !== '' && value != null) params.set(key, value);
            });
            return `/api/sap/activity${params.toString() ? `?${params.toString()}` : ''}`;
        }

        function describeSapActivityResult(entry = {}) {
            const summary = entry.response_summary || {};
            if (summary.records != null) return `${summary.records} registros recibidos`;
            if (summary.count != null) return `${summary.count} elementos`;
            if (summary.DocNum != null) return `Documento ${summary.DocNum}`;
            if (summary.DocEntry != null) return `DocEntry ${summary.DocEntry}`;
            if (summary.message) return String(summary.message);
            if (summary.entities && typeof summary.entities === 'object') {
                return Object.entries(summary.entities).map(([key, value]) => `${key}: ${value}`).join(' | ');
            }
            if (entry.error_message) return entry.error_message;
            return 'Sin detalle adicional';
        }

        function describeSapActivityType(actionType = '') {
            const normalized = String(actionType || '').toLowerCase();
            if (normalized === 'import') return 'Carga';
            if (normalized === 'query') return 'Consulta';
            if (normalized === 'sync') return 'Sincronización';
            if (normalized === 'write') return 'Envío';
            if (normalized === 'export') return 'Envío';
            return actionType || 'Registro';
        }

        function describeSapBusinessObject(entry = {}) {
            const entity = String(entry.entity_name || '').toLowerCase();
            if (entity.includes('ocrd') || entity.includes('crd1') || entity.includes('ocpr') || entity.includes('businesspartners')) {
                return 'Socios de negocio, contactos y direcciones';
            }
            if (entity.includes('oitm') || entity.includes('oitw') || entity.includes('itm1') || entity.includes('owhs') || entity.includes('items')) {
                return 'Materias primas, inventario, precios y bodegas';
            }
            if (entity.includes('ordr') || entity.includes('rdr1') || entity.includes('orders')) {
                return 'Orden de venta';
            }
            if (entity.includes('owor') || entity.includes('wor1') || entity.includes('productionorders')) {
                return 'Orden de producción';
            }
            if (entity.includes('oitt') || entity.includes('itt1') || entity.includes('producttrees')) {
                return 'BOM o receta estándar';
            }
            if (entity.includes('inventorygenexit') || entity.includes('ige1')) {
                return 'Entrega de componentes o consumo real';
            }
            if (entity.includes('inventorygenentry') || entity.includes('ign1')) {
                return 'Terminación o recibo de producción';
            }
            if (entity.includes('obtn') || entity.includes('obtq')) {
                return 'Lotes y cantidades por bodega';
            }
            return entry.entity_name || 'Operación SAP';
        }

        function describeSapActivityOperation(entry = {}) {
            const type = String(entry.action_type || '').toLowerCase();
            if (type === 'import') return 'Carga hacia tablas espejo locales';
            if (type === 'query') return 'Consulta puntual al origen configurado';
            if (type === 'sync') return 'Sincronización controlada';
            if (type === 'write') return 'Envío del ERP hacia SAP';
            if (type === 'export') return 'Envío del ERP hacia SAP';
            return 'Movimiento técnico';
        }

        function describeSapReference(entry = {}) {
            const vars = entry.request_vars || {};
            const summary = entry.response_summary || {};
            const preview = Array.isArray(summary.preview) ? summary.preview[0] || {} : {};
            const firstReference = [
                vars.CardCode,
                vars.ItemCode,
                vars.BaseEntry,
                vars.DocEntry,
                vars.DocNum,
                vars.orderCode,
                vars.referenceCode,
                preview.CardCode,
                preview.CardName,
                preview.ItemCode,
                preview.ItemName,
                summary.DocNum != null ? `DocNum ${summary.DocNum}` : '',
                summary.DocEntry != null ? `DocEntry ${summary.DocEntry}` : ''
            ].find((value) => value !== '' && value != null);
            if (firstReference) return String(firstReference);
            if (vars.search) return `Búsqueda: ${vars.search}`;
            if (entry.internal_url) return entry.internal_url;
            return 'Sin referencia visible';
        }

        function buildSapActivityDataLines(entry = {}) {
            const vars = entry.request_vars || {};
            const summary = entry.response_summary || {};
            const preview = Array.isArray(summary.preview) ? summary.preview : [];
            const lines = [];
            const type = String(entry.action_type || '').toLowerCase();

            if (type === 'import' || type === 'query' || type === 'sync') {
                if (preview.length) {
                    preview.forEach((item) => {
                        const label = [
                            item.CardCode && item.CardName ? `${item.CardCode} · ${item.CardName}` : '',
                            item.ItemCode && item.ItemName ? `${item.ItemCode} · ${item.ItemName}` : '',
                            item.DocNum != null ? `DocNum ${item.DocNum}` : '',
                            item.DocEntry != null ? `DocEntry ${item.DocEntry}` : ''
                        ].find(Boolean);
                        if (label) lines.push(label);
                    });
                }
                if (!lines.length && summary.records != null) {
                    lines.push(`Registros obtenidos: ${summary.records}`);
                }
                if (vars.limit) lines.push(`Límite: ${vars.limit}`);
                if (vars.search) lines.push(`Búsqueda: ${vars.search}`);
                if (vars.type) lines.push(`Tipo: ${vars.type}`);
                if (vars.group) lines.push(`Grupo: ${vars.group}`);
            }

            if (type === 'write' || type === 'export') {
                if (vars.CardCode) lines.push(`Cliente: ${vars.CardCode}${vars.CardName ? ` · ${vars.CardName}` : ''}`);
                if (vars.ItemCode) lines.push(`Artículo: ${vars.ItemCode}${vars.ItemName ? ` · ${vars.ItemName}` : ''}`);
                if (vars.BaseEntry != null) lines.push(`BaseEntry: ${vars.BaseEntry}`);
                if (vars.DocDate) lines.push(`Fecha doc: ${vars.DocDate}`);
                if (vars.DocDueDate) lines.push(`Fecha venc: ${vars.DocDueDate}`);
                if (vars.Quantity != null) lines.push(`Cantidad: ${vars.Quantity}`);
                if (Array.isArray(vars.DocumentLines)) {
                    vars.DocumentLines.slice(0, 3).forEach((line) => {
                        lines.push(`Línea: ${line.ItemCode || 'sin código'} x ${line.Quantity != null ? line.Quantity : ''}`);
                    });
                }
                if (Array.isArray(vars.lines)) {
                    vars.lines.slice(0, 3).forEach((line) => {
                        lines.push(`Línea: ${line.ItemCode || line.local_code || 'sin código'} x ${line.Quantity != null ? line.Quantity : ''}`);
                    });
                }
                if (!lines.length && Array.isArray(summary.keys)) {
                    lines.push(`Campos enviados: ${summary.keys.join(', ')}`);
                }
            }

            if (entry.error_message) lines.push(`Error: ${entry.error_message}`);
            return lines.filter(Boolean).slice(0, 6);
        }

        function isLegacySapConnectionError(entry = {}) {
            const type = String(entry.action_type || '').toLowerCase();
            const entity = String(entry.entity_name || '').toLowerCase();
            const message = String(entry.error_message || '').toLowerCase();
            const serviceUrl = String(entry.service_url || '').toLowerCase();
            const isLegacyTestConnection =
                type === 'test' &&
                entity === 'connection' &&
                (
                    message.includes('di api no responde') ||
                    serviceUrl.includes('localhost:4100')
                );
            const isLegacyMockImport =
                message.includes('db.json') ||
                message.includes('modo prueba') ||
                message.includes('no está consultando sap real') ||
                message.includes('no esta consultando sap real') ||
                message.includes('fuente actual:');
            return (
                isLegacyTestConnection ||
                isLegacyMockImport
            );
        }

        function renderSapActivitySummary(rows = []) {
            if (sapActivitySummary) {
                sapActivitySummary.hidden = true;
                sapActivitySummary.innerHTML = '';
            }
        }

        function renderSapActivityTable(payload = {}) {
            const rows = (Array.isArray(payload.rows) ? payload.rows : []).filter((entry) => !isLegacySapConnectionError(entry) && String(entry.action_type || '').toLowerCase() !== 'test');
            populateSapActivityFilterOptions(sapActivityTypeFilter, (payload.catalog?.types || []).filter((value) => String(value || '').toLowerCase() !== 'test'));
            populateSapActivityFilterOptions(sapActivityStatusFilter, payload.catalog?.statuses || []);
            populateSapActivityFilterOptions(sapActivityEntityFilter, payload.catalog?.entities || []);
            renderSapActivitySummary(rows);
            if (!sapActivityTableBody) return;
            if (!rows.length) {
                sapActivityTableBody.innerHTML = '<tr><td colspan="7" class="audit-empty">No hay registros SAP para mostrar.</td></tr>';
                return;
            }
            sapActivityTableBody.innerHTML = rows.map((entry) => {
                const whenLabel = entry.started_at ? new Date(entry.started_at).toLocaleString('es-CR') : 'Sin fecha';
                const timingLabel = entry.finished_at && entry.started_at
                    ? `${Math.max(0, new Date(entry.finished_at) - new Date(entry.started_at))} ms`
                    : '';
                const resultLabel = describeSapActivityResult(entry);
                const statusTone = String(entry.status || '').toLowerCase() === 'error' ? 'error' : 'ok';
                const operationLabel = describeSapActivityOperation(entry);
                const objectLabel = describeSapBusinessObject(entry);
                const referenceLabel = describeSapReference(entry);
                const dataLines = buildSapActivityDataLines(entry);
                return `
                    <tr>
                        <td>
                            <div class="audit-meta">
                                <strong>${escapeHtml(whenLabel)}</strong>
                                <span>${escapeHtml(timingLabel)}</span>
                            </div>
                        </td>
                        <td><span class="audit-chip">${escapeHtml(describeSapActivityType(entry.action_type || ''))}</span></td>
                        <td>${escapeHtml(entry.actor || 'admin')}</td>
                        <td>
                            <div class="audit-meta">
                                <strong>${escapeHtml(objectLabel)}</strong>
                                <span>${escapeHtml(operationLabel)}</span>
                            </div>
                        </td>
                        <td>
                            <div class="audit-meta">
                                <strong>${escapeHtml(referenceLabel)}</strong>
                                <span>${escapeHtml(entry.entity_name || '')}</span>
                            </div>
                        </td>
                        <td>
                            <div class="sap-records-result">
                                <strong><span class="sap-security-pill" data-tone="${escapeHtml(statusTone)}">${escapeHtml(entry.status || '')}</span></strong>
                                <span>${escapeHtml(resultLabel)}</span>
                            </div>
                        </td>
                        <td>
                            <div class="sap-records-process">
                                ${dataLines.length
                                    ? dataLines.map((line) => `<code>${escapeHtml(line)}</code>`).join('')
                                    : '<span class="section-caption">Sin detalle visible.</span>'}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderSapShipmentsTable(payload = {}) {
            const rows = (Array.isArray(payload.rows) ? payload.rows : [])
                .filter((entry) => {
                    const type = String(entry.action_type || '').toLowerCase();
                    return (type === 'write' || type === 'export') && !isLegacySapConnectionError(entry);
                })
                .sort((left, right) => new Date(right.started_at || right.created_at || 0) - new Date(left.started_at || left.created_at || 0));
            if (sapShipmentsStatus) {
                sapShipmentsStatus.className = 'sap-security-empty';
                sapShipmentsStatus.textContent = rows.length ? `${rows.length} envío(s) cargados.` : 'No hay envíos SAP para mostrar.';
            }
            if (!sapShipmentsTableBody) return;
            if (!rows.length) {
                sapShipmentsTableBody.innerHTML = '<tr><td colspan="6" class="audit-empty">No hay envíos SAP para mostrar.</td></tr>';
                return;
            }
            sapShipmentsTableBody.innerHTML = rows.map((entry) => {
                const whenLabel = entry.started_at ? new Date(entry.started_at).toLocaleString('es-CR') : 'Sin fecha';
                const statusTone = String(entry.status || '').toLowerCase() === 'error' ? 'error' : 'ok';
                return `
                    <tr>
                        <td>${escapeHtml(whenLabel)}</td>
                        <td>${escapeHtml(describeSapBusinessObject(entry))}</td>
                        <td>${escapeHtml(describeSapReference(entry))}</td>
                        <td>${escapeHtml(entry.service_url || entry.internal_url || '')}</td>
                        <td><span class="sap-security-pill" data-tone="${escapeHtml(statusTone)}">${escapeHtml(entry.status || '')}</span></td>
                        <td>${escapeHtml(describeSapActivityResult(entry))}</td>
                    </tr>
                `;
            }).join('');
        }

        async function loadSapShipments(force = false) {
            if (!force && sapShipmentsLoadedOnce) return;
            if (sapShipmentsStatus) {
                sapShipmentsStatus.className = 'sap-security-empty';
                sapShipmentsStatus.textContent = 'Cargando envíos SAP...';
            }
            const response = await fetch('/api/sap/activity?limit=300');
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible cargar los envíos SAP.');
            renderSapShipmentsTable(payload);
            sapShipmentsLoadedOnce = true;
        }

        async function loadSapActivityRecords(force = false) {
            if (!force && sapActivityLoadedOnce) return;
            const response = await fetch(buildSapActivityUrl());
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible cargar los registros SAP.');
            renderSapActivityTable(payload);
            sapActivityLoadedOnce = true;
        }

        function formatSapOpsDate(value) {
            if (!value) return 'Sin fecha';
            const parsed = new Date(value);
            if (Number.isNaN(parsed.getTime())) return 'Sin fecha';
            return parsed.toLocaleString('es-CR');
        }

        function describeSapImportJobStatus(status = '') {
            const normalized = String(status || '').toLowerCase();
            if (normalized === 'success') return 'Correcto';
            if (normalized === 'error') return 'Error';
            if (normalized === 'running') return 'Ejecutando';
            if (normalized === 'paused') return 'Pausado';
            return 'Pendiente';
        }

        function renderSapImportJobs(rows = []) {
            sapImportJobs = Array.isArray(rows) ? rows : [];
            if (sapImportJobsStatus) {
                sapImportJobsStatus.className = 'sap-security-empty';
                sapImportJobsStatus.textContent = sapImportJobs.length
                    ? 'Configura cada carga. Si SAP no responde, el trabajo queda activo y reintenta en el siguiente intervalo.'
                    : 'No hay trabajos de importación configurados.';
            }
            if (!sapImportJobsBody) return;
            if (!sapImportJobs.length) {
                sapImportJobsBody.innerHTML = '<tr><td colspan="9" class="audit-empty">No hay trabajos SAP disponibles.</td></tr>';
                return;
            }
            sapImportJobsBody.innerHTML = sapImportJobs.map((job) => {
                const filterValue = Object.prototype.hasOwnProperty.call(job.filters || {}, 'type')
                    ? (job.filters.type || '')
                    : (job.filters.group || '');
                const filterPlaceholder = Object.prototype.hasOwnProperty.call(job.filters || {}, 'type')
                    ? 'Tipo de socio'
                    : 'Grupo de artículo';
                const statusTone = String(job.status || '').toLowerCase() === 'error'
                    ? 'error'
                    : (String(job.status || '').toLowerCase() === 'success' ? 'ok' : '');
                return `
                    <tr data-job-code="${escapeHtml(job.jobCode)}">
                        <td>
                            <div class="audit-meta">
                                <strong>${escapeHtml(job.label || '')}</strong>
                                <span>${escapeHtml(job.entityLabel || '')}</span>
                            </div>
                        </td>
                        <td><input type="checkbox" data-job-field="enabled" ${job.filters?.enabled ? 'checked' : ''}></td>
                        <td><input class="sap-import-job-input" type="number" min="5" max="1440" value="${escapeHtml(String(job.filters?.intervalMinutes || 30))}" data-job-field="intervalMinutes"></td>
                        <td><input class="sap-import-job-input" type="number" min="1" max="1000" value="${escapeHtml(String(job.filters?.limit || 100))}" data-job-field="limit"></td>
                        <td><input class="sap-import-job-input" type="text" value="${escapeHtml(String(filterValue || ''))}" placeholder="${escapeHtml(filterPlaceholder)}" data-job-field="filterValue"></td>
                        <td>${escapeHtml(formatSapOpsDate(job.finishedAt || job.startedAt))}</td>
                        <td>${escapeHtml(formatSapOpsDate(job.nextRunAt))}</td>
                        <td>
                            <div class="audit-meta">
                                <strong>${statusTone ? `<span class="sap-security-pill" data-tone="${escapeHtml(statusTone)}">${escapeHtml(describeSapImportJobStatus(job.status))}</span>` : escapeHtml(describeSapImportJobStatus(job.status))}</strong>
                                <span>${escapeHtml(job.message || 'Sin mensaje')}</span>
                            </div>
                        </td>
                        <td>
                            <div class="sap-security-actions">
                                <button type="button" class="action-btn" data-job-action="save">Guardar</button>
                                <button type="button" class="action-btn action-btn-primary" data-job-action="run">Ejecutar ahora</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function collectSapImportJobPayload(row) {
            const jobCode = row?.dataset.jobCode || '';
            const base = {
                enabled: row?.querySelector('[data-job-field="enabled"]')?.checked === true,
                intervalMinutes: Number(row?.querySelector('[data-job-field="intervalMinutes"]')?.value || 30),
                limit: Number(row?.querySelector('[data-job-field="limit"]')?.value || 100)
            };
            const filterValue = row?.querySelector('[data-job-field="filterValue"]')?.value?.trim() || '';
            if (jobCode === 'sap-import-business-partners') base.type = filterValue;
            if (jobCode === 'sap-import-items') base.group = filterValue;
            return base;
        }

        async function loadSapImportJobs(force = false) {
            if (!force && sapImportJobsLoadedOnce) return;
            const response = await fetch('/api/sap/import-jobs');
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible cargar la automatización SAP.');
            renderSapImportJobs(payload.rows || []);
            sapImportJobsLoadedOnce = true;
        }

        async function saveSapImportJobRow(row) {
            const jobCode = row?.dataset.jobCode || '';
            const response = await fetch(`/api/sap/import-jobs/${encodeURIComponent(jobCode)}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(collectSapImportJobPayload(row))
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible guardar la automatización SAP.');
            sapImportJobsLoadedOnce = false;
            await loadSapImportJobs(true);
            return payload.row || null;
        }

        async function runSapImportJobRow(row) {
            const jobCode = row?.dataset.jobCode || '';
            await saveSapImportJobRow(row);
            const response = await fetch(`/api/sap/import-jobs/${encodeURIComponent(jobCode)}/run`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ automated: true })
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible ejecutar la carga SAP.');
            sapImportJobsLoadedOnce = false;
            sapActivityLoadedOnce = false;
            await Promise.all([loadSapImportJobs(true), loadSapActivityRecords(true)]);
        }

        function renderSapMirrorSummary(payload = {}) {
            sapMirrorTables = Array.isArray(payload.tables) ? payload.tables : [];
            if (sapMirrorTableSelect) {
                const current = sapMirrorTableSelect.value;
                sapMirrorTableSelect.innerHTML = sapMirrorTables.map((table) => (
                    `<option value="${escapeHtml(table.tableName)}">${escapeHtml(table.tableName)} · ${escapeHtml(table.label)}</option>`
                )).join('');
                if (current && sapMirrorTables.some((table) => table.tableName === current)) {
                    sapMirrorTableSelect.value = current;
                }
            }
        }

        async function loadSapMirrorSummary(force = false) {
            if (!force && sapMirrorLoadedOnce) return;
            const response = await fetch('/api/sap/mirror/summary');
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible cargar las tablas SAP.');
            renderSapMirrorSummary(payload);
            sapMirrorLoadedOnce = true;
        }

        function renderSapMirrorTable(payload = {}) {
            const table = payload.table || {};
            const columns = Array.isArray(table.columns) ? table.columns : [];
            const rows = Array.isArray(payload.rows) ? payload.rows : [];
            if (sapMirrorTableHead) {
                sapMirrorTableHead.innerHTML = columns.length
                    ? `<tr>${columns.map((column) => `<th>${escapeHtml(column)}</th>`).join('')}</tr>`
                    : '';
            }
            if (!sapMirrorTableBody) return;
            if (!rows.length) {
                sapMirrorTableBody.innerHTML = `<tr><td colspan="${Math.max(columns.length, 1)}" class="audit-empty">No hay registros para mostrar.</td></tr>`;
                return;
            }
            const renderSapMirrorCell = (row, column) => {
                if (table.tableName === 'OITM' && column === 'U_ClasificacionERP') {
                    const itemCode = String(row.ItemCode || '').trim();
                    const currentValue = String(row[column] ?? '').trim();
                    const options = [
                        `<option value="">Sin clasificar</option>`,
                        ...inventoryClassificationMappings.map((item) => {
                            const optionValue = String(item.sourceValue || '').trim();
                            const optionLabel = String(item.displayLabel || item.flexoCategory || optionValue).trim();
                            const metaLabel = String(item.flexoCategory || '').trim();
                            return `<option value="${escapeHtml(optionValue)}" ${optionValue === currentValue ? 'selected' : ''}>${escapeHtml(metaLabel ? `${optionLabel} · ${metaLabel}` : optionLabel)}</option>`;
                        })
                    ].join('');
                    return `
                        <select class="sap-inline-select" data-sap-item-code="${escapeHtml(itemCode)}" data-sap-classification-select="true" data-previous-value="${escapeHtml(currentValue)}">
                            ${options}
                        </select>
                    `;
                }
                return escapeHtml(row[column] ?? '');
            };
            sapMirrorTableBody.innerHTML = rows.map((row) => (
