/* Cotizaciones: catálogo maestro con líneas desplegables. */
.quote-master-tree-table {
    table-layout: fixed;
    width: 100%;
    border-collapse: collapse;
}

/* Toggle col */
.quote-master-tree-table th:nth-child(1),
.quote-master-td-toggle {
    width: 70px;
    text-align: center;
    padding-inline: 8px !important;
}

/* Code col */
.quote-master-tree-table th:nth-child(2),
.quote-master-td-code {
    width: 108px;
    white-space: nowrap;
}

/* Info col — takes remaining space */
.quote-master-tree-table th:nth-child(3),
.quote-master-td-info {
    min-width: 0;
}

/* Total col */
.quote-master-tree-table th:nth-child(4),
.quote-master-td-total {
    width: 110px;
    text-align: right;
    font-weight: 800;
    color: var(--app-primary, #0b81b8);
    white-space: nowrap;
    padding-right: 12px !important;
}

/* Actions col */
.quote-master-tree-table th:nth-child(5),
.quote-master-td-actions {
    width: 76px;
    text-align: right;
}

.quote-master-row td {
    padding-block: 12px !important;
    vertical-align: middle;
}

/* Info block — compact inline */
.quote-master-info-block {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 6px;
    min-width: 0;
}

.quote-master-info-name {
    font-weight: 700;
    color: var(--app-text, #102337);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
}

.quote-master-info-code {
    font-size: 11px;
    color: var(--app-text-muted, #8a96a4);
    font-weight: 600;
    background: var(--app-bg-soft, #f1f5f9);
    border-radius: 4px;
    padding: 1px 5px;
    white-space: nowrap;
}

.quote-master-info-sep {
    color: var(--app-text-muted, #aab4bf);
    font-size: 12px;
    flex-shrink: 0;
}

.quote-master-info-arrow {
    color: var(--app-text-muted, #aab4bf);
    font-size: 11px;
    flex-shrink: 0;
}

.quote-master-info-vendor {
    font-size: 12px;
    color: var(--app-text-soft, #5f7080);
    font-weight: 600;
    white-space: nowrap;
}

.quote-master-info-date {
    font-size: 11px;
    color: var(--app-text-muted, #8a96a4);
    font-weight: 500;
    white-space: nowrap;
}

.quote-master-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 52px;
    height: 32px;
    padding: 0 9px;
    border: 1px solid var(--app-border, #d6e4ed);
    border-radius: 999px;
    background: var(--app-surface, #fff);
    color: var(--app-text-soft, #637487);
    line-height: 1;
    cursor: pointer;
    font-weight: 800;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.quote-master-toggle:hover,
.quote-master-toggle:focus-visible {
    color: var(--app-primary, #0b81b8);
    border-color: var(--app-primary, #0b81b8);
    background: var(--app-primary-soft, rgba(11,129,184,0.08));
    outline: none;
    box-shadow: 0 0 0 3px var(--app-ring, rgba(11,129,184,0.14));
}

.quote-master-toggle[aria-expanded="true"] {
    color: var(--app-primary, #0b81b8);
    border-color: var(--app-primary, #0b81b8);
    background: var(--app-primary-soft, rgba(11,129,184,0.10));
}

.quote-master-code:hover,
.quote-master-code:focus-visible {
    color: var(--app-primary, #0b81b8);
    outline: none;
}

.quote-master-toggle-glyph {
    font-size: 11px;
    line-height: 1;
    transition: transform 0.18s ease;
}

.quote-master-toggle[aria-expanded="true"] .quote-master-toggle-glyph {
    transform: rotate(90deg);
}

.quote-master-toggle-count {
    min-width: 14px;
    font-size: 11px;
    line-height: 1;
    text-align: center;
}

.quote-master-code {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--app-text, #102337);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    transition: color 0.14s ease;
}

.quote-master-customer {
    display: grid;
    gap: 3px;
    min-width: 0;
}

.quote-master-customer strong,
.quote-master-customer span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.quote-master-customer strong {
    color: var(--app-text, #102337);
    font-weight: 700;
}

.quote-master-customer span {
    color: var(--app-text-muted, #7c8b98);
    font-size: 12px;
}

.quote-master-status {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 10px;
    border: 1px solid var(--app-border, #d9e6ef);
    border-radius: 999px;
    background: var(--app-surface-soft, #f8fbfd);
    color: var(--app-text-soft, #566a7c);
    font-size: 12px;
    font-weight: 700;
}

.quote-master-total {
    color: var(--app-primary, #0b81b8);
    font-weight: 800;
    text-align: right;
}

.quote-master-lines-row > td {
    padding: 0 16px 16px 20px !important;
    background: var(--app-bg-soft, #fbfdff) !important;
    border-top: 1px solid var(--app-border, #e4edf4) !important;
}

.quote-master-lines {
    display: grid;
    gap: 8px;
}

.quote-master-line {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 66px;
    padding: 10px 14px;
    border: 1px solid #e0ebf2;
    border-radius: 12px;
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.quote-master-line:hover {
    border-color: #bcd6e8;
    box-shadow: 0 4px 12px rgba(11, 129, 184, 0.06);
}

.quote-master-line-order {
    display: none;
}

/* ── Move buttons column ── */
.quote-master-line-move {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

/* ── Main info column ── */
.quote-master-line-main {
    display: grid;
    grid-template-rows: auto auto;
    gap: 5px;
    min-width: 0;
}

.quote-master-line-info {
    display: grid;
    gap: 2px;
    min-width: 0;
}

.quote-master-line-title {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #102337;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.quote-master-line-meta {
    display: block;
    font-size: 11px;
    color: #7a8fa0;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.quote-master-line-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.quote-master-line-state {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 9px;
    border: 1px solid #dde8f0;
    border-radius: 999px;
    background: #f5f9fc;
    color: #718295;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.quote-master-line-state.is-finalized {
    border-color: #b3dece;
    background: #edfaf4;
    color: #0b7f5a;
}

.quote-master-line-total {
    font-size: 12px;
    color: #0b81b8;
    font-weight: 800;
    white-space: nowrap;
}

/* ── Actions column ── */
.quote-master-line-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

/* ── Shared button base ── */
.quote-line-action-btn,
.quote-line-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 30px;
    height: 30px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--app-text-soft, #627386);
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.14s ease, border-color 0.14s ease, background 0.14s ease;
}

.quote-line-action-btn {
    min-width: 58px;
    padding: 0 12px;
    border-color: var(--app-border, #d8e5ee);
    background: var(--app-surface-soft, #f8fbfd);
    font-size: 12px;
}

.quote-line-icon-btn:hover,
.quote-line-icon-btn:focus-visible,
.quote-line-action-btn:hover,
.quote-line-action-btn:focus-visible {
    color: var(--app-primary, #0b81b8);
    border-color: var(--app-primary, #0b81b8);
    background: var(--app-primary-soft, #eef7fb);
    outline: none;
}

.quote-line-icon-btn.is-danger:hover,
.quote-line-icon-btn.is-danger:focus-visible,
.browser-open-link-danger:hover,
.browser-open-link-danger:focus-visible {
    color: var(--app-danger, #c92f2f) !important;
    border-color: rgba(220, 38, 38, 0.3) !important;
    background: rgba(220, 38, 38, 0.08) !important;
}

.quote-line-icon-btn:disabled {
    opacity: 0.28;
    cursor: default;
    pointer-events: none;
}

/* ── Line submenu ── */
.quote-line-menu-wrap {
    position: relative;
}

.quote-line-menu-trigger {
    font-size: 18px;
    letter-spacing: 0;
    line-height: 1;
}

.quote-line-menu-panel {
    position: fixed;
    top: var(--line-menu-top, 0);
    left: var(--line-menu-left, 0);
    z-index: 10000;
    min-width: 240px;
    max-width: min(340px, calc(100vw - 20px));
    max-height: var(--line-menu-max-height, calc(100vh - 20px));
    overflow-y: auto;
    display: grid;
    gap: 0;
    padding: 4px 20px;
    border: 1px solid #d4e3ed;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 12px 32px rgba(15, 35, 52, 0.14);
    animation: qMenuIn 0.14s cubic-bezier(0.16, 1, 0.3, 1);
}

.quote-line-menu-panel[hidden] {
    display: none;
}

@keyframes qMenuIn {
    from { opacity: 0; transform: translateY(-6px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
}

.quote-line-menu-item {
    display: flex;
    align-items: center;
    gap: 25px;
    width: 100%;
    min-height: 28px;
    padding: 5px 25px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: #253848;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
}

.quote-line-menu-panel .row-action-menu-list {
    gap: 0;
}

.quote-line-menu-panel .row-action-menu-item:nth-of-type(-n+5) {
    margin-bottom: 10px;
}

.quote-line-menu-panel .row-action-menu-section-divider {
    margin: 4px 25px;
}

.quote-line-menu-panel .row-action-menu-icon {
    width: 18px;
    height: 18px;
    flex-basis: 18px;
}

.quote-line-menu-item span:last-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.quote-line-menu-item:hover {
    background: #eef7fb;
    color: #0b81b8;
}

.quote-line-menu-item.is-danger:hover {
    background: #fff3f3;
    color: #c42f2f;
}

.quote-line-menu-separator {
    height: 1px;
    background: #e8eef4;
    margin: 3px 4px;
    border-radius: 1px;
}

/* ── Panel footer (add line + proforma) ── */
.quote-master-lines-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-top: 10px;
    margin-top: 4px;
    border-top: 1px solid #e4edf4;
}

.quote-master-lines-footer .quote-browser-action-btn {
    min-width: 88px;
    height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.quote-line-add-btn {
    color: #1a6e93;
    border-color: #b8d9ec;
    background: linear-gradient(180deg, #f2fafd 0%, #e8f4fa 100%);
}

.quote-line-add-btn:hover,
.quote-line-add-btn:focus-visible {
    color: #0b5e80;
    border-color: #6db8d8;
    background: linear-gradient(180deg, #e0f3fb 0%, #cce9f5 100%);
}

.quote-line-proforma-btn {
    margin-left: auto;
    color: #395f75;
    border-color: #ccd9e4;
    background: #f5f8fb;
}

.quote-line-proforma-btn:hover,
.quote-line-proforma-btn:focus-visible {
    color: #0b5e80;
    border-color: #8ab6cc;
    background: #e8f2f8;
}

/* ── Empty / loading message ── */
.quote-master-line-message {
    padding: 18px;
    border: 1px dashed #d5e2eb;
    border-radius: 12px;
    color: #718295;
    font-weight: 700;
    text-align: center;
}

/* ── Dark mode ── */
html[data-theme="dark"] .quote-master-row td {
    background: var(--app-surface) !important;
}

html[data-theme="dark"] .quote-master-lines-row > td {
    background: var(--app-bg-soft) !important;
    border-top-color: var(--app-border) !important;
}

html[data-theme="dark"] .quote-master-line {
    border-color: var(--app-border);
    background: var(--app-surface-soft);
}

html[data-theme="dark"] .quote-line-action-btn {
    border-color: var(--app-border);
    background: var(--app-surface-soft);
    color: var(--app-text-soft);
}

html[data-theme="dark"] .quote-line-icon-btn {
    color: var(--app-text-muted);
}

html[data-theme="dark"] .quote-line-icon-btn:hover,
html[data-theme="dark"] .quote-line-icon-btn:focus-visible,
html[data-theme="dark"] .quote-line-action-btn:hover,
html[data-theme="dark"] .quote-line-action-btn:focus-visible {
    color: var(--icon-hover-color, var(--app-primary));
    border-color: var(--app-primary);
    background: var(--app-primary-soft);
}

html[data-theme="dark"] .quote-master-line-title {
    color: var(--app-text);
}

html[data-theme="dark"] .quote-master-line-meta {
    color: var(--app-text-muted);
}

html[data-theme="dark"] .quote-master-line-state {
    border-color: var(--app-border);
    background: var(--app-surface);
    color: var(--app-text-muted);
}

html[data-theme="dark"] .quote-master-line-state.is-finalized {
    border-color: #1a4a3a;
    background: #0d2a20;
    color: #4ec99a;
}

html[data-theme="dark"] .quote-master-line-total {
    color: var(--app-primary);
}

html[data-theme="dark"] .quote-master-line-message {
    border-color: var(--app-border);
    color: var(--app-text-muted);
}

html[data-theme="dark"] .quote-line-menu-panel {
    border-color: var(--app-border);
    background: var(--app-surface-raised);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.40);
}

html[data-theme="dark"] .quote-line-menu-item {
    color: var(--app-text-soft);
}

html[data-theme="dark"] .quote-line-menu-item:hover {
    background: var(--app-primary-soft);
    color: var(--app-primary-strong);
}

html[data-theme="dark"] .quote-line-menu-item.is-danger:hover {
    background: rgba(220, 38, 38, 0.12);
    color: #f87171;
}

html[data-theme="dark"] .quote-line-menu-separator {
    background: var(--app-border);
}

html[data-theme="dark"] .quote-master-lines-footer {
    border-top-color: var(--app-border);
}

html[data-theme="dark"] .quote-line-add-btn,
html[data-theme="dark"] .quote-line-proforma-btn {
    border-color: var(--app-border);
    background: var(--app-surface-soft);
    color: var(--app-text-muted);
}

html[data-theme="dark"] .quote-line-add-btn:hover,
html[data-theme="dark"] .quote-line-add-btn:focus-visible,
html[data-theme="dark"] .quote-line-proforma-btn:hover,
html[data-theme="dark"] .quote-line-proforma-btn:focus-visible {
    border-color: var(--app-primary);
    background: var(--app-primary-soft);
    color: var(--app-primary-strong);
}

/* ── Responsive ── */
@media (max-width: 1120px) {
    .quote-master-line {
        grid-template-columns: 46px minmax(0, 1fr) auto;
    }
}

@media (max-width: 680px) {
    .quote-master-line {
        grid-template-columns: minmax(0, 1fr) auto;
    }
    .quote-master-line-move {
        display: none;
    }
    .quote-master-lines-footer {
        flex-wrap: wrap;
    }
    .quote-line-proforma-btn {
        margin-left: 0;
    }
}

/* ═══════════════════════════════════════════════
   QUOTE LINE CARD — REDESIGN
   ═══════════════════════════════════════════════ */

/* Override old layout with new 3-col */
.quote-master-line {
    display: grid !important;
    grid-template-columns: 40px minmax(0,1fr) auto !important;
    align-items: center !important;
    gap: 10px !important;
    min-height: 54px !important;
    padding: 8px 12px !important;
    border: 1px solid var(--app-border, #e0ebf2) !important;
    border-radius: 10px !important;
