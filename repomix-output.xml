.production-flow-view.is-active {
    display: block;
}
.production-flow-panel {
    overflow: hidden;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 4px 12px rgba(15, 17, 23, .08), 0 1px 4px rgba(15, 17, 23, .06);
}
.production-flow-panel-head {
    display: flex;
    justify-content: space-between;
    padding: 16px 22px 14px;
    border-bottom: 1px solid #eceef5;
}
.production-flow-panel-head div {
    display: grid;
    gap: 1px;
}
.production-flow-panel-head strong {
    font-size: 14px;
    color: #0f1117;
}
.production-flow-panel-head span {
    font-size: 12px;
    color: #9499b0;
}
.production-flow-timeline {
    display: grid;
    padding: 20px 22px 8px;
}
.production-flow-step {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 0 14px;
    padding: 0;
    position: relative;
    border: 0;
    background: transparent;
}
.production-flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 25px;
    top: 46px;
    bottom: -16px;
    width: 2px;
    border-radius: 1px;
    background: repeating-linear-gradient(to bottom, #dde0ed 0, #dde0ed 5px, transparent 5px, transparent 9px);
}
.production-flow-marker {
    width: 48px;
    height: 48px;
