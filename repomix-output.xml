        fetchJson(`${QUOTES_ENDPOINT}?limit=60`),
        fetchJson(`${ORDERS_ENDPOINT}?limit=30`),
        fetchJson(`${PARTNERS_ENDPOINT}?limit=20`)
    ]);
    dataState = {
        quotes: quotesPayload.cotizaciones || [],
        orders: ordersPayload || { items: [] },
        partners: partnersPayload.socios || []
