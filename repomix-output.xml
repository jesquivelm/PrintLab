function renderNumberingSummary() {
    const isConsecutive = isConsecutiveNumbering();
    if (numberingRangeFields) numberingRangeFields.hidden = !isConsecutive;
    if (!isConsecutive) {
        if (numberingRangeStartInput) numberingRangeStartInput.value = '';
