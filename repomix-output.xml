        <span class="proceso-empty-note">${assignedMachines.length ? 'Mostrando recursos asignados en esta vista' : 'Sin recursos asignados en esta vista'}</span>
        ${hiddenCount > 0 || expanded ? `<button type="button" class="proceso-toggle" onclick='toggleProcessMachines(${JSON.stringify(procKey)})'>${expanded ? 'Ocultar vacías' : `Ver todas (${proc.maquinas.length})`}</button>` : ''}
      </div>
