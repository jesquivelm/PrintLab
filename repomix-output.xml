                    body: JSON.stringify(payload)
                });
                if (!response.ok) throw new Error('Error al guardar');
                loadedConfig = await response.json();
                window.dispatchEvent(new CustomEvent('erp-general-config-updated', { detail: loadedConfig }));
                try {
                    localStorage.setItem('erp-general-config-updated', JSON.stringify({ at: Date.now() }));
                } catch (_) {
                    // Ignore storage sync failure.
                }
                if (window.parent && window.parent !== window) {
                    window.parent.postMessage({ type: 'erp-general-config-updated', config: loadedConfig }, window.location.origin);
                }
                if (quoteProductTypesJsonField) {
                    quoteProductTypesJsonField.value = loadedConfig?.general?.quoteProductTypesJson || quoteProductTypesJsonField.value || '[]';
                }
                ensureIconLibraryFields();
                applyIconPreviews();
                bindIconUploadHandlers();
                renderConfigButtonsIcons();
                renderQuoteProductTypesTable();
                setInventoryClassificationStatus('Configura el campo SAP y luego mapea sus valores a categorías flexográficas.', false);
