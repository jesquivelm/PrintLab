.quote-master-toggle:hover,
.quote-master-toggle:focus-visible,
.quote-master-toggle[aria-expanded="true"] {
    color: var(--app-primary, #0b81b8) !important;
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
}

.quote-master-info-name {
    max-width: min(36vw, 420px) !important;
