</div>
<div class="toast" id="toast"></div>

<script>
// ════════════════════════════════════════════
// DATA
// ════════════════════════════════════════════
const PROCS=[
  {id:'diseno',lbl:'Diseño',machines:null,cats:['Arte incompleto','Cliente no aprueba','Archivo corrupto','Cambio de especificación']},
  {id:'preprensa',lbl:'Preprensa',machines:null,cats:['Error de separación de color','Archivo de baja resolución','Cambio de tinta']},
  {id:'visto_bueno',lbl:'Visto bueno',machines:null,cats:['Muestra fuera de especificación','Aprobación pendiente de cliente']},
  {id:'planchas',lbl:'Planchas',machines:[],cats:['Plancha dañada','Error de grabado','Desregistro de color','Desgaste prematuro','Plancha incorrecta para la orden']},
  {id:'tintas',lbl:'Tintas',machines:[],cats:['Tono fuera de especificación','Viscosidad incorrecta','Falta de pigmento','Contaminación de tinta','Falta de solvente']},
  {id:'impresion',lbl:'Impresión',machines:[],cats:['Plancha dañada','Color fuera de tono','Desregistro','Sustrato dañado','Mancha / repinte','Falla mecánica','Reimprimir plancha','Cambio de tinta','Velocidad fuera de rango']},
  {id:'acabados',lbl:'Acabados',machines:[],cats:['Aplicación irregular','Falla de secado','Desalineación','Corte incompleto','Presión incorrecta']},
  {id:'rebobinado',lbl:'Rebobinado',machines:[],cats:['Tensión incorrecta','Desalineación de bobina','Núcleo equivocado']},
  {id:'empaque',lbl:'Empaque',machines:null,cats:['Material insuficiente','Error de conteo','Caja equivocada']},
];

const PERSONAL=[
  {id:'lunch',lbl:'🍽 Almuerzo',dur:30},{id:'coffee',lbl:'☕ Café / merienda',dur:15},
  {id:'dinner',lbl:'🌙 Cena',dur:30},{id:'breakfast',lbl:'🌅 Desayuno',dur:20},
  {id:'wc',lbl:'🚻 Baño',dur:10},{id:'personal',lbl:'🧍 Tiempo personal',dur:0},
];
const MAINT=[
  {id:'prev',lbl:'🔧 Mantenimiento preventivo'},{id:'corr',lbl:'🔩 Mantenimiento correctivo'},
