<!-- ═══════════════════════════════════════════════════════ -->
<!-- MODAL: MÁQUINA                                         -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modal-maquina">
  <div class="modal">
    <div class="modal-title">
      <span id="modal-maquina-titulo">Nueva Máquina</span>
      <span class="modal-close" onclick="closeModal('modal-maquina')">✕</span>
    </div>
    <input type="hidden" id="maq-id-original">
    <div class="form-grid">
      <div class="field">
        <label>Código de máquina</label>
        <input type="text" id="maq-id" placeholder="Ej: M5" maxlength="10">
        <span class="hint">Opcional. Visible en planificación sin afectar el identificador interno.</span>
      </div>
      <div class="field">
        <label>Proceso al que pertenece *</label>
        <select id="maq-proceso">
          <option value="">— Seleccionar —</option>
        </select>
      </div>
      <div class="field" style="grid-column:1/-1">
        <label>Nombre del recurso *</label>
        <input type="text" id="maq-nombre" placeholder="Ej: Flexo 8C — Línea 3">
      </div>
      <div class="field" style="grid-column:1/-1">
        <label>Descripción / sub-línea</label>
        <input type="text" id="maq-sub" placeholder="Ej: 8 colores · Troquel · UV">
      </div>
      <div class="field">
        <label>Capacidad de colores</label>
        <input type="number" id="maq-colores" min="0" max="12" value="0">
      </div>
      <div class="field">
        <label>Velocidad nominal (pies/min)</label>
        <input type="number" id="maq-vel" min="0" value="0">
      </div>
      <div class="field">
        <label>OEE estimado (0.00 – 1.00)</label>
        <input type="number" id="maq-oee" min="0" max="1" step="0.01" value="0.85">
      </div>
      <div class="field">
        <label>Ancho máx. de banda (mm)</label>
        <input type="number" id="maq-ancho-max" min="0" placeholder="Ej: 1270">
      </div>
      <div class="field">
        <label>Ancho mín. de banda (mm)</label>
        <input type="number" id="maq-ancho-min" min="0" placeholder="Ej: 250">
      </div>
    </div>
    <div style="margin-top:14px">
      <div style="font-size:11px;font-weight:600;color:#888;margin-bottom:8px;text-transform:uppercase;letter-spacing:.04em">Capacidades especiales</div>
      <div class="toggle-row">
        <div class="toggle-lbl">Troquel integrado</div>
        <input type="checkbox" id="maq-troquel">
      </div>
      <div class="toggle-row">
        <div class="toggle-lbl">Barniz UV inline</div>
        <input type="checkbox" id="maq-uv">
      </div>
      <div class="toggle-row">
        <div class="toggle-lbl">Laminado</div>
        <input type="checkbox" id="maq-laminado">
      </div>
      <div class="toggle-row">
        <div class="toggle-lbl">Activa</div>
        <input type="checkbox" id="maq-activa" checked>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn" onclick="closeModal('modal-maquina')">Cancelar</button>
      <button class="btn primary" onclick="guardarMaquina()">Guardar máquina</button>
    </div>
  </div>
</div>


<script>
const API = '/api/planificacion';
let procesos = [];
let maquinas = [];

function displayProcessName(value) {
  const raw = String(value || '').trim();
  const key = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const labels = {
    diseno: 'Diseño',
    preprensa: 'Preprensa',
    impresion: 'Impresión',
    'impresion convencional': 'Impresión Convencional',
    'impresion digital': 'Impresión Digital',
    barnizado: 'Barniz',
    barniz: 'Barniz',
    numeracion: 'Numeración',
    rebobinado: 'Rebobinado',
    empaque: 'Empaque'
  };
  return labels[key] || raw || 'Sin proceso';
}

// ── TABS ─────────────────────────────────────────────────────
function showTab(tab) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('page-' + tab).classList.add('active');
  document.querySelectorAll('.nav-tab').forEach(t => {
    if (t.textContent.toLowerCase().includes(tab) || t.onclick.toString().includes(tab))
      t.classList.add('active');
  });
  if (tab === 'resumen') renderResumen();
}

// ── ALERTAS ───────────────────────────────────────────────────
function showAlert(msg, type = 'success') {
  const c = document.getElementById('alert-container');
  c.innerHTML = `<div class="alert ${type}">${type==='success'?'✓':'⚠'} ${msg}</div>`;
  setTimeout(() => c.innerHTML = '', 4000);
}

// ── MODALES ───────────────────────────────────────────────────
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

// ── CARGA DE DATOS ────────────────────────────────────────────
async function loadAll() {
  try {
    const [pRes, mRes] = await Promise.all([
      fetch(`${API}/procesos`),
      fetch(`${API}/maquinas/config`)
    ]);
    const pData = await pRes.json();
    const mData = await mRes.json();
    if (pData.ok) procesos = pData.data;
    if (mData.ok) maquinas = mData.data;
    renderProcesos();
    renderMaquinas();
    poblarSelectProceso();
  } catch (e) {
    document.getElementById('procesos-list').innerHTML =
      `<div class="empty"><div class="empty-icon">⚡</div>No se pudo conectar a la API.<br>Asegúrate que el servidor está corriendo.</div>`;
  }
}

// ── RENDER PROCESOS ───────────────────────────────────────────
function renderProcesos() {
  const list = document.getElementById('procesos-list');
  renderPlanningPrimarySelect();
  if (!procesos.length) {
    list.innerHTML = `<div class="empty"><div class="empty-icon">📋</div>No hay procesos configurados aún.<br>Agrega el primero con el botón superior.</div>`;
    return;
  }
  const selectedPrimary = document.getElementById('planning-primary-select')?.value || '';
  list.innerHTML = procesos.map(p => `
    <div class="proceso-row ${String(p.id_proceso) === String(selectedPrimary) ? 'is-selected' : ''}" draggable="true" data-id="${p.id_proceso}">
      <span class="drag-handle">⋮⋮</span>
      <span class="proceso-orden" style="background:${p.color_hex}">${p.orden_secuencia}</span>
      <div>
        <div style="display:flex;align-items:center;gap:7px">
          <span style="font-size:16px">${p.icono || '⚙'}</span>
          <span class="proceso-nombre">${displayProcessName(p.nombre)}</span>
          <span class="badge-paralelo ${p.es_paralelo?'si':'no'}">${p.es_paralelo?'Paralelo':'Secuencial'}</span>
          ${!p.activo ? '<span style="font-size:10px;color:#aaa;background:#f5f5f3;padding:1px 6px;border-radius:4px">Inactivo</span>' : ''}
        </div>
        <div class="proceso-maquinas" style="margin-top:2px">
          ${parseInt(p.total_maquinas) > 0
            ? `${p.total_maquinas} máquina(s) asignada(s)`
            : '<span style="color:#E24B4A">Sin máquinas asignadas</span>'}
        </div>
      </div>
      <div></div>
      <div></div>
      <div class="proceso-actions">
        <button class="btn sm" onclick="editarProceso(${p.id_proceso})">Editar</button>
        <button class="btn sm danger" onclick="eliminarProceso(${p.id_proceso},'${p.nombre}')">✕</button>
      </div>
    </div>
  `).join('');
}

function renderPlanningPrimarySelect() {
  const select = document.getElementById('planning-primary-select');
  const summary = document.getElementById('planning-primary-summary');
  if (!select) return;
  const previous = select.value;
  const active = procesos.filter(p => p.activo !== false);
  select.innerHTML = active.map(p => `<option value="${p.id_proceso}">${p.icono || '⚙'} ${displayProcessName(p.nombre)}</option>`).join('');
  if (previous && active.some(p => String(p.id_proceso) === String(previous))) select.value = previous;
  if (!select.value && active[0]) select.value = active[0].id_proceso;
  const selected = active.find(p => String(p.id_proceso) === String(select.value));
  if (summary) {
    summary.textContent = selected
      ? `${active.length} procesos activos · ${Number(selected.total_maquinas || 0)} máquina(s) en ${displayProcessName(selected.nombre)}`
      : 'Sin procesos activos de clasificación';
  }
}

// ── RENDER MÁQUINAS (agrupadas por proceso) ───────────────────
function renderMaquinas() {
  const list = document.getElementById('maquinas-list');
  if (!maquinas.length) {
    list.innerHTML = `<div class="empty"><div class="empty-icon">🖨</div>No hay máquinas configuradas.</div>`;
    return;
  }

  // Agrupar por proceso
  const grupos = {};
  const sinProceso = [];
  maquinas.forEach(m => {
    if (!m.id_proceso) { sinProceso.push(m); return; }
    const key = m.id_proceso;
    if (!grupos[key]) grupos[key] = { proceso: { nombre: displayProcessName(m.proceso_nombre), color: m.color_hex, icono: m.proceso_icono, orden: m.orden_secuencia }, maquinas: [] };
    grupos[key].maquinas.push(m);
  });

  const sorted = Object.values(grupos).sort((a,b) => a.proceso.orden - b.proceso.orden);
  if (sinProceso.length) sorted.push({ proceso: { nombre: 'Sin proceso asignado', color: '#aaa', icono: '?', orden: 99 }, maquinas: sinProceso });

  list.innerHTML = sorted.map(g => `
    <div class="card" style="margin-bottom:14px">
      <div class="card-hdr">
        <span class="card-title">
          <span style="width:12px;height:12px;border-radius:50%;background:${g.proceso.color};display:inline-block"></span>
          ${g.proceso.icono} ${g.proceso.nombre}
          <span style="font-size:11px;color:#aaa;font-weight:400">(${g.maquinas.length} máquina${g.maquinas.length!==1?'s':''})</span>
        </span>
        <button class="btn sm primary" onclick="openModalMaquina(${g.maquinas[0]?.id_proceso||''})">+ Máquina</button>
      </div>
      <div class="maq-section">
        <div class="maq-list">
          ${g.maquinas.map(m => maqRow(m)).join('')}
        </div>
      </div>
    </div>
  `).join('');
}

function maqRow(m) {
  const flags = [];
  if (m.flag_troquel)    flags.push('<span class="flag">Troquel</span>');
  if (m.flag_barniz_uv)  flags.push('<span class="flag">UV</span>');
  if (m.flag_laminado)   flags.push('<span class="flag">Laminado</span>');
  if (m.capacidad_colores > 0) flags.push(`<span class="flag">${m.capacidad_colores}C</span>`);

  return `<div class="maq-row ${m.activa?'':'inactive'}">
    <div>
      <div style="display:flex;align-items:center;gap:6px">
        <span class="maq-id">${m.codigo_maquina || '—'}</span>
        ${!m.activa ? '<span style="font-size:10px;color:#aaa;background:#f5f5f3;padding:1px 5px;border-radius:3px">Inactiva</span>' : ''}
      </div>
      <div class="maq-nombre">${m.nombre_recurso}</div>
      ${m.sub_descripcion ? `<div class="maq-sub">${m.sub_descripcion}</div>` : ''}
    </div>
    <div style="font-size:11px;color:#666">${m.velocidad_nom ? m.velocidad_nom + ' pies/min' : '—'}</div>
    <div style="font-size:11px;color:#666">${m.oee ? (parseFloat(m.oee)*100).toFixed(0) + '% OEE' : '—'}</div>
    <div style="font-size:11px;color:#666">${m.ancho_max_banda ? m.ancho_max_banda + 'mm' : '—'}</div>
    <div class="maq-flags">${flags.join('') || '<span style="font-size:11px;color:#ccc">Sin caps. especiales</span>'}</div>
    <div class="maq-actions">
        <button class="btn sm" onclick="editarMaquina('${m.id}')">Editar</button>
        <button class="btn sm danger" onclick="desactivarMaquina('${m.id}','${m.nombre_recurso}',${m.activa})">${m.activa?'✕ Desactivar':'✓ Activar'}</button>
    </div>
  </div>`;
}

// ── RENDER RESUMEN ────────────────────────────────────────────
function renderResumen() {
  const totalMaq = maquinas.length;
  const activeMaq = maquinas.filter(m => m.activa).length;
  const sinProceso = maquinas.filter(m => !m.id_proceso).length;

  document.getElementById('resumen-content').innerHTML = `
    <div class="summary-grid">
      <div class="summary-card"><div class="summary-num">${procesos.length}</div><div class="summary-lbl">Procesos configurados</div></div>
      <div class="summary-card"><div class="summary-num">${activeMaq}</div><div class="summary-lbl">Máquinas activas</div></div>
      <div class="summary-card"><div class="summary-num" style="color:${sinProceso?'#E24B4A':'#1D9E75'}">${sinProceso}</div><div class="summary-lbl">Máquinas sin proceso</div></div>
      <div class="summary-card"><div class="summary-num">${totalMaq - activeMaq}</div><div class="summary-lbl">Máquinas inactivas</div></div>
    </div>

    <div class="card">
      <div class="card-hdr"><span class="card-title">📊 Distribución por proceso</span></div>
      <div style="padding:14px 18px">
        ${procesos.map(p => {
          const maqsDeProc = maquinas.filter(m => m.id_proceso == p.id_proceso && m.activa);
          const pct = totalMaq > 0 ? Math.round(maqsDeProc.length / Math.max(activeMaq,1) * 100) : 0;
          return `<div style="margin-bottom:12px">
            <div style="display:flex;justify-content:space-between;margin-bottom:4px">
              <span style="font-size:12px;font-weight:500">${p.icono} ${p.nombre}</span>
              <span style="font-size:11px;color:#888">${maqsDeProc.length} máquina${maqsDeProc.length!==1?'s':''}</span>
            </div>
            <div style="height:8px;background:#f0f0ea;border-radius:4px;overflow:hidden">
              <div style="height:100%;width:${pct}%;background:${p.color_hex};border-radius:4px;transition:width .4s"></div>
            </div>
          </div>`;
        }).join('')}
      </div>
    </div>
  `;
}

// ── MODAL PROCESO ─────────────────────────────────────────────
function openModalProceso(id = null) {
  document.getElementById('proc-id').value = id || '';
  document.getElementById('modal-proceso-titulo').textContent = id ? 'Editar Proceso' : 'Nuevo Proceso';
  if (!id) {
    document.getElementById('proc-nombre').value = '';
    document.getElementById('proc-orden').value = procesos.length + 1;
    document.getElementById('proc-icono').value = '⚙';
    document.getElementById('proc-color').value = '#378ADD';
    document.getElementById('proc-color-preview').style.background = '#378ADD';
    document.getElementById('proc-color-hex').textContent = '#378ADD';
    document.getElementById('proc-paralelo').checked = false;
    document.getElementById('proc-activo').checked = true;
  }
  openModal('modal-proceso');
}

function editarProceso(id) {
  const p = procesos.find(x => x.id_proceso == id);
  if (!p) return;
  document.getElementById('proc-id').value      = p.id_proceso;
  document.getElementById('proc-nombre').value  = p.nombre;
  document.getElementById('proc-orden').value   = p.orden_secuencia;
  document.getElementById('proc-icono').value   = p.icono || '⚙';
  document.getElementById('proc-color').value   = p.color_hex || '#378ADD';
  document.getElementById('proc-color-preview').style.background = p.color_hex;
  document.getElementById('proc-color-hex').textContent = p.color_hex;
  document.getElementById('proc-paralelo').checked = p.es_paralelo;
  document.getElementById('proc-activo').checked   = p.activo;
  document.getElementById('modal-proceso-titulo').textContent = 'Editar Proceso';
  openModal('modal-proceso');
}

document.getElementById('proc-color').addEventListener('input', e => {
  document.getElementById('proc-color-preview').style.background = e.target.value;
  document.getElementById('proc-color-hex').textContent = e.target.value;
});

async function guardarProceso() {
  const id    = document.getElementById('proc-id').value;
  const body  = {
    nombre:          document.getElementById('proc-nombre').value.trim(),
    orden_secuencia: parseInt(document.getElementById('proc-orden').value),
    icono:           document.getElementById('proc-icono').value.trim() || '⚙',
    color_hex:       document.getElementById('proc-color').value,
    es_paralelo:     document.getElementById('proc-paralelo').checked,
    activo:          document.getElementById('proc-activo').checked,
  };
  if (!body.nombre || !body.orden_secuencia) { alert('Nombre y orden son obligatorios.'); return; }

  try {
    const url = id ? `${API}/procesos/${id}` : `${API}/procesos`;
    const met = id ? 'PUT' : 'POST';
    const res = await fetch(url, { method: met, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);
    closeModal('modal-proceso');
    showAlert(id ? 'Proceso actualizado correctamente.' : 'Proceso creado correctamente.');
    await loadAll();
  } catch(e) { showAlert('Error: ' + e.message, 'error'); }
}

async function eliminarProceso(id, nombre) {
  if (!confirm(`¿Eliminar el proceso "${nombre}"?\nSolo es posible si no tiene máquinas asignadas.`)) return;
  try {
    const res = await fetch(`${API}/procesos/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);
    showAlert('Proceso eliminado.');
    await loadAll();
  } catch(e) { showAlert('Error: ' + e.message, 'error'); }
}

// ── MODAL MÁQUINA ─────────────────────────────────────────────
function poblarSelectProceso() {
  const sel = document.getElementById('maq-proceso');
  sel.innerHTML = '<option value="">— Seleccionar —</option>' +
    procesos.map(p => `<option value="${p.id_proceso}">${p.icono} ${p.nombre}</option>`).join('');
}

function openModalMaquina(idProceso = null) {
  document.getElementById('maq-id-original').value = '';
  document.getElementById('modal-maquina-titulo').textContent = 'Nueva Máquina';
  document.getElementById('maq-id').value        = '';
  document.getElementById('maq-id').disabled     = false;
  document.getElementById('maq-nombre').value    = '';
  document.getElementById('maq-sub').value       = '';
  document.getElementById('maq-proceso').value   = idProceso || '';
  document.getElementById('maq-colores').value   = '0';
  document.getElementById('maq-vel').value       = '0';
  document.getElementById('maq-oee').value       = '0.85';
  document.getElementById('maq-ancho-max').value = '';
  document.getElementById('maq-ancho-min').value = '';
  document.getElementById('maq-troquel').checked  = false;
  document.getElementById('maq-uv').checked       = false;
  document.getElementById('maq-laminado').checked = false;
  document.getElementById('maq-activa').checked   = true;
  openModal('modal-maquina');
}

function editarMaquina(id) {
  const m = maquinas.find(x => x.id === id);
  if (!m) return;
  document.getElementById('maq-id-original').value = m.id;
  document.getElementById('modal-maquina-titulo').textContent = 'Editar Máquina';
  document.getElementById('maq-id').value        = m.codigo_maquina || '';
  document.getElementById('maq-id').disabled     = false;
  document.getElementById('maq-nombre').value    = m.nombre_recurso;
  document.getElementById('maq-sub').value       = m.sub_descripcion || '';
  document.getElementById('maq-proceso').value   = m.id_proceso || '';
  document.getElementById('maq-colores').value   = m.capacidad_colores || 0;
  document.getElementById('maq-vel').value       = m.velocidad_nom || 0;
  document.getElementById('maq-oee').value       = m.oee || 0.85;
  document.getElementById('maq-ancho-max').value = m.ancho_max_banda || '';
  document.getElementById('maq-ancho-min').value = m.ancho_min_banda || '';
  document.getElementById('maq-troquel').checked  = m.flag_troquel;
  document.getElementById('maq-uv').checked       = m.flag_barniz_uv;
  document.getElementById('maq-laminado').checked = m.flag_laminado;
  document.getElementById('maq-activa').checked   = m.activa;
  openModal('modal-maquina');
}

async function guardarMaquina() {
  const idOrig = document.getElementById('maq-id-original').value;
  const body = {
    id_maquina:       document.getElementById('maq-id').value.trim().toUpperCase(),
    nombre_recurso:   document.getElementById('maq-nombre').value.trim(),
    sub_descripcion:  document.getElementById('maq-sub').value.trim() || null,
    id_proceso:       document.getElementById('maq-proceso').value || null,
    capacidad_colores:parseInt(document.getElementById('maq-colores').value) || 0,
    velocidad_nom:    parseFloat(document.getElementById('maq-vel').value) || 0,
    oee:              parseFloat(document.getElementById('maq-oee').value) || 0.85,
    ancho_max_banda:  document.getElementById('maq-ancho-max').value || null,
    ancho_min_banda:  document.getElementById('maq-ancho-min').value || null,
    flag_troquel:     document.getElementById('maq-troquel').checked,
    flag_barniz_uv:   document.getElementById('maq-uv').checked,
    flag_laminado:    document.getElementById('maq-laminado').checked,
    activa:           document.getElementById('maq-activa').checked,
  };
  if (!body.nombre_recurso) { alert('El nombre es obligatorio.'); return; }

  try {
    let url, met;
    if (idOrig) { url = `${API}/maquinas/${idOrig}`; met = 'PUT'; }
    else         { url = `${API}/maquinas`;           met = 'POST'; }
    const res  = await fetch(url, { method: met, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);
    closeModal('modal-maquina');
    showAlert(idOrig ? 'Máquina actualizada.' : 'Máquina creada correctamente.');
    await loadAll();
  } catch(e) { showAlert('Error: ' + e.message, 'error'); }
}

async function desactivarMaquina(id, nombre, activa) {
  const accion = activa ? 'desactivar' : 'reactivar';
  if (!confirm(`¿${accion.charAt(0).toUpperCase()+accion.slice(1)} la máquina "${nombre}"?`)) return;
  try {
    const res  = activa
      ? await fetch(`${API}/maquinas/${id}`, { method: 'DELETE' })
      : await fetch(`${API}/maquinas/${id}`, { method: 'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ activa: true }) });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error);
    showAlert(`Máquina ${activa?'desactivada':'reactivada'}.`);
    await loadAll();
  } catch(e) { showAlert('Error: ' + e.message, 'error'); }
}

// Cerrar modales al click fuera
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', e => {
    if (e.target === overlay) overlay.classList.remove('open');
  });
});

document.getElementById('planning-primary-select')?.addEventListener('change', (event) => {
  renderProcesos();
  document.querySelector(`.proceso-row[data-id="${event.target.value}"]`)?.scrollIntoView({ block: 'nearest' });
});

// ── INICIO ────────────────────────────────────────────────────
loadAll();
  const erpAccessScript = document.createElement('script');
  erpAccessScript.src = '/access-control.js';
  document.head.appendChild(erpAccessScript);
</script>
</body>
</html>
