});

const PRODUCTION_FLOW_SEQUENCE = Object.freeze([
    'diseno',
    'preprensa',
    'visto_bueno',
    'planchas',
    'tintas',
    'impresion',
    'acabados',
    'rebobinado',
    'empaque'
]);

const PRODUCTION_FLOW_LABELS = Object.freeze({
