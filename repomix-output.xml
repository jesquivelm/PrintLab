    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: #c8cbda;
}
.production-flow-live.is-live span {
    background: #059669;
    box-shadow: 0 0 0 4px rgba(5, 150, 105, .16);
}
.production-flow-tabs {
