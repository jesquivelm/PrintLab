    font-size: 12px;
    color: #203746;
    box-sizing: border-box;
    min-width: 0;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
}
.production-inline-form .field textarea {
    min-height: 82px;
    max-height: 122px;
    resize: vertical;
    padding: 10px 12px;
}
.production-observations-section {
    margin-top: 8px;
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 100%;
}
.production-inline-form .field select {
    min-width: 0;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding-right: 34px;
    background-image:
        linear-gradient(45deg, transparent 50%, #8ba2b4 50%),
        linear-gradient(135deg, #8ba2b4 50%, transparent 50%),
        linear-gradient(180deg, #fcfeff 0%, #f6fafc 100%);
    background-position:
        calc(100% - 16px) calc(50% - 2px),
        calc(100% - 11px) calc(50% - 2px),
        0 0;
    background-size:
        5px 5px,
        5px 5px,
        100% 100%;
    background-repeat: no-repeat;
}
.production-inline-form .field input:focus,
.production-inline-form .field select:focus,
.production-inline-form .field textarea:focus {
