    const deleteIcon = getResolvedIcon(['quantity.delete', 'quantityDelete', 'icons.quantity.delete'], 'quantity.delete');
    requestQuantityRepeater.innerHTML = `<div class="quantity-row">${quantities.map((item, index) => {
