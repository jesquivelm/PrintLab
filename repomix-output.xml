      <div class="g-row" data-machine="${m.id_maquina}" style="border-left:3px solid ${proc.color}">
        <div class="res-lbl">
          <span class="res-name">${m.nombre_recurso}</span>
          ${machineSub ? `<span class="res-sub">${machineSub}</span>` : ''}
        </div>
        <div class="timeline" data-machine="${m.id_maquina}">
          ${HOURS.map((_, i) => `<div class="grid-ln" style="left:${pct(i)}"></div>`).join('')}
          ${mOps.map(op => taskBar(op, machineConflictRutas, sequenceConflictRutas)).join('')}
        </div>
      </div>`;
    });
  });

  // Si no hay procesos configurados, mostrar aviso
  if (procesos.length === 0) {
    html += `<div style="padding:32px;text-align:center;color:#aaa">
      ⚙ No hay procesos configurados. <a href="configuracion.html" style="color:#378ADD">Ir a Configuración →</a>
    </div>`;
  }

  html += `</div></div>
  <div class="legend">
    <span class="leg-item"><span class="leg-dot" style="background:#1D9E75"></span>En ejecución</span>
    <span class="leg-item"><span class="leg-dot" style="background:#BA7517"></span>Setup</span>
    <span class="leg-item"><span class="leg-dot" style="background:#378ADD"></span>Pendiente</span>
    <span class="leg-item"><span class="leg-dot" style="background:#E24B4A"></span>Alerta / Paro</span>
    <span class="leg-item"><span class="leg-dot" style="background:#639922"></span>Completado</span>
    <span class="leg-item" style="font-size:11px;color:#aaa;margin-left:auto">
      Click para ver cadena · Drag para mover · <span style="background:#FFD600;padding:1px 5px;border-radius:3px;color:#1a1a1a">⬤</span> Cadena activa
    </span>
  </div>`;

  document.getElementById('app').innerHTML = html;
  setupDropZones();

  // Dibujar flechas después de que el DOM esté listo
  requestAnimationFrame(() => drawArrows());
}

// ── FLECHAS SVG ────────────────────────────────────────────
function drawArrows() {
  const ganttEl = document.getElementById('gantt-inner');
  if (!ganttEl) return;

  // Eliminar SVG anterior
  const old = document.getElementById('arrows-svg');
  if (old) old.remove();

  // Solo dibujar si hay dependencias
  const depsOrders = orders.filter(o => o.dep_ruta_id || o.dep);
  if (!depsOrders.length) return;

  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.id = 'arrows-svg';
  ganttEl.appendChild(svg);

  // Definir marcadores de flecha
  const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');

  [
    { id: 'arr-normal', color: '#8a97a6' },
    { id: 'arr-active', color: '#FFD600' },
    { id: 'arr-dim',    color: '#ddd' },
  ].forEach(({id, color}) => {
    const marker = document.createElementNS('http://www.w3.org/2000/svg', 'marker');
    marker.setAttribute('id', id);
    marker.setAttribute('markerWidth', '9');
    marker.setAttribute('markerHeight', '9');
    marker.setAttribute('refX', '7');
    marker.setAttribute('refY', '4');
    marker.setAttribute('orient', 'auto');
    const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
    poly.setAttribute('points', '0 1, 8 4, 0 7');
    poly.setAttribute('fill', color);
    marker.appendChild(poly);
    defs.appendChild(marker);
  });
  svg.appendChild(defs);

  const ganttRect = ganttEl.getBoundingClientRect();

  orders.forEach(op => {
    // Buscar dependencia: primero por dep_ruta_id, luego por dep (codigo_op)
    let srcRutaId = op.dep_ruta_id;
    if (!srcRutaId && op.dep) {
      const srcOp = orders.find(o => o.id === op.dep);
      if (srcOp) srcRutaId = srcOp.id_ruta;
    }
    if (!srcRutaId) return;

    const srcEl = document.getElementById('bar-' + srcRutaId);
    const tgtEl = document.getElementById('bar-' + op.id_ruta);
    if (!srcEl || !tgtEl) return;

    const srcRect = srcEl.getBoundingClientRect();
    const tgtRect = tgtEl.getBoundingClientRect();

    const x1 = srcRect.right  - ganttRect.left;
    const y1 = srcRect.top    + srcRect.height / 2 - ganttRect.top;
    const x2 = tgtRect.left   - ganttRect.left;
    const y2 = tgtRect.top    + tgtRect.height / 2 - ganttRect.top;

    // Determinar estilo según cadena activa
    let markerId = 'arr-normal';
    let strokeColor = '#8a97a6';
    let strokeWidth = 2.2;
    let strokeDash = '';

    if (activeChainIds) {
      const inChain = activeChainIds.has(op.id_ruta) && activeChainIds.has(srcRutaId);
      if (inChain) {
        markerId   = 'arr-active';
        strokeColor = '#FFD600';
        strokeWidth = 3;
        strokeDash  = 'none';
      } else {
        markerId    = 'arr-dim';
        strokeColor = '#ddd';
        strokeWidth = 1;
      }
    }

    // Control points para curva bezier
    const dx = Math.abs(x2 - x1);
    const cp = Math.max(40, Math.min(dx * 0.5, 100));
    const d  = `M${x1},${y1} C${x1+cp},${y1} ${x2-cp},${y2} ${x2},${y2}`;

    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    path.setAttribute('stroke', strokeColor);
    path.setAttribute('stroke-width', strokeWidth);
    path.setAttribute('stroke-dasharray', strokeDash === 'none' ? '' : strokeDash);
    path.setAttribute('fill', 'none');
    path.setAttribute('marker-end', `url(#${markerId})`);
    svg.appendChild(path);
  });
}

function clearChain() {
