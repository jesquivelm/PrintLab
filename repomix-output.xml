}
.production-flow-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 22px;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 4px 12px rgba(15, 17, 23, .08), 0 1px 4px rgba(15, 17, 23, .06);
}
.production-flow-header div:first-child {
    display: grid;
    gap: 3px;
    min-width: 0;
}
.production-flow-header span {
    font-size: 11px;
    font-weight: 500;
    color: #9499b0;
    letter-spacing: .06em;
    text-transform: uppercase;
}
.production-flow-header strong {
    font-size: 18px;
    color: #0f1117;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.production-flow-header em {
    font-size: 13px;
    color: #5c6078;
