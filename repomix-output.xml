    box-shadow: 0 16px 34px rgba(19, 39, 54, 0.07);
}
.dashboard-access-empty strong {
    color: #283643;
    font-size: 15px;
}
.dashboard-access-empty span {
    font-size: 13px;
}
.dashboard-access-toast {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 80;
    max-width: min(360px, calc(100vw - 44px));
    padding: 13px 16px;
    border: 1px solid #cddde8;
    border-radius: 16px;
    background: #ffffff;
    color: #33414f;
    font-size: 13px;
    box-shadow: 0 18px 38px rgba(19, 39, 54, 0.16);
}
.dashboard-inventory-empty {
    padding: 12px 14px;
    color: #6f7d89;
    font-size: 12px;
    text-align: center;
}
.erp-access-blocked {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 28px;
    background: linear-gradient(135deg, #eef5f9 0%, #ffffff 58%, #f5efe8 100%);
}
.erp-access-blocked section {
    display: grid;
    gap: 10px;
    max-width: 430px;
    padding: 28px;
    border: 1px solid #d6e3eb;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.9);
    color: #5c6a76;
    text-align: center;
    box-shadow: 0 20px 42px rgba(19, 39, 54, 0.11);
}
.erp-access-blocked strong {
    color: #263542;
    font-size: 20px;
}
.erp-access-blocked a {
    justify-self: center;
    margin-top: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: #0b81b8;
    color: #ffffff;
    text-decoration: none;
}
.dashboard-workspace {
    min-height: 0;
    height: 100%;
    padding: 0;
    position: relative;
}
.dashboard-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: var(--app-bg);
    box-shadow: none;
    color-scheme: light dark;
}
.dashboard-frame[hidden] {
    display: none;
}
.dashboard-workspace-shell {
    min-height: 0;
    padding-top: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
}
.dashboard-workspace-shell.has-tab-wrap {
    padding-top: 0;
}

.dashboard-favorites {
    position: sticky;
    bottom: 0;
    width: min(980px, 100%);
    margin: auto auto 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    z-index: 2;
}

.dashboard-favorites-head {
    display: none;
}

.dashboard-favorites-body {
    display: block;
}

.dashboard-favorites-drum-shell {
    width: 100%;
}

.dashboard-favorites-drum-viewport {
    width: min(980px, 100%);
    height: var(--favorite-drum-height, 220px);
    margin: 0 auto;
    overflow: hidden;
    cursor: grab;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.24) 10%, #000 24%, #000 76%, rgba(0,0,0,0.24) 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.24) 10%, #000 24%, #000 76%, rgba(0,0,0,0.24) 90%, transparent 100%);
}

.dashboard-favorites-drum-viewport:active {
    cursor: grabbing;
}

.dashboard-favorites-drum-canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.dashboard-favorites-empty {
    padding: 14px 16px;
    border: 1px dashed #d5e0e8;
    border-radius: 16px;
    color: #7b8894;
    background: #f9fbfd;
    font-size: 13px;
}

.dashboard-favorites-reel {
    position: relative;
    display: grid;
    gap: 6px;
    max-height: 236px;
    overflow-y: auto;
    padding: 88px 0;
    perspective: 1200px;
    scroll-snap-type: y proximity;
    scrollbar-width: none;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.25) 10%, #000 26%, #000 74%, rgba(0,0,0,0.25) 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.25) 10%, #000 26%, #000 74%, rgba(0,0,0,0.25) 90%, transparent 100%);
    transition: transform 0.28s cubic-bezier(0.22, 0.8, 0.22, 1);
}

.dashboard-favorites-reel::-webkit-scrollbar {
    display: none;
}

.dashboard-favorites-reel.is-bounce-top {
    transform: translateY(12px);
}

.dashboard-favorites-reel.is-bounce-bottom {
    transform: translateY(-12px);
}

.dashboard-favorites-reel::before,
.dashboard-favorites-reel::after {
    content: none;
}

.dashboard-favorites-item {
    display: block;
    width: min(920px, 100%);
    margin: 0 auto;
    padding: 9px 10px;
    border: 0;
    background: transparent;
    text-align: center;
    cursor: pointer;
    transform-origin: center center;
    transition: transform 0.18s ease, opacity 0.18s ease, color 0.18s ease, filter 0.18s ease;
    scroll-snap-align: center;
    pointer-events: none;
}

.dashboard-favorites-item:hover,
.dashboard-favorites-item:focus-visible {
    opacity: 1 !important;
    filter: none !important;
    transform: perspective(1200px) rotateX(0deg) scale(1.02) !important;
}

.dashboard-favorites-item.is-center {
    pointer-events: auto;
}

.dashboard-favorites-item-text {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    width: auto;
    max-width: min(860px, calc(100% - 24px));
    padding: 0 4px;
    color: var(--reel-text-color, #76838f);
    transform: scale(var(--reel-text-scale, 1));
    transform-origin: center center;
    transition: color 0.18s ease, transform 0.18s ease;
}

.dashboard-favorites-item:hover .dashboard-favorites-item-text,
.dashboard-favorites-item:focus-visible .dashboard-favorites-item-text {
    color: #223647;
}

.dashboard-favorites-item-text strong,
.dashboard-favorites-item-text span,
.dashboard-favorites-item-text em {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dashboard-favorites-item-text strong {
    max-width: 180px;
    color: inherit;
    font-size: 13px;
    font-weight: 700;
}

.dashboard-favorites-item-text span {
    max-width: 240px;
    font-size: 13px;
    color: inherit;
}

.dashboard-favorites-item-text em {
    max-width: 320px;
    font-style: normal;
    font-size: 13px;
    color: inherit;
}

.dashboard-bdfg-shell {
    position: fixed !important;
    top: 140px;
    right: 14px;
    left: auto;
    bottom: auto;
    z-index: 4990;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    width: var(--dashboard-bdfg-main-size, 86px);
    height: var(--dashboard-bdfg-main-size, 86px);
}

.dashboard-bdfg-shell.dragging {
    transition: none !important;
    z-index: 5000;
}

.dashboard-bdfg-primary {
    position: relative;
    display: flex;
    align-items: flex-start;
}

.floating-action-button {
    touch-action: none;
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    min-width: 25px;
    height: 58px;
    min-height: 25px;
    padding: 10px 12px;
    border: 1px solid rgba(11, 129, 184, 0.18);
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(237, 247, 253, 0.98) 100%);
    color: var(--floating-icon-color, #0b81b8);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 10;
}

.floating-action-button:hover,
.floating-action-button:focus-visible {
    color: var(--floating-icon-hover, var(--app-primary));
    border-color: rgba(11, 129, 184, 0.28);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 250, 255, 1) 100%);
    box-shadow: 0 18px 34px rgba(15, 23, 42, 0.16);
    transform: translateY(-2px);
    outline: none;
}

.dashboard-bdfg-button {
    position: relative;
    z-index: 2;
    width: var(--dashboard-bdfg-main-size, 86px);
    min-width: var(--dashboard-bdfg-main-size, 86px);
    height: var(--dashboard-bdfg-main-size, 86px);
    min-height: var(--dashboard-bdfg-main-size, 86px);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 31% 21%, rgba(255,255,255,.92), color-mix(in srgb, var(--dashboard-bdfg-main-color, #cbd5e1) 32%, transparent) 28%, color-mix(in srgb, var(--dashboard-bdfg-main-color, #cbd5e1) 72%, transparent) 60%, var(--dashboard-bdfg-main-color, #cbd5e1) 100%);
    color: #ffffff;
    box-shadow: var(--dashboard-bdfg-shadow, 0 18px 32px rgba(15,23,42,.18), inset 0 4px 10px rgba(255,255,255,.7), inset 0 -12px 18px rgba(0,0,0,.1));
    backdrop-filter: blur(12px) saturate(1.16);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform .28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow .28s ease, filter .28s ease;
    user-select: none;
    touch-action: none;
}

.dashboard-bdfg-button:hover,
.dashboard-bdfg-button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 22px 36px rgba(15,23,42,.22), inset 0 4px 10px rgba(255,255,255,.7), inset 0 -12px 18px rgba(0,0,0,.1);
    outline: none;
}

.dashboard-bdfg-button:active {
    transform: scale(.98);
    filter: brightness(1.02);
}

.dashboard-bdfg-shell.dragging .dashboard-bdfg-button {
    cursor: grabbing;
    transform: scale(1.02);
    box-shadow: 0 28px 44px rgba(15, 23, 42, 0.22), inset 0 4px 10px rgba(255,255,255,.7), inset 0 -12px 18px rgba(0,0,0,.1);
}

.dashboard-bdfg-button[aria-expanded="true"] .dashboard-bdfg-icon {
    transform: rotate(45deg);
}

.dashboard-bdfg-icon {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: inline-flex;
    width: var(--dashboard-bdfg-main-icon-size, 34px);
    height: var(--dashboard-bdfg-main-icon-size, 34px);
    align-items: center;
    justify-content: center;
    color: var(--dashboard-bdfg-icon-color, rgba(255,255,255,.98));
    filter: drop-shadow(0 2px 8px rgba(255,255,255,.22));
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
}

.dashboard-bdfg-icon svg {
    width: var(--dashboard-bdfg-main-icon-size, 34px);
    height: var(--dashboard-bdfg-main-icon-size, 34px);
    overflow: visible;
    pointer-events: none;
}

.dashboard-bdfg-button:hover .dashboard-bdfg-icon,
.dashboard-bdfg-button:focus-visible .dashboard-bdfg-icon {
    color: var(--dashboard-bdfg-icon-hover-color, var(--dashboard-bdfg-icon-color, rgba(255,255,255,.98)));
}

.dashboard-bdfg-icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.dashboard-bdfg-icon .icon-image,
.dashboard-bdfg-icon .icon-svg-mask,
.dashboard-bdfg-icon .icon-glyph {
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
}

.dashboard-bdfg-icon .dashboard-bdfg-main-icon {
    width: var(--dashboard-bdfg-main-icon-size, 34px);
    height: var(--dashboard-bdfg-main-icon-size, 34px);
    flex: 0 0 var(--dashboard-bdfg-main-icon-size, 34px);
}

.dashboard-bdfg-icon .dashboard-bdfg-main-icon.icon-glyph {
    font-size: var(--dashboard-bdfg-main-icon-size, 34px);
}

/* Radial Deployment Styles (Dashboard specific) */
.process-launcher-stack {
    position: relative;
    width: var(--dashboard-bdfg-main-size, 86px);
    height: var(--dashboard-bdfg-main-size, 86px);
    display: flex;
    align-items: center;
    justify-content: center;
}

.dashboard-bdfg-shell.process-launcher-stack {
    position: fixed !important;
}

.process-launcher-bridge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 5;
}

.process-launcher-item {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48px;
    height: 48px;
    margin-left: -24px;
    margin-top: -24px;
    border-radius: var(--orb-radius, 999px);
    border: none;
    background: var(--dashboard-bdfg-mini-bg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.28s ease, box-shadow 0.24s ease, border-color 0.24s ease, filter 0.24s ease;
    opacity: 0;
    transform: translate(0, 0) scale(0.4);
    pointer-events: none;
    box-shadow: none;
    color: var(--dashboard-bdfg-mini-color, #1f2937);
    backdrop-filter: none;
    z-index: 5;
    outline: none;
    padding: 0;
}

.process-launcher-item:hover {
    color: var(--orb-icon-hover-color, var(--dashboard-bdfg-mini-color, #1f2937));
    border-color: transparent;
    box-shadow: none;
    z-index: 20;
}

.process-launcher-item:disabled,
.process-launcher-item.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.dashboard-bdfg-shell.is-active .process-launcher-item {
    opacity: 1;
    pointer-events: auto;
}

.process-launcher-item::after {
    content: attr(title);
    position: absolute;
    top: 50%;
    transform: translateY(-50%) translateX(10px);
    background: rgba(15,35,50,0.95);
    color: #fff;
    padding: 5px 12px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.23, 1, 0.32, 1);
    backdrop-filter: blur(5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    border: 1px solid rgba(255,255,255,0.1);
    z-index: 100;
}

.dashboard-bdfg-shell[data-placement="left"] .process-launcher-item::after {
    left: calc(100% + 14px);
}

.dashboard-bdfg-shell[data-placement="right"] .process-launcher-item::after {
    right: calc(100% + 14px);
    transform: translateY(-50%) translateX(-10px);
}

.process-launcher-item:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
}

.dashboard-bdfg-shell.is-active .process-launcher-item {
    transform: translate(var(--orb-x, 0px), var(--orb-y, 0px)) scale(1);
}

.process-launcher-item:hover {
    transform: translate(var(--orb-x, 0px), var(--orb-y, 0px)) scale(1.08) !important;
}

.dashboard-bdfg-shell.is-active .dashboard-bdfg-button {
    transform: scale(1.03);
    filter: saturate(1.06);
}

.dashboard-bdfg-badge {
    position: absolute;
    top: -2px;
    right: -1px;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    border-radius: 999px;
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 8px;
    font-weight: 500;
    border: 1px solid var(--app-surface, #fff);
    box-shadow: 0 6px 12px rgba(127, 29, 29, 0.2);
}

.dashboard-bdfg-badge.is-dot {
    top: 2px;
    right: 3px;
    min-width: 7px;
    width: 7px;
    height: 7px;
    padding: 0;
    border-width: 1px;
}

.dashboard-bdfg-badge-inline {
    top: -5px;
    right: -5px;
    min-width: 18px;
    height: 18px;
    font-size: 10px;
    z-index: 10;
}

.dashboard-bdfg-mini-icon,
.dashboard-bdfg-mini-icon.icon-svg-mask,
.dashboard-bdfg-mini-icon.icon-image,
.dashboard-bdfg-mini-icon.icon-glyph {
    width: var(--orb-icon-size, 20px);
    height: var(--orb-icon-size, 20px);
    font-size: var(--orb-icon-size, 20px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.dashboard-bdfg-bridge {
    position: absolute;
    top: var(--bridge-offset-y, -1px);
    left: calc(100% - 1px);
    width: 400px;
    min-height: 60px;
    border: 1px solid var(--app-border);
    border-left-color: transparent;
    border-radius: 20px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--app-surface) 96%, #ffffff) 0%, var(--app-surface-soft) 100%);
    box-shadow: var(--app-shadow);
    overflow: hidden;
    transform-origin: left center;
    z-index: 100;
}

.dashboard-bdfg-bridge.dashboard-bdfg-bridge-processes {
    width: min(304px, calc(100vw - 42px));
}

.dashboard-bdfg-bridge.dashboard-bdfg-bridge-chat {
    width: min(620px, calc(100vw - 42px));
}

.dashboard-bdfg-shell[data-placement="right"] .dashboard-bdfg-bridge {
    left: auto;
    right: calc(100% - 1px);
    border-left-color: var(--app-border);
    border-right-color: transparent;
    transform-origin: right center;
}

.dashboard-bdfg-shell[data-v-placement="bottom"] .dashboard-bdfg-bridge {
    top: auto;
    bottom: calc(100% - 1px - var(--bridge-offset-y, 0px));
    transform-origin: center bottom;
}

.dashboard-bdfg-shell[data-v-placement="bottom"][data-placement="left"] .dashboard-bdfg-bridge {
    transform-origin: left bottom;
}

.dashboard-bdfg-shell[data-v-placement="bottom"][data-placement="right"] .dashboard-bdfg-bridge {
    transform-origin: right bottom;
}

/* Removed the old class-based rule in favor of the data-attribute one above */

.dashboard-bdfg-bridge[hidden] {
    display: none;
}

.dashboard-bdfg-bridge.is-favorites-floating {
    position: fixed;
    right: auto !important;
    bottom: auto !important;
    border-color: var(--app-border);
    transform-origin: center top;
}

.dashboard-bdfg-bridge.is-favorites-floating .dashboard-bdfg-head {
    cursor: move;
    user-select: none;
}

.dashboard-bdfg-bridge.is-favorites-floating.is-dragging {
    transition: none !important;
    z-index: 5010;
}

.dashboard-bdfg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 12px 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--app-border) 92%, transparent);
}

.dashboard-bdfg-head-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.dashboard-bdfg-head-copy strong {
    color: var(--app-text);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.15;
}

.dashboard-bdfg-head-copy span {
    color: var(--app-text-muted);
    font-size: 12px;
    line-height: 1.4;
}

.dashboard-bdfg-close {
    width: auto;
    height: auto;
    flex: 0 0 auto;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--app-text-soft);
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    box-shadow: none;
    transform: none;
    appearance: none;
    position: static;
}

.dashboard-bdfg-panel {
    display: grid;
    gap: 10px;
    max-height: min(72vh, 560px);
    padding: 10px 10px 12px;
    overflow: auto;
}

.dashboard-bdfg-process-tray {
    --process-shell-bg: linear-gradient(180deg, color-mix(in srgb, var(--app-surface-raised) 92%, var(--app-bg-soft)) 0%, var(--app-surface-soft) 100%);
    --process-shell-border: color-mix(in srgb, var(--app-border) 84%, transparent);
    --process-tab-text: var(--app-text-soft);
    --process-tab-hover-bg: color-mix(in srgb, var(--app-primary) 12%, var(--app-surface));
    --process-tab-hover-text: var(--app-text);
    --process-tab-active-bg: linear-gradient(180deg, color-mix(in srgb, var(--app-primary-strong) 74%, var(--app-primary)) 0%, var(--app-primary) 100%);
    --process-tab-active-text: #ffffff;
    --process-tab-active-shadow: 0 10px 20px color-mix(in srgb, var(--app-primary) 30%, transparent);
    --process-scroll-track: color-mix(in srgb, var(--app-border-strong) 78%, var(--app-surface-soft));
    --process-scroll-thumb: linear-gradient(180deg, color-mix(in srgb, var(--app-text) 50%, var(--app-surface-raised)) 0%, color-mix(in srgb, var(--app-text-soft) 78%, var(--app-surface)) 100%);
    --process-scroll-thumb-hover: linear-gradient(180deg, color-mix(in srgb, var(--app-primary) 28%, var(--app-text)) 0%, color-mix(in srgb, var(--app-primary-strong) 38%, var(--app-text)) 100%);
    --process-chip-bg: linear-gradient(180deg, color-mix(in srgb, var(--app-primary) 84%, var(--app-surface)) 0%, color-mix(in srgb, var(--app-primary-strong) 92%, var(--app-surface-raised)) 100%);
    --process-chip-border: color-mix(in srgb, var(--app-primary-strong) 48%, var(--app-border-strong));
    --process-chip-border-hover: color-mix(in srgb, var(--app-primary) 72%, #ffffff);
    --process-chip-text: #ffffff;
    --process-chip-accent: color-mix(in srgb, #ffffff 88%, var(--app-primary-soft));
    --process-chip-shadow: 0 12px 24px color-mix(in srgb, var(--app-primary) 18%, transparent);
    /* Existing processes should look consistent with Add processes. */
    --process-chip-existing-bg: var(--process-chip-bg);
    --process-chip-existing-border: var(--process-chip-border);
    --process-chip-existing-text: var(--process-chip-text);
    --process-chip-existing-accent: var(--process-chip-accent);
    --process-empty-bg: linear-gradient(180deg, color-mix(in srgb, var(--app-surface) 94%, var(--app-bg-soft)) 0%, var(--app-surface-soft) 100%);
    --process-empty-border: color-mix(in srgb, var(--app-border) 80%, transparent);
    --process-empty-text: var(--app-text-muted);
    display: grid;
    gap: 10px;
    padding-top: 4px;
}

.dashboard-bdfg-process-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--process-shell-border);
    border-radius: 14px;
    background: var(--process-shell-bg);
}

.dashboard-bdfg-process-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 6px 10px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--process-tab-text);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .18s ease, color .18s ease, box-shadow .18s ease, transform .18s ease;
}

.dashboard-bdfg-process-tab:hover,
.dashboard-bdfg-process-tab:focus-visible {
    background: var(--process-tab-hover-bg);
    color: var(--process-tab-hover-text);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--app-primary) 18%, transparent);
    outline: none;
}

.dashboard-bdfg-process-tab.is-active {
    background: var(--process-tab-active-bg);
    color: var(--process-tab-active-text);
    box-shadow: var(--process-tab-active-shadow);
}

.dashboard-bdfg-process-tab.is-active:hover,
.dashboard-bdfg-process-tab.is-active:focus-visible {
    background: var(--process-tab-active-bg);
    color: #eaf8ff;
}

.dashboard-bdfg-process-panel {
    display: grid;
    gap: 8px;
}

.dashboard-bdfg-process-panel[hidden] {
    display: none;
}

.dashboard-bdfg-process-tray-list {
    display: grid;
    gap: 6px;
    max-height: 360px;
    padding-right: 2px;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--process-scroll-thumb) var(--process-scroll-track);
}

.dashboard-bdfg-process-tray-list::-webkit-scrollbar,
.dashboard-bdfg-panel::-webkit-scrollbar {
    width: 10px;
}

.dashboard-bdfg-process-tray-list::-webkit-scrollbar-track,
.dashboard-bdfg-panel::-webkit-scrollbar-track {
    background: var(--process-scroll-track, #0f1828);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--app-border) 58%, transparent);
}

.dashboard-bdfg-process-tray-list::-webkit-scrollbar-thumb,
.dashboard-bdfg-panel::-webkit-scrollbar-thumb {
    background: var(--process-scroll-thumb, linear-gradient(180deg, #1e3a57 0%, #2e5a80 100%));
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--app-surface) 42%, var(--process-scroll-track, #0f1828));
}

.dashboard-bdfg-process-tray-list::-webkit-scrollbar-thumb:hover,
.dashboard-bdfg-panel::-webkit-scrollbar-thumb:hover {
    background: var(--process-scroll-thumb-hover, linear-gradient(180deg, #24507a 0%, #3970a0 100%));
}

.dashboard-bdfg-process-chip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 10px;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--process-chip-border);
    border-radius: 12px;
    background: var(--process-chip-bg);
    color: var(--process-chip-text);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), var(--process-chip-shadow);
    cursor: grab;
    user-select: none;
    transition: border-color .18s ease, background-color .18s ease, box-shadow .18s ease, transform .18s ease, opacity .18s ease;
}

.dashboard-bdfg-process-chip:hover,
.dashboard-bdfg-process-chip:focus-visible {
    border-color: var(--process-chip-border-hover);
    background: var(--process-chip-bg);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 14px 28px color-mix(in srgb, var(--app-primary) 24%, transparent);
    transform: translateY(-1px);
    outline: none;
}

.dashboard-bdfg-process-chip.is-dragging {
    opacity: 0.58;
}

.dashboard-bdfg-process-chip.is-existing {
    cursor: default;
    border-color: var(--process-chip-border);
    background: var(--process-chip-bg);
    color: var(--process-chip-text);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), var(--process-chip-shadow);
}

.dashboard-bdfg-process-chip.is-existing:hover,
.dashboard-bdfg-process-chip.is-existing:focus-visible {
    border-color: var(--process-chip-border-hover);
    background: var(--process-chip-bg);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 14px 28px color-mix(in srgb, var(--app-primary) 24%, transparent);
    transform: translateY(-1px);
}

.dashboard-bdfg-process-chip-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
    color: var(--process-chip-text);
}

.dashboard-bdfg-process-chip.is-existing .dashboard-bdfg-process-chip-label {
    color: var(--process-chip-existing-text);
}

.dashboard-bdfg-process-chip-drag {
    color: var(--process-chip-accent);
    font-size: 11px;
    text-align: right;
}

.dashboard-bdfg-process-chip.is-existing .dashboard-bdfg-process-chip-drag {
    color: var(--process-chip-existing-accent);
}

.dashboard-bdfg-process-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 92px;
    border: 1px dashed var(--process-empty-border);
    border-radius: 14px;
    background: var(--process-empty-bg);
    color: var(--process-empty-text);
    font-size: 13px;
    text-align: center;
}

.dashboard-bdfg-section {
    display: grid;
    gap: 10px;
}

.dashboard-bdfg-section-title {
    color: var(--app-text-muted);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.dashboard-bdfg-action-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.dashboard-bdfg-action {
    position: relative;
    display: grid;
    gap: 6px;
    min-height: 74px;
    padding: 14px;
    border: 1px solid var(--app-border);
    border-radius: 18px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--app-surface) 98%, #ffffff) 0%, var(--app-surface-soft) 100%);
    color: var(--app-text);
    text-align: left;
    cursor: pointer;
    transition: border-color .18s ease, background-color .18s ease, transform .18s ease, box-shadow .18s ease;
}

.dashboard-bdfg-action:hover,
.dashboard-bdfg-action:focus-visible {
    border-color: color-mix(in srgb, var(--app-primary) 42%, var(--app-border));
    box-shadow: var(--app-shadow-sm);
    transform: translateY(-1px);
    outline: none;
}

.dashboard-bdfg-close:hover,
.dashboard-bdfg-close:focus-visible {
    color: var(--app-primary);
    box-shadow: none;
    transform: none;
    outline: none;
}

.dashboard-bdfg-action strong {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
}

.dashboard-bdfg-action span {
    color: var(--app-text-muted);
    font-size: 12px;
    line-height: 1.4;
}

.dashboard-bdfg-action-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(220, 38, 38, 0.12);
    color: #dc2626;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
}

.dashboard-bdfg-search {
    width: 100%;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--app-border);
    border-radius: 14px;
    background: var(--app-surface);
    color: var(--app-text);
    font: inherit;
}

.dashboard-bdfg-search:focus {
    outline: none;
    border-color: var(--app-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--app-primary) 14%, transparent);
}

.dashboard-bdfg-list {
    display: grid;
    gap: 10px;
}

.dashboard-bdfg-chat {
    display: grid;
    grid-template-columns: minmax(168px, .75fr) minmax(250px, 1.25fr);
    gap: 10px;
    min-height: 360px;
}

.dashboard-bdfg-chat-list,
.dashboard-bdfg-chat-room,
.dashboard-bdfg-chat-messages {
    min-width: 0;
}

.dashboard-bdfg-chat-list {
    display: grid;
    align-content: start;
    gap: 8px;
    max-height: 440px;
    overflow: auto;
}

.dashboard-bdfg-chat-thread {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 8px 10px;
    border: 1px solid var(--app-border);
    border-radius: 14px;
    background: var(--app-surface);
    color: var(--app-text);
    text-align: left;
    cursor: pointer;
}

.dashboard-bdfg-chat-thread.is-selected,
.dashboard-bdfg-chat-thread:hover,
.dashboard-bdfg-chat-thread:focus-visible {
    border-color: color-mix(in srgb, var(--app-primary) 42%, var(--app-border));
    background: color-mix(in srgb, var(--app-primary) 8%, var(--app-surface));
    outline: none;
}

.dashboard-bdfg-chat-avatar {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--app-primary) 14%, var(--app-surface-soft));
    color: var(--app-primary-strong);
    font-size: 12px;
    font-weight: 800;
    flex: 0 0 auto;
}

.dashboard-bdfg-chat-thread-copy,
.dashboard-bdfg-chat-room-head span {
    display: grid;
    gap: 2px;
    min-width: 0;
}

.dashboard-bdfg-chat-thread-copy strong,
.dashboard-bdfg-chat-room-head strong {
    color: var(--app-text);
    font-size: 12px;
    font-weight: 800;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dashboard-bdfg-chat-thread-copy em,
.dashboard-bdfg-chat-room-head em {
    color: var(--app-text-muted);
    font-size: 11px;
    font-style: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dashboard-bdfg-chat-room {
    display: grid;
    grid-template-rows: auto minmax(210px, 1fr) auto auto;
    gap: 8px;
}

.dashboard-bdfg-chat-room-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1px solid var(--app-border);
    border-radius: 14px;
    background: var(--app-surface);
}

.dashboard-bdfg-chat-messages {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 10px;
    border: 1px solid var(--app-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--app-surface-soft) 84%, var(--app-surface));
    overflow: auto;
}

.dashboard-bdfg-chat-message {
    max-width: 86%;
    display: grid;
    gap: 3px;
    align-self: flex-start;
    padding: 8px 10px;
    border-radius: 12px 12px 12px 4px;
    background: var(--app-surface);
    color: var(--app-text);
    border: 1px solid color-mix(in srgb, var(--app-border) 80%, transparent);
}

.dashboard-bdfg-chat-message.is-own {
    align-self: flex-end;
    border-radius: 12px 12px 4px 12px;
    background: color-mix(in srgb, var(--app-primary) 14%, var(--app-surface));
}

.dashboard-bdfg-chat-message strong {
    font-size: 11px;
    color: var(--app-text-soft);
}

.dashboard-bdfg-chat-message span {
    font-size: 12px;
    line-height: 1.35;
    color: var(--app-text);
}

.dashboard-bdfg-chat-message em {
    font-size: 10px;
    font-style: normal;
    color: var(--app-text-muted);
    text-align: right;
}

.dashboard-bdfg-chat-compose {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
}

.dashboard-bdfg-chat-input {
    min-width: 0;
    height: 34px;
    padding: 0 12px;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    background: var(--app-surface);
    color: var(--app-text);
    font: inherit;
    font-size: 12px;
}

.dashboard-bdfg-chat-send {
    height: 34px;
    padding: 0 12px;
    border: 1px solid color-mix(in srgb, var(--app-primary) 42%, var(--app-border));
    border-radius: 999px;
    background: var(--app-primary);
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
}

.notification-chat-window {
    --color-background-primary: var(--app-surface);
    --color-background-secondary: var(--app-surface-soft);
    --color-background-info: var(--app-primary-soft);
    --color-text-primary: var(--app-text);
    --color-text-secondary: var(--app-text-soft);
    --color-text-tertiary: var(--app-text-muted);
    --color-text-info: var(--app-primary-strong);
    --color-border-secondary: var(--app-border);
    --color-border-tertiary: color-mix(in srgb, var(--app-border) 70%, transparent);
    --color-border-info: color-mix(in srgb, var(--app-primary) 44%, var(--app-border));
    --border-radius-md: 8px;
    --border-radius-lg: 14px;
    position: fixed;
    z-index: 2200;
    width: min(920px, calc(100vw - 32px));
    height: min(690px, calc(100vh - 42px));
    border: 1px solid var(--app-border);
    border-radius: 16px;
    background: var(--app-surface);
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.24);
    overflow: hidden;
}

.notification-chat-window.is-embedded {
    position: relative;
    z-index: auto;
    width: calc(100% - 28px);
    height: calc(100% - 28px);
    margin: 14px;
    min-height: 0;
    box-shadow: none;
}

.notification-chat-window[hidden] {
    display: none;
}

.notification-chat-window.is-minimized {
    width: 260px;
    height: 38px;
}

.notification-chat-window.is-minimized .notification-chat-body {
    display: none;
}

.notification-chat-dragbar {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid var(--color-border-tertiary);
    background: color-mix(in srgb, var(--app-surface) 94%, var(--app-primary-soft));
    cursor: move;
    user-select: none;
}

.notification-chat-window.is-embedded .notification-chat-dragbar {
    cursor: default;
}

.notification-chat-dragbar strong {
    font-size: 13px;
    font-weight: 700;
    color: var(--app-text);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
}

.notification-chat-dragbar strong span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.notification-chat-window-actions {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.notification-chat-window-actions:empty {
    display: none;
}

.notification-chat-open-center,
.notification-chat-close {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--app-text-muted);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
}

.notification-chat-open-center {
    font-size: 0;
    width: max(28px, calc(var(--nc-icon-size, 16px) + 10px));
    height: max(28px, calc(var(--nc-icon-size, 16px) + 10px));
    border-radius: 0;
    background: transparent;
    color: var(--nc-icon-color, var(--app-text-muted));
    transition: color 0.16s ease, filter 0.16s ease, transform 0.16s ease;
}

.notification-chat-open-center:hover,
.notification-chat-open-center:focus-visible {
    --nc-icon-color: var(--nc-icon-hover-color, var(--app-primary));
    filter: drop-shadow(0 6px 12px rgba(11, 129, 184, 0.18));
    outline: none;
    transform: scale(1.08);
}

.notification-chat-open-center .nc-config-icon {
    display: inline-flex;
}

.nc-config-icon {
    display: inline-block;
    line-height: 1;
    flex-shrink: 0;
}

.nc-config-icon.icon-svg-mask {
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    -webkit-mask-size: contain;
}

.notification-chat-close:hover,
.notification-chat-close:focus-visible {
    background: var(--app-surface-soft);
    color: var(--app-text);
    outline: none;
}

.notification-chat-body {
    height: calc(100% - 38px);
}

.notification-chat-window .nc {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    height: 100%;
    background: var(--color-background-primary);
    overflow: hidden;
}

.notification-chat-window .nc-left {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    border-right: 1px solid var(--color-border-tertiary);
    min-height: 0;
}

.notification-chat-window .nc-left-head {
    padding: 14px 14px 10px;
    border-bottom: 1px solid var(--color-border-tertiary);
    display: flex;
    align-items: center;
    gap: 8px;
}

.notification-chat-window .nc-left-head h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-primary);
    flex: 0 0 auto;
}

.notification-chat-window .nc-search-wrap {
    position: relative;
    flex: 1;
}

.notification-chat-window .nc-search-wrap i {
    position: absolute;
    left: 9px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    color: var(--color-text-tertiary);
    pointer-events: none;
}

.notification-chat-window .nc-search-inp {
    width: 100%;
    border: 1px solid var(--color-border-secondary);
    border-radius: 999px;
    background: var(--color-background-secondary);
    color: var(--color-text-primary);
    font-size: 12px;
    padding: 6px 10px 6px 28px;
    outline: none;
}

.notification-chat-window .nc-contact-list {
    overflow-y: auto;
    padding: 6px 0;
}

.notification-chat-window .nc-contact-block {
    border-bottom: 1px solid var(--color-border-tertiary);
}

.notification-chat-window .nc-contact-row,
.notification-chat-window .nc-doc-item {
    width: 100%;
    border: 0;
    font: inherit;
    text-align: left;
}

.notification-chat-window .nc-contact-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    cursor: pointer;
    background: transparent;
}

.notification-chat-window .nc-contact-row:hover,
.notification-chat-window .nc-contact-row.active-contact {
    background: var(--color-background-secondary);
}

.notification-chat-window .nc-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex: 0 0 auto;
}

.notification-chat-window .nc-contact-info,
.notification-chat-window .nc-doc-body,
.notification-chat-window .nc-chat-head-info {
    display: grid;
    min-width: 0;
    flex: 1 1 auto;
}

.notification-chat-window .nc-contact-name,
.notification-chat-window .nc-doc-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
}

.notification-chat-window .nc-contact-meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    min-width: max-content;
}

.notification-chat-window .nc-contact-name span:first-child,
.notification-chat-window .nc-doc-label span:first-child,
.notification-chat-window .nc-contact-preview,
.notification-chat-window .nc-doc-preview {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.notification-chat-window .nc-contact-time,
.notification-chat-window .nc-contact-preview,
.notification-chat-window .nc-doc-preview {
    font-size: 11px;
    color: var(--color-text-tertiary);
}

.notification-chat-window .nc-badge,
.notification-chat-window .nc-doc-unread {
    background: #dc2626;
    color: #fff;
    font-size: 9px;
    font-weight: 500;
    min-width: 15px;
    height: 15px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    flex-shrink: 0;
    line-height: 1;
}

.notification-chat-window .nc-badge.is-dot,
.notification-chat-window .nc-doc-unread.is-dot {
    min-width: 7px;
    width: 7px;
    height: 7px;
    padding: 0;
}

.notification-chat-window .nc-chevron {
    font-size: 14px;
    color: var(--color-text-tertiary);
    transition: transform 0.2s;
    flex-shrink: 0;
}

.notification-chat-window .nc-chevron.open {
    transform: rotate(180deg);
}

.notification-chat-window .nc-doc-list {
    display: grid;
    background: var(--color-background-secondary);
    border-top: 1px solid var(--color-border-tertiary);
}

.notification-chat-window .nc-doc-swipe {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-tertiary);
}

.notification-chat-window .nc-doc-swipe-actions {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 14px;
    background: var(--color-background-secondary);
}

.notification-chat-window .nc-doc-delete-btn {
    width: 30px;
    height: 30px;
    border: 0;
    background: transparent;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.notification-chat-window .nc-doc-delete-btn:hover,
.notification-chat-window .nc-doc-delete-btn:focus-visible {
    color: var(--color-text-primary);
    outline: none;
}

.notification-chat-window .nc-doc-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px 8px 22px;
    cursor: pointer;
    background: var(--color-background-secondary);
    position: relative;
    z-index: 1;
    transition: transform 0.18s ease, background 0.18s ease;
    touch-action: pan-y;
}

.notification-chat-window .nc-doc-item.is-swiping {
    transition: none;
    cursor: grabbing;
}

.notification-chat-window .nc-doc-item:hover,
.notification-chat-window .nc-doc-item.active-doc {
    background: var(--color-background-primary);
}

.notification-chat-window .nc-doc-item.active-doc {
    border-right: 2px solid var(--color-border-info);
}

.notification-chat-window .nc-doc-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--border-radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    flex-shrink: 0;
}

.notification-chat-window .nc-doc-icon.cot {
    background: #E6F1FB;
    color: #0C447C;
}

.notification-chat-window .nc-doc-icon.prod {
    background: #E1F5EE;
    color: #085041;
}

.notification-chat-window .nc-doc-icon.gen {
    background: var(--color-background-primary);
    color: var(--color-text-tertiary);
    border: 1px solid var(--color-border-secondary);
}

.notification-chat-window .nc-right {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    min-height: 0;
}

.notification-chat-window .nc-chat-head {
    padding: 13px 18px 11px;
    border-bottom: 1px solid var(--color-border-tertiary);
    display: flex;
    align-items: center;
    gap: 10px;
}

.notification-chat-window .nc-chat-head-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-primary);
}

.notification-chat-window .nc-chat-head-sub {
    font-size: 11px;
    color: var(--color-text-secondary);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.notification-chat-window .nc-chat-head-doc {
    display: grid;
    gap: 1px;
    margin-top: 4px;
}

.notification-chat-window .nc-chat-head-doc-line {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 5px;
}

.notification-chat-window .nc-chat-head-doc strong,
.notification-chat-window .nc-chat-head-doc em,
.notification-chat-window .nc-chat-head-code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.notification-chat-window .nc-chat-head-code,
.notification-chat-window .nc-chat-head-dot {
    flex: 0 0 auto;
    font-size: 11px;
    color: var(--color-text-secondary);
}

.notification-chat-window .nc-chat-head-doc strong {
    min-width: 0;
    font-size: 12px;
    color: var(--color-text-primary);
}

.notification-chat-window .nc-chat-head-doc em {
    font-style: normal;
    font-size: 11px;
    color: var(--color-text-secondary);
}

.notification-chat-window .nc-chat-head-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
    margin-left: auto;
}

.notification-chat-window .nc-action-btn,
.notification-chat-window .nc-archive-btn {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: var(--border-radius-md);
    border: 1px solid var(--color-border-secondary);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
}

.notification-chat-window .nc-action-btn.primary {
    background: var(--color-background-info);
    color: var(--color-text-info);
    border-color: var(--color-border-info);
}

.notification-chat-window .nc-ctx {
    display: grid;
    gap: 6px;
    padding: 9px 18px;
    border-bottom: 1px solid var(--color-border-tertiary);
    background: var(--color-background-secondary);
}

.notification-chat-window .nc-ctx[hidden] {
    display: none;
}

.notification-chat-window .nc-context-row {
    width: 100%;
    border: 1px solid var(--color-border-tertiary);
    border-radius: var(--border-radius-md);
    background: var(--color-background-primary);
    color: var(--color-text-secondary);
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    text-align: left;
    font: inherit;
}

.notification-chat-window .nc-context-row.clickable {
    cursor: pointer;
    color: var(--color-text-info);
    border-color: var(--color-border-info);
}

.notification-chat-window .nc-context-row span {
    display: grid;
    gap: 1px;
    min-width: 0;
}

.notification-chat-window .nc-context-row strong {
    font-size: 10px;
    font-weight: 700;
    color: var(--color-text-tertiary);
}

.notification-chat-window .nc-context-row em {
    font-style: normal;
    font-size: 12px;
    color: var(--color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.notification-chat-window .nc-messages {
    overflow-y: auto;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.notification-chat-window .nc-msg-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.notification-chat-window .nc-msg-wrap.own {
    align-items: flex-end;
}

.notification-chat-window .nc-bubble {
    max-width: 72%;
    padding: 9px 13px;
    border-radius: 16px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-text-primary);
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-tertiary);
}

.notification-chat-window .nc-bubble.own {
    background: var(--color-background-info);
    color: var(--color-text-info);
    border-color: var(--color-border-info);
}

.notification-chat-window .nc-attachment-list,
.notification-chat-window .nc-attachment-tray {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-width: 72%;
}

.notification-chat-window .nc-msg-wrap.own .nc-attachment-list {
    justify-content: flex-end;
}

.notification-chat-window .nc-attachment-tray {
    max-width: none;
    padding: 8px 14px;
    border-top: 1px solid var(--color-border-tertiary);
    background: var(--color-background-secondary);
}

.notification-chat-window .nc-attachment-card {
    width: 142px;
    min-height: 58px;
    border: 1px solid var(--color-border-tertiary);
    border-radius: var(--border-radius-md);
    background: var(--color-background-primary);
    color: var(--color-text-primary);
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    gap: 7px;
    padding: 6px;
    text-decoration: none;
}

.notification-chat-window .nc-attachment-card img,
.notification-chat-window .nc-attachment-ext {
    width: 42px;
    height: 42px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--color-background-secondary);
}

.notification-chat-window .nc-attachment-ext {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-info);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
}

.notification-chat-window .nc-attachment-card span:last-child {
    display: grid;
    gap: 2px;
    min-width: 0;
}

.notification-chat-window .nc-attachment-card strong,
.notification-chat-window .nc-attachment-card em {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.notification-chat-window .nc-attachment-card strong {
    font-size: 11px;
}

.notification-chat-window .nc-attachment-card em {
    color: var(--color-text-tertiary);
    font-size: 10px;
    font-style: normal;
}

.notification-chat-window .nc-attachment-remove {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    border: 1px solid var(--color-border-secondary);
    background: var(--color-background-primary);
    color: var(--color-text-secondary);
    cursor: pointer;
    margin-left: -14px;
}

.notification-chat-window .nc-compose-status {
    min-height: 24px;
    padding: 5px 16px;
    border-top: 1px solid var(--color-border-tertiary);
    color: var(--color-text-secondary);
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 7px;
}

.notification-chat-window .nc-compose-status.error {
    color: #b42318;
}

.notification-chat-window .nc-spinner {
    width: 13px;
    height: 13px;
    border: 2px solid color-mix(in srgb, var(--color-text-secondary) 28%, transparent);
    border-top-color: var(--color-text-info);
    border-radius: 50%;
    display: inline-flex;
    flex: 0 0 auto;
    animation: nc-spin 0.8s linear infinite;
}

@keyframes nc-spin {
    to {
        transform: rotate(360deg);
    }
}

.notification-chat-window .nc-msg-meta {
    font-size: 10px;
    color: var(--color-text-tertiary);
    display: flex;
    align-items: center;
    gap: 4px;
}

.notification-chat-window .nc-compose {
    border-top: 1px solid var(--color-border-tertiary);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.notification-chat-window .nc-compose-inp {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-border-secondary);
    border-radius: 999px;
    background: var(--color-background-secondary);
    color: var(--color-text-primary);
    font-size: 13px;
    padding: 8px 16px;
    outline: none;
}

.notification-chat-window .nc-icon-btn,
.notification-chat-window .nc-send-btn {
    width: max(34px, calc(var(--nc-icon-size, 16px) + 12px));
    height: max(34px, calc(var(--nc-icon-size, 16px) + 12px));
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--nc-icon-color, var(--color-text-secondary));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: var(--nc-icon-size, 16px);
    flex-shrink: 0;
    transition: color 0.16s ease, filter 0.16s ease, transform 0.16s ease;
}

.notification-chat-window .nc-icon-btn:hover:not(:disabled),
.notification-chat-window .nc-send-btn:hover:not(:disabled),
.notification-chat-window .nc-icon-btn:focus-visible:not(:disabled),
.notification-chat-window .nc-send-btn:focus-visible:not(:disabled) {
    --nc-icon-color: var(--nc-icon-hover-color, var(--color-text-info));
    background: transparent;
    filter: drop-shadow(0 6px 12px rgba(11, 129, 184, 0.18));
    outline: none;
    transform: scale(1.08);
}

.notification-chat-window .nc-icon-btn:disabled,
.notification-chat-window .nc-send-btn:disabled,
.notification-chat-window .nc-compose-inp:disabled {
    opacity: 0.62;
    cursor: wait;
}

.notification-chat-window .nc-empty {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--color-text-tertiary);
    padding: 20px;
    text-align: center;
}

.notification-chat-window .nc-empty i {
    font-size: 34px;
}

.notification-chat-window .nc-empty p {
    font-size: 13px;
}

.dashboard-bdfg-item,
.dashboard-bdfg-thread {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border: 1px solid var(--app-border);
    border-radius: 16px;
    background: var(--app-surface);
}

.dashboard-bdfg-item-head,
.dashboard-bdfg-thread-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

.dashboard-bdfg-item strong,
.dashboard-bdfg-thread strong {
    color: var(--app-text);
    font-size: 13px;
    font-weight: 700;
}

.dashboard-bdfg-item span,
.dashboard-bdfg-thread span,
.dashboard-bdfg-thread em,
.dashboard-bdfg-empty {
    color: var(--app-text-muted);
    font-size: 12px;
    line-height: 1.45;
}

.dashboard-bdfg-item-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
}

.dashboard-bdfg-inline-btn {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    background: var(--app-surface-soft);
    color: var(--app-text-soft);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}

.dashboard-bdfg-inline-btn:hover,
.dashboard-bdfg-inline-btn:focus-visible {
    border-color: color-mix(in srgb, var(--app-primary) 42%, var(--app-border));
    color: var(--app-primary-strong);
    outline: none;
}

.dashboard-bdfg-item-remove {
    color: #b91c1c;
}

html[data-theme="dark"] .floating-action-button,
html[data-theme="dark"] .dashboard-bdfg-close,
html[data-theme="dark"] .dashboard-bdfg-inline-btn {
    background: color-mix(in srgb, var(--app-surface) 88%, var(--app-primary-soft));
    color: var(--app-primary);
    border-color: color-mix(in srgb, var(--app-primary) 28%, var(--app-border));
}

html[data-theme="dark"] .dashboard-bdfg-close {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
}

html[data-theme="dark"] .floating-action-button:hover,
html[data-theme="dark"] .floating-action-button:focus-visible,
html[data-theme="dark"] .dashboard-bdfg-inline-btn:hover,
html[data-theme="dark"] .dashboard-bdfg-inline-btn:focus-visible {
    background: color-mix(in srgb, var(--app-surface) 78%, var(--app-primary-soft));
}

html[data-theme="dark"] .dashboard-bdfg-close:hover,
html[data-theme="dark"] .dashboard-bdfg-close:focus-visible {
    color: #8fdcff;
    border-color: transparent;
    box-shadow: none;
    transform: none;
}

html[data-theme="dark"] .dashboard-bdfg-bridge,
html[data-theme="dark"] .dashboard-bdfg-item,
html[data-theme="dark"] .dashboard-bdfg-thread,
html[data-theme="dark"] .dashboard-bdfg-chat-thread,
html[data-theme="dark"] .dashboard-bdfg-chat-room-head,
html[data-theme="dark"] .dashboard-bdfg-chat-message,
html[data-theme="dark"] .dashboard-bdfg-chat-input,
html[data-theme="dark"] .notification-chat-window,
html[data-theme="dark"] .dashboard-bdfg-action,
html[data-theme="dark"] .dashboard-bdfg-search {
    background: #111c30;
    color: var(--app-text);
    border-color: var(--app-border);
    box-shadow: var(--app-shadow);
}

html[data-theme="dark"] .notification-chat-window {
    --color-background-primary: #111c30;
    --color-background-secondary: #0d1728;
    --color-background-info: rgba(14, 165, 233, 0.18);
    --color-text-info: #8fdcff;
    --color-border-info: #245f84;
}

html[data-theme="dark"] .dashboard-bdfg-process-tabs {
    background: var(--process-shell-bg);
    border-color: var(--process-shell-border);
}

html[data-theme="dark"] .dashboard-bdfg-process-tray {
    --process-shell-bg: linear-gradient(180deg, color-mix(in srgb, #122033 92%, var(--app-surface)) 0%, color-mix(in srgb, #0f1a2a 96%, var(--app-surface-soft)) 100%);
    --process-shell-border: color-mix(in srgb, var(--app-border) 82%, #244766);
    --process-tab-text: #9eb3c8;
    --process-tab-hover-bg: color-mix(in srgb, var(--app-primary-soft) 72%, transparent);
    --process-tab-hover-text: #d9ecfb;
    --process-tab-active-bg: linear-gradient(135deg, #0ea5e9, #22d3ee);
    --process-tab-active-text: #ffffff;
    --process-tab-active-shadow: 0 12px 24px rgba(14, 165, 233, 0.22);
    --process-scroll-track: #0b1322;
    --process-scroll-thumb: linear-gradient(180deg, #203c59 0%, #2a4f75 100%);
    --process-scroll-thumb-hover: linear-gradient(180deg, #2b537d 0%, #376794 100%);
    --process-chip-bg: linear-gradient(180deg, #17547b 0%, #123e5b 100%);
    --process-chip-border: #226a98;
    --process-chip-border-hover: #7fd9ff;
    --process-chip-text: #f7fbff;
    --process-chip-accent: rgba(255,255,255,0.9);
    --process-empty-bg: linear-gradient(180deg, #121e31 0%, #0f1826 100%);
    --process-empty-border: #2c4e6b;
    --process-empty-text: #8fa7bd;
}

@media (max-width: 860px) {
    .dashboard-bdfg-shell {
        top: auto;
        bottom: 18px;
        left: 14px;
    }

    .dashboard-bdfg-bridge,
    .dashboard-bdfg-menu-left .dashboard-bdfg-bridge {
        top: auto;
        bottom: calc(100% + 12px);
        left: 0;
        right: auto;
        width: min(360px, calc(100vw - 28px));
        border-radius: 22px;
        border-color: var(--app-border);
    }

    .dashboard-bdfg-chat {
        grid-template-columns: 1fr;
    }

    .dashboard-bdfg-chat-list {
        grid-auto-flow: column;
        grid-auto-columns: minmax(176px, 1fr);
        overflow-x: auto;
        overflow-y: hidden;
    }

    .dashboard-bdfg-action-grid {
        grid-template-columns: 1fr;
    }

    .notification-chat-window {
        width: min(94vw, 720px);
        height: min(78vh, 640px);
        left: 3vw !important;
        right: auto !important;
    }

    .notification-chat-window .nc {
        grid-template-columns: 1fr;
    }

    .notification-chat-window .nc-left {
        max-height: 220px;
        border-right: 0;
        border-bottom: 1px solid var(--color-border-tertiary);
    }
}

.costs-shell {
    max-width: 880px;
    margin: 0 auto;
    padding-top: 18px;
    position: relative;
}

.costs-card {
    display: grid;
    gap: 18px;
    max-width: 1020px;
    margin: 0 auto;
    position: relative;
}

.costs-tabs {
    display: flex;
    gap: 6px;
    padding: 4px;
    width: min(100%, 940px);
    margin: 0 auto;
    border: 1px solid #d8e2ea;
    border-radius: 14px;
    background: linear-gradient(180deg, #f7fafc 0%, #eef4f8 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.75);
}

.costs-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: 40px;
    padding: 10px 18px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: #60707f;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.costs-tab:hover,
.costs-tab:focus-visible {
    background: rgba(11,129,184,0.08);
    color: #23516a;
}

.costs-tab.is-active {
    background: linear-gradient(180deg, #24a8df 0%, #118fc6 100%);
    color: #fff;
    box-shadow: 0 8px 18px rgba(17,143,198,0.24);
}

.costs-tab.is-active:hover,
.costs-tab.is-active:focus-visible {
    background: linear-gradient(180deg, #24a8df 0%, #118fc6 100%);
    color: #eaf8ff;
    box-shadow: 0 8px 18px rgba(17,143,198,0.24);
}

.costs-panel {
    display: none;
    gap: 16px;
}

.costs-panel.is-active {
    display: grid;
    gap: 18px;
}

.costs-panel-frame {
    display: grid;
    gap: 18px;
    padding: 4px;
    border: 0;
    border-radius: 22px;
    background: transparent;
    box-shadow: none;
}

.costs-section-card {
    display: grid;
    gap: 14px;
    padding: 18px;
    border: 1px solid #d8e2ea;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(19, 39, 54, 0.05);
}

.costs-section-card-plain {
    border: 0;
    box-shadow: none;
    padding: 8px 0 0;
    background: transparent;
}

.costs-defaults-card-plain {
    background: transparent;
}

.costs-general-layout,
.costs-conventional-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
    gap: 18px;
    align-items: start;
}

.costs-general-left,
.costs-general-right,
.costs-conventional-left,
.costs-conventional-right {
    display: grid;
    gap: 18px;
    min-width: 0;
    align-content: start;
}

.costs-ink-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.costs-ink-grid label {
    display: grid;
    gap: 8px;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

.costs-ink-grid span {
