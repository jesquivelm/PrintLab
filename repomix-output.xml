    { code: 'JPY', name: 'Yen japones', symbol: 'JPY', flag: 'JP' },
    { code: 'CNY', name: 'Yuan chino', symbol: 'CNY', flag: 'CN' },
    { code: 'CHF', name: 'Franco suizo', symbol: 'CHF', flag: 'CH' },
    { code: 'BRL', name: 'Real brasileno', symbol: 'R$', flag: 'BR' },
