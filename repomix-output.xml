.flexo-comment-trigger {
    position: absolute;
    right: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    min-width: 18px;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: #7b8a97;
    cursor: pointer;
    flex: 0 0 18px;
    align-self: flex-start;
    vertical-align: middle;
    transition: color 0.15s ease, transform 0.15s ease, opacity 0.15s ease;
    opacity: 0.92;
}
.flexo-comment-trigger:hover,
.flexo-comment-trigger:focus-visible,
.flexo-comment-trigger[aria-expanded="true"] {
    background: transparent;
    color: #0b81b8;
    outline: none;
    opacity: 1;
    transform: translateY(-1px);
}
.flexo-comment-trigger .table-icon-media,
.flexo-comment-trigger .icon-image,
.flexo-comment-trigger .icon-svg-mask,
.flexo-comment-trigger .icon-glyph {
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
}
.flexo-comment-popover {
    position: fixed; /* 🔥 CLAVE */
    z-index: 9999;

    width: 280px;
    max-width: calc(100vw - 20px);

    background: #ffffff;
    border-radius: 14px;
    padding: 14px;

    border: 1px solid #ddd;
    box-shadow: 0 12px 30px rgba(0,0,0,0.15);

    font-size: 13px;
    color: #2f3740;
}

.flexo-comment-popover::after {
    content: "";
    position: absolute;
    right: 14px;
    bottom: -6px;
    width: 10px;
    height: 10px;
    background: #fff;
    border-right: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
    transform: rotate(45deg);
}

.flexo-comment-popover[hidden] {
    display: none;
}
.flexo-comment-popover-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}
.flexo-comment-popover-title {
    font-size: 12px;
    line-height: 1.35;
    font-weight: 700;
    color: #17354a;
}
.flexo-comment-popover-close {
    width: 28px;
    height: 28px;
    border: 1px solid #ddd;
    border-radius: 9px;
    background: #f5f7fa;
    color: #555;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    flex: 0 0 28px;
    transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
}
.flexo-comment-popover-close:hover,
.flexo-comment-popover-close:focus-visible {
    background: #e7ebf0;
    color: #222;
    border-color: #bdbdbd;
    outline: none;
}
.flexo-comment-popover-body {
    font-size: 12px;
    line-height: 1.6;
    color: #516271;
    white-space: normal;
    max-height: min(220px, calc(100vh - 120px));
    overflow: auto;
