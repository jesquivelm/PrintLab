        function renderNotificationCenterThreadDetail() {
            const thread = selectedNotificationThreadDetail;
            if (!notificationCenterThreadShell || !notificationCenterThreadEmpty || !notificationCenterMessagesList) return;
            if (!thread) {
                notificationCenterThreadShell.hidden = true;
                notificationCenterThreadEmpty.hidden = false;
                notificationCenterMessagesList.innerHTML = '';
                if (notificationCenterThreadTitle) notificationCenterThreadTitle.textContent = 'Sin conversación seleccionada';
                if (notificationCenterThreadSubtitle) notificationCenterThreadSubtitle.textContent = '';
                if (notificationCenterThreadMeta) notificationCenterThreadMeta.innerHTML = '';
                if (notificationCenterParticipantsRow) notificationCenterParticipantsRow.innerHTML = '';
                return;
            }
            notificationCenterThreadShell.hidden = false;
            notificationCenterThreadEmpty.hidden = true;
            if (notificationCenterThreadTitle) notificationCenterThreadTitle.textContent = thread.productName || thread.documentCode || thread.threadCode || 'Conversación';
            if (notificationCenterThreadSubtitle) {
                notificationCenterThreadSubtitle.textContent = [thread.quoteCode || thread.documentCode, thread.lineCode, thread.customerName].filter(Boolean).join(' · ');
            }
            if (notificationCenterThreadMeta) {
                notificationCenterThreadMeta.innerHTML = [
                    `<span class="sap-security-pill">${escapeHtml(thread.status || 'abierta')}</span>`,
                    `<span class="sap-security-pill">${escapeHtml(`${thread.messageCount || 0} mensajes`)}</span>`,
                    `<span class="sap-security-pill">${escapeHtml(`${thread.attachmentCount || 0} adjuntos`)}</span>`,
                    `<span class="sap-security-pill">${escapeHtml(`Último movimiento: ${formatNotificationCenterDate(thread.lastMessageAt || thread.updatedAt || thread.createdAt)}`)}</span>`
                ].join('');
            }
            if (notificationCenterParticipantsRow) {
                const participants = Array.isArray(thread.participants) ? thread.participants : [];
                notificationCenterParticipantsRow.innerHTML = participants.length
                    ? participants.map((participant) => `<span class="sap-security-pill">${escapeHtml(participant.displayName || 'Participante')} · ${escapeHtml(participant.roleKey || 'participante')}</span>`).join('')
                    : '<span class="sap-security-pill">Sin participantes registrados</span>';
            }
            if (!selectedNotificationThreadMessages.length) {
                notificationCenterMessagesList.innerHTML = '<div class="sap-security-empty">Esta conversación todavía no tiene mensajes registrados.</div>';
                return;
            }
            notificationCenterMessagesList.innerHTML = selectedNotificationThreadMessages.map((message) => {
                const currentUserId = Number(currentAdminProfile?.id || 0);
                const isOwn = currentUserId > 0 && Number(message.senderUserId || 0) === currentUserId;
                const attachments = Array.isArray(message.attachments) ? message.attachments : [];
                return `
                    <article class="notification-center-message${isOwn ? ' is-own' : ''}">
                        <div class="notification-center-message-head">
                            <strong>${escapeHtml(message.senderName || 'Usuario')}</strong>
                            <span class="notification-center-message-time">${escapeHtml(formatNotificationCenterDate(message.sentAt || message.createdAt))}</span>
                        </div>
                        <div class="notification-center-message-body">${escapeHtml(message.bodyText || '(Sin texto)')}</div>
                        ${attachments.length ? `<div class="notification-center-attachments">${attachments.map((attachment) => `
                            <span class="notification-center-attachment">
                                ${escapeHtml(attachment.fileName || 'Adjunto')}
                                <small>${escapeHtml(formatNotificationAttachmentSize(attachment.sizeBytes))}</small>
                            </span>
                        `).join('')}</div>` : ''}
                    </article>
                `;
            }).join('');
        }

        async function loadNotificationCenterThread(threadCode, { preserveStatus = false } = {}) {
            if (!threadCode) {
                selectedNotificationThreadCode = '';
                selectedNotificationThreadDetail = null;
                selectedNotificationThreadMessages = [];
                renderNotificationCenterThreadDetail();
                return;
            }
            if (!preserveStatus) setNotificationCenterStatus('Cargando conversación...', false);
            const [detailResponse, messagesResponse] = await Promise.all([
                fetch(`/api/notification-center/threads/${encodeURIComponent(threadCode)}`),
                fetch(`/api/notification-center/threads/${encodeURIComponent(threadCode)}/messages`)
            ]);
            const detailPayload = await detailResponse.json().catch(() => ({}));
            const messagesPayload = await messagesResponse.json().catch(() => ({}));
            if (!detailResponse.ok) {
                throw new Error(detailPayload.error || 'No fue posible cargar la conversación seleccionada.');
            }
            if (!messagesResponse.ok) {
                throw new Error(messagesPayload.error || 'No fue posible cargar los mensajes de la conversación.');
            }
            selectedNotificationThreadCode = threadCode;
            selectedNotificationThreadDetail = detailPayload || null;
            selectedNotificationThreadMessages = Array.isArray(messagesPayload.items) ? messagesPayload.items : [];
            renderNotificationCenterThreads(notificationCenterThreads);
            renderNotificationCenterThreadDetail();
            if (!preserveStatus) setNotificationCenterStatus('Conversación cargada correctamente.', false);
        }

        async function loadNotificationCenterThreads(force = false) {
            if (notificationCenterThreadsLoadedOnce && !force) {
                renderNotificationCenterThreads(notificationCenterThreads);
                if (selectedNotificationThreadCode) {
                    await loadNotificationCenterThread(selectedNotificationThreadCode, { preserveStatus: true });
                }
                return;
            }
            setNotificationCenterStatus('Cargando conversaciones...', false);
            const response = await fetch('/api/notification-center/threads');
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(payload.error || 'No fue posible cargar las conversaciones.');
            }
            notificationCenterThreads = Array.isArray(payload.items) ? payload.items : [];
            notificationCenterThreadsLoadedOnce = true;
            renderNotificationCenterThreads(notificationCenterThreads);
            const activeThread = notificationCenterThreads.find((item) => item.threadCode === selectedNotificationThreadCode);
            const nextThreadCode = activeThread?.threadCode || notificationCenterThreads[0]?.threadCode || '';
            if (nextThreadCode) {
                await loadNotificationCenterThread(nextThreadCode, { preserveStatus: true });
            } else {
                selectedNotificationThreadCode = '';
                selectedNotificationThreadDetail = null;
                selectedNotificationThreadMessages = [];
                renderNotificationCenterThreadDetail();
            }
            setNotificationCenterStatus('Conversaciones cargadas correctamente.', false);
