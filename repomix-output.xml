        function activateDesignTab(tabKey = 'datos-generales') {
            designSubtabs.forEach((tab) => {
                tab.classList.toggle('active', tab.dataset.designTab === tabKey);
            });
            designSubpanels.forEach((panel) => {
                panel.hidden = panel.id !== `tab-${tabKey}`;
            });
            if (tabKey === 'presentaciones') {
                populatePresentationFields();
                updatePreviews();
            }
            if (tabKey === 'repositorio' && !loginRepositoryLoadedOnce) {
                loadLoginRepositoryImages().catch((error) => {
                    console.error(error);
                    setConfigStatus(error.message || 'No fue posible cargar el repositorio.', true);
                });
            }
            syncConfigTabHeights();
        }

