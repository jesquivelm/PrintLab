        function formatSapTraceEntry(title, detail = '') {
            const time = new Date().toLocaleTimeString('es-CR');
            return detail
                ? `[${time}] ${title}\n${detail}`
                : `[${time}] ${title}`;
        }

        function getSapServiceLayerEntity(entity) {
            if (entity === 'business-partners') return 'BusinessPartners';
            if (entity === 'items') return 'Items';
            if (entity === 'orders') return 'Orders';
            return entity;
        }

        function buildSapServiceLayerQueryPath() {
            const entity = sapQueryEntity?.value || 'business-partners';
            const params = new URLSearchParams();
            const search = (sapQuerySearchInput?.value || '').trim();
            const filter = (sapQueryFilterInput?.value || '').trim();
            const top = (sapQueryTopInput?.value || '').trim();
            const clauses = [];
            if (top) params.set('$top', top);
            if (search) {
                const field = entity === 'business-partners'
                    ? 'CardName'
                    : entity === 'items'
                        ? 'ItemName'
                        : 'CardCode';
                clauses.push(`contains(${field},'${search.replace(/'/g, "''")}')`);
            }
            if (filter) {
                if (entity === 'business-partners') clauses.push(`CardType eq '${filter.replace(/'/g, "''")}'`);
                if (entity === 'items') clauses.push(`ItemsGroupCode eq ${filter}`);
                if (entity === 'orders') clauses.push(`DocumentStatus eq '${filter.replace(/'/g, "''")}'`);
            }
            if (clauses.length) params.set('$filter', clauses.join(' and '));
            return `/b1s/v1/${getSapServiceLayerEntity(entity)}${params.toString() ? `?${params.toString()}` : ''}`;
        }

        function renderSapQueryRequestPreview() {
            const sourceLabel = (sapQuerySource?.value || '').trim() === 'local' ? 'tablas locales' : 'servidor SAP';
            setSapResult(sapQueryRequest, {
