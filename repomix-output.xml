    display: none;
    width: var(--logo-width, 116px);
    height: auto;
    max-height: var(--logo-width, 116px);
    object-fit: contain;
    flex-shrink: 0;
}
.brand-mark {
    display: flex;
    align-items: var(--brand-vertical-align, center);
    justify-content: var(--brand-horizontal-align, center);
    width: auto;
    min-width: var(--brand-width);
    min-height: 41px;
    padding:
        var(--brand-margin-top)
        var(--brand-margin-right)
        var(--brand-margin-bottom)
        var(--brand-margin-left);
