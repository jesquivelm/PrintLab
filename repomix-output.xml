        async function loadInventoryClassificationMappings(force = false) {
            if (!force && inventoryClassificationMappingsLoadedOnce) return;
            const response = await fetch('/api/inventory-classification-mappings');
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'No fue posible cargar el mapeo de clasificación.');
            renderInventoryClassificationMappings(payload.items || []);
            inventoryClassificationMappingsLoadedOnce = true;
        }

        async function saveInventoryClassificationMapping() {
            const payload = collectInventoryClassificationPayload();
            if (!payload.sourceValue) throw new Error('Debes indicar el valor origen del campo SAP.');
            if (!payload.flexoCategory) throw new Error('Debes indicar la categoría flexográfica.');
            const url = selectedInventoryClassificationId
                ? `/api/inventory-classification-mappings/${encodeURIComponent(selectedInventoryClassificationId)}`
                : '/api/inventory-classification-mappings';
            const method = selectedInventoryClassificationId ? 'PATCH' : 'POST';
            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.error || 'No fue posible guardar el mapeo.');
            resetInventoryClassificationForm();
            inventoryClassificationMappingsLoadedOnce = false;
            await loadInventoryClassificationMappings(true);
            setInventoryClassificationStatus('Mapeo guardado correctamente.', false);
        }

        async function deleteInventoryClassificationMapping(id = '') {
            const cleanId = String(id || '').trim();
            if (!cleanId) return;
            const confirmed = window.confirm('Se eliminará este mapeo de clasificación. ¿Deseas continuar?');
            if (!confirmed) return;
            const response = await fetch(`/api/inventory-classification-mappings/${encodeURIComponent(cleanId)}`, { method: 'DELETE' });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.error || 'No fue posible eliminar el mapeo.');
            if (selectedInventoryClassificationId === cleanId) resetInventoryClassificationForm();
            inventoryClassificationMappingsLoadedOnce = false;
            await loadInventoryClassificationMappings(true);
            setInventoryClassificationStatus('Mapeo eliminado correctamente.', false);
        }

