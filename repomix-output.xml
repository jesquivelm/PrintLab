.quote-master-toggle {
    min-width: 42px !important;
    width: 42px !important;
    height: 34px !important;
    gap: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: var(--app-text-muted, #8aa0b3) !important;
