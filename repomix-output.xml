.tl-done-btn{position:relative;width:40px;height:40px;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;flex-shrink:0;cursor:default;border:none;padding:0;}
.tl-done-btn.has-photo{overflow:hidden;background:transparent !important;}
.tracking-avatar-image{width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block;}
.tracking-avatar-fallback{width:100%;height:100%;border-radius:inherit;display:flex;align-items:center;justify-content:center;color:#fff;}
.tl-done-btn.undoable{cursor:pointer;transition:filter 0.18s;}
.tl-done-btn.undoable:hover{filter:brightness(0.85);}
.tl-undo-overlay{position:absolute;inset:0;border-radius:50%;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.18s;}
.tl-done-btn.undoable:hover .tl-undo-overlay{opacity:1;}
.tl-check-badge{position:absolute;bottom:-2px;right:-3px;width:18px;height:18px;border-radius:50%;background:#16a34a;border:2.5px solid var(--color-background-primary);display:flex;align-items:center;justify-content:center;pointer-events:none;animation:pop-in 0.4s 0.18s cubic-bezier(0.34,1.56,0.64,1) both;}
.tl-warn-badge{position:absolute;bottom:-2px;right:-3px;width:18px;height:18px;border-radius:50%;background:#d97706;border:2.5px solid var(--color-background-primary);display:flex;align-items:center;justify-content:center;pointer-events:none;}
.tl-pending-btn{width:40px;height:40px;border-radius:50%;background:var(--color-background-secondary);border:1.5px dashed var(--color-border-secondary);color:var(--color-text-tertiary);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;font-family:inherit;transition:border-color 0.2s,transform 0.15s;}
.tl-pending-btn:hover{border-color:var(--color-border-primary);transform:scale(1.08);}
.tl-pending-btn:active{transform:scale(0.97);}
.tl-locked{width:40px;height:40px;border-radius:50%;background:var(--color-background-secondary);border:0.5px solid var(--color-border-secondary);color:var(--color-text-tertiary);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.tl-avatar-anim{animation:pop-in 0.35s cubic-bezier(0.34,1.56,0.64,1) both;}
.tl-content-anim{animation:fade-slide 0.3s 0.1s ease both;}
.cr-form{animation:form-in 0.22s ease both;margin-top:10px;padding:12px;background:var(--color-background-secondary);border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-secondary);}
.cr-textarea{width:100%;min-height:72px;resize:vertical;border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);padding:8px 10px;font-family:inherit;font-size:12px;background:var(--color-background-primary);color:var(--color-text-primary);box-sizing:border-box;outline:none;transition:border-color 0.15s;}
.cr-textarea:focus{border-color:var(--color-border-primary);}
.cr-textarea.error{border-color:var(--color-border-danger);}
.btn-cancel{font-size:12px;color:var(--color-text-secondary);background:transparent;border:0.5px solid var(--color-border-secondary);border-radius:999px;padding:4px 12px;cursor:pointer;font-family:inherit;}
.btn-cancel:hover{background:var(--color-background-secondary);}
.btn-submit{font-size:12px;color:var(--color-text-danger);background:var(--color-background-danger);border:0.5px solid var(--color-border-danger);border-radius:999px;padding:4px 14px;cursor:pointer;font-family:inherit;font-weight:500;display:inline-flex;align-items:center;gap:5px;}
.btn-submit:hover{opacity:0.85;}
.btn-mark{font-size:12px;color:var(--color-text-info);background:var(--color-background-info);border:0.5px solid var(--color-border-info);border-radius:999px;padding:3px 12px;cursor:pointer;font-family:inherit;font-weight:500;display:inline-flex;align-items:center;gap:5px;}
.btn-mark:hover{opacity:0.85;}
.is-tracking-loading{cursor:wait !important;opacity:1 !important;filter:saturate(1.12);animation:tracking-action-pulse 0.9s ease-in-out infinite;}
.is-tracking-loading:disabled{cursor:wait !important;}
.tracking-button-spinner{width:13px;height:13px;border-radius:50%;border:2px solid currentColor;border-right-color:transparent;display:inline-block;animation:tracking-action-spin 0.7s linear infinite;flex:0 0 13px;}
.tl-pending-btn.is-tracking-loading{border-style:solid;transform:none !important;}
.tl-pending-btn.is-tracking-loading .tracking-button-spinner{width:17px;height:17px;flex-basis:17px;}
@keyframes tracking-action-spin{to{transform:rotate(360deg);}}
@keyframes tracking-action-pulse{0%,100%{box-shadow:0 0 0 0 rgba(11,129,184,0.18);}50%{box-shadow:0 0 0 5px rgba(11,129,184,0.08);}}
.btn-changes{font-size:11px;color:var(--color-text-secondary);background:transparent;border:0.5px solid var(--color-border-secondary);border-radius:999px;padding:2px 10px;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:4px;margin-top:7px;transition:border-color 0.15s,color 0.15s;}
.btn-changes:hover{border-color:var(--color-border-warning);color:var(--color-text-warning);}
.cr-note{margin-top:10px;padding:10px 12px;background:var(--color-background-warning);border-radius:var(--border-radius-md);border-left:3px solid var(--color-border-warning);}
.tracking-close-menu{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.tracking-primary-action{color:var(--color-text-success);background:var(--color-background-success);border-color:var(--color-border-success);}
.tracking-secondary-action,.tracking-product-action{color:var(--color-text-primary);background:var(--color-background-secondary);border-color:var(--color-border-secondary);}
.tracking-close-form{animation:form-in 0.22s ease both;margin-top:10px;padding:12px;background:var(--color-background-secondary);border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);display:grid;gap:10px;}
.tracking-close-form label{display:grid;gap:5px;margin:0;}
.tracking-close-form span{font-size:11px;font-weight:500;color:var(--color-text-secondary);}
.tracking-close-form select{width:100%;border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);padding:7px 10px;font:inherit;font-size:12px;background:var(--color-background-primary);color:var(--color-text-primary);outline:none;}
.tracking-close-form select:focus{border-color:var(--color-border-primary);}
.tracking-close-form select.error{border-color:var(--color-border-danger);}
.tracking-close-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;}
.tracking-close-dialog{width:min(520px,calc(100vw - 32px));}
.tracking-close-dialog .calc-center-message-content{padding-right:0;}
.tracking-close-form-dialog{margin-top:0;background:transparent;border:0;padding:0;}
.tracking-close-dialog-head{display:grid;gap:3px;margin-bottom:2px;}
.tracking-close-dialog-head strong{font-size:14px;color:var(--color-text-primary);}
.tracking-close-note{margin-top:9px;padding:9px 11px;border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-success);background:var(--color-background-success);display:grid;gap:3px;}
.tracking-close-note strong{font-size:12px;color:var(--color-text-success);}
.tracking-close-note span{font-size:12px;color:var(--color-text-primary);line-height:1.35;}

