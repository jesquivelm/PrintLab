        function normalizePermissionAccessValue(value) {
            const empty = { view: false, create: false, edit: false };
            if (value && typeof value === 'object' && !Array.isArray(value)) {
                return {
                    view: Boolean(value.view || value.create || value.edit),
                    create: Boolean(value.create),
                    edit: Boolean(value.edit)
                };
            }
            if (Array.isArray(value)) {
                const normalizedList = value.map((item) => String(item || '').trim().toLowerCase());
                return {
                    view: normalizedList.includes('view') || normalizedList.includes('create') || normalizedList.includes('edit'),
                    create: normalizedList.includes('create'),
                    edit: normalizedList.includes('edit')
                };
            }
            const normalized = String(value || '').trim().toLowerCase();
            if (!normalized || normalized === 'none') return empty;
            if (normalized === 'view') return { view: true, create: false, edit: false };
            if (normalized === 'create') return { view: true, create: true, edit: false };
            if (normalized === 'edit') return { view: true, create: true, edit: true };
            const tokenList = normalized.split(/[,\s|/+]+/).filter(Boolean);
            return {
                view: tokenList.includes('view') || tokenList.includes('create') || tokenList.includes('edit'),
                create: tokenList.includes('create'),
                edit: tokenList.includes('edit')
            };
        }

        function createEmptyPermissionModules(source = {}) {
            const output = {};
            PERMISSION_PRESENTATION_KEYS.forEach((key) => {
                output[key] = normalizePermissionAccessValue(source?.[key]);
            });
            return output;
        }

        function syncPermissionAccessRow(key) {
            if (!permissionAdminMatrixBody || !key) return;
            const viewInput = permissionAdminMatrixBody.querySelector(`input[data-permission-key="${key}"][data-permission-flag="view"]`);
            const createInput = permissionAdminMatrixBody.querySelector(`input[data-permission-key="${key}"][data-permission-flag="create"]`);
            const editInput = permissionAdminMatrixBody.querySelector(`input[data-permission-key="${key}"][data-permission-flag="edit"]`);
            if (!viewInput || !createInput || !editInput) return;
            if ((createInput.checked || editInput.checked) && !viewInput.checked) {
                viewInput.checked = true;
            }
            [viewInput, createInput, editInput].forEach((input) => {
                input.closest('label')?.classList.toggle('is-checked', Boolean(input.checked));
            });

        }

        function applyPermissionBulkMode(mode) {
            if (!permissionAdminMatrixBody) return;
            PERMISSION_PRESENTATION_KEYS.forEach((key) => {
                const viewInput = permissionAdminMatrixBody.querySelector(`input[data-permission-key="${key}"][data-permission-flag="view"]`);
                const createInput = permissionAdminMatrixBody.querySelector(`input[data-permission-key="${key}"][data-permission-flag="create"]`);
                const editInput = permissionAdminMatrixBody.querySelector(`input[data-permission-key="${key}"][data-permission-flag="edit"]`);
                if (!viewInput || !createInput || !editInput) return;
                if (mode === 'clear') {
                    viewInput.checked = false;
                    createInput.checked = false;
                    editInput.checked = false;
                } else if (mode === 'view') {
                    viewInput.checked = true;
                    createInput.checked = false;
                    editInput.checked = false;
                } else if (mode === 'create') {
                    viewInput.checked = true;
                    createInput.checked = true;
                    editInput.checked = false;
                } else if (mode === 'edit') {
                    viewInput.checked = true;
                    createInput.checked = true;
                    editInput.checked = true;
                } else if (mode === 'full') {
                    viewInput.checked = true;
                    createInput.checked = true;
                    editInput.checked = true;
                }
                syncPermissionAccessRow(key);
            });
            queueAdminPermissionSave();
        }

