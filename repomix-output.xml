    z-index: 30;
    padding: 14px;
    background:
        linear-gradient(140deg, color-mix(in srgb, var(--mobile-surface-strong) 84%, transparent) 0%, var(--mobile-surface) 100%),
        linear-gradient(120deg, var(--mobile-accent-soft) 0%, var(--mobile-purple-soft) 56%, transparent 100%);
}

.hero-topbar {
