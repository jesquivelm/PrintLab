        let proformaPreviewPanState = null;

        function clampProformaPreviewZoom(value) {
            return Math.max(0.45, Math.min(1.1, Number(value) || 0.62));
        }

        function updateProformaPreviewZoomLabel() {
            if (!proformaPreviewZoomResetButton) return;
            proformaPreviewZoomResetButton.textContent = `${Math.round(proformaPreviewZoom * 100)}%`;
        }

        function applyProformaPreviewZoom(value, keepCenter = true) {
            if (!proformaPreviewContainer) return;
            const nextZoom = clampProformaPreviewZoom(value);
            const previousZoom = proformaPreviewZoom;
            const centerX = proformaPreviewContainer.scrollLeft + (proformaPreviewContainer.clientWidth / 2);
            const centerY = proformaPreviewContainer.scrollTop + (proformaPreviewContainer.clientHeight / 2);
            proformaPreviewZoom = nextZoom;
            proformaPreviewContainer.style.setProperty('--proforma-preview-zoom', String(nextZoom));
            updateProformaPreviewZoomLabel();
            if (keepCenter && previousZoom > 0) {
                const ratio = nextZoom / previousZoom;
                proformaPreviewContainer.scrollLeft = Math.max(0, (centerX * ratio) - (proformaPreviewContainer.clientWidth / 2));
                proformaPreviewContainer.scrollTop = Math.max(0, (centerY * ratio) - (proformaPreviewContainer.clientHeight / 2));
            }
        }

        function resetProformaPreviewViewport() {
            applyProformaPreviewZoom(0.62, false);
            if (proformaPreviewContainer) {
                proformaPreviewContainer.scrollLeft = 0;
                proformaPreviewContainer.scrollTop = 0;
            }
        }

        function bindProformaPreviewInteractions() {
            if (!proformaPreviewContainer || !proformaPreviewStage) return;
            updateProformaPreviewZoomLabel();
            proformaPreviewZoomOutButton?.addEventListener('click', () => applyProformaPreviewZoom(proformaPreviewZoom - 0.06));
            proformaPreviewZoomInButton?.addEventListener('click', () => applyProformaPreviewZoom(proformaPreviewZoom + 0.06));
            proformaPreviewZoomResetButton?.addEventListener('click', resetProformaPreviewViewport);
            proformaPreviewContainer.addEventListener('pointerdown', (event) => {
                if (event.button !== 0) return;
                if (event.target.closest('.proforma-preview-control')) return;
                proformaPreviewPanState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    scrollLeft: proformaPreviewContainer.scrollLeft,
                    scrollTop: proformaPreviewContainer.scrollTop
                };
                proformaPreviewContainer.classList.add('is-panning');
                proformaPreviewContainer.setPointerCapture?.(event.pointerId);
            });
            proformaPreviewContainer.addEventListener('pointermove', (event) => {
                if (!proformaPreviewPanState || proformaPreviewPanState.pointerId !== event.pointerId) return;
                proformaPreviewContainer.scrollLeft = proformaPreviewPanState.scrollLeft - (event.clientX - proformaPreviewPanState.startX);
                proformaPreviewContainer.scrollTop = proformaPreviewPanState.scrollTop - (event.clientY - proformaPreviewPanState.startY);
            });
            const endPan = (event) => {
                if (!proformaPreviewPanState) return;
                if (event.pointerId != null && proformaPreviewPanState.pointerId !== event.pointerId) return;
                proformaPreviewPanState = null;
                proformaPreviewContainer.classList.remove('is-panning');
            };
            proformaPreviewContainer.addEventListener('pointerup', endPan);
            proformaPreviewContainer.addEventListener('pointercancel', endPan);
            proformaPreviewContainer.addEventListener('pointerleave', endPan);
        }

        function getProformaLogoAspectRatio() {
            const width = Number(proformaLogoWidthField?.value || loadedConfig?.general?.proformaLogoWidth || 120) || 120;
            const height = Number(proformaLogoHeightField?.value || loadedConfig?.general?.proformaLogoHeight || 74) || 74;
            return height ? width / height : 120 / 74;
        }

        let proformaLogoAspectRatio = 120 / 74;
        let proformaLogoAspectSyncing = false;

        function syncProformaLogoAspectLock() {
            const locked = (proformaLogoAspectLockedField?.value || loadedConfig?.general?.proformaLogoAspectLocked || 'true') !== 'false';
            if (proformaLogoAspectLockedField) {
                proformaLogoAspectLockedField.value = locked ? 'true' : 'false';
            }
            proformaLogoAspectLockButton?.classList.toggle('is-active', locked);
            proformaLogoAspectLockButton?.setAttribute('aria-pressed', String(locked));
        }

        function updateProformaLogoLinkedSize(source) {
            if (proformaLogoAspectSyncing || !proformaLogoAspectLockedField || proformaLogoAspectLockedField.value === 'false') return;
            proformaLogoAspectSyncing = true;
            if (source === 'width' && proformaLogoWidthField && proformaLogoHeightField) {
                const width = Number(proformaLogoWidthField.value);
                if (Number.isFinite(width) && width > 0) {
                    proformaLogoHeightField.value = String(Math.max(24, Math.round(width / proformaLogoAspectRatio)));
                }
            }
            if (source === 'height' && proformaLogoWidthField && proformaLogoHeightField) {
                const height = Number(proformaLogoHeightField.value);
                if (Number.isFinite(height) && height > 0) {
                    proformaLogoWidthField.value = String(Math.max(40, Math.round(height * proformaLogoAspectRatio)));
                }
            }
            proformaLogoAspectSyncing = false;
        }

        function commitProformaLogoLinkedSize(source) {
            if (!proformaLogoAspectLockedField || proformaLogoAspectLockedField.value === 'false') {
                return;
            }
            updateProformaLogoLinkedSize(source);
            updateProformaPreview();
        }

