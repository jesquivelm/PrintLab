}

/* Improved scrollbar */
.quote-browser-table-wrap {
    scrollbar-width: thin;
    scrollbar-color: var(--app-border, #cdd8e3) transparent;
}

.quote-browser-table-wrap::-webkit-scrollbar {
    width: 5px;
    height: 5px;
}

.quote-browser-table-wrap::-webkit-scrollbar-track {
    background: transparent;
}

.quote-browser-table-wrap::-webkit-scrollbar-thumb {
    background: var(--app-border, #cdd8e3);
    border-radius: 999px;
}

.quote-browser-table-wrap::-webkit-scrollbar-thumb:hover {
    background: var(--app-text-muted, #94a3b8);
}

