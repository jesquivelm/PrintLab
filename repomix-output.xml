.quote-request-attachment-preview{width:104px;height:78px;border:1px solid #dbe6ee;border-radius:14px;background:linear-gradient(180deg,#fbfdff 0%,#f2f7fb 100%);display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:pointer;justify-self:start;padding:0}
.quote-request-attachment-preview[data-orientation="portrait"]{width:74px;height:96px}
.quote-request-attachment-preview[data-orientation="square"]{width:88px;height:88px}
.quote-request-attachment-preview img,.quote-request-attachment-preview video,.quote-request-attachment-preview iframe{width:100%;height:100%;display:block;object-fit:cover;object-position:center;border:0;background:#fff}
.quote-request-attachment-preview.is-pdf iframe{background:#fff}
.quote-request-attachment-filetile{width:100%;height:100%;display:grid;place-items:center;padding:10px;text-align:center;color:#7890a3}
.quote-request-attachment-filetile strong{font-size:12px;font-weight:600;letter-spacing:.04em}
.quote-request-attachment-filetile span{font-size:11px;color:#93a4b2}
.quote-request-attachment-body{display:grid;gap:8px;min-width:0}
.quote-request-attachment-meta{display:grid;gap:3px;min-width:0}
.quote-request-attachment-name{font-size:13px;font-weight:400;color:#587084;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.quote-request-attachment-size{font-size:11px;color:#94a3af}
.quote-request-attachment-note{font-size:11px;color:#8ba0af}
.quote-request-attachment-card audio{width:100%}
.quote-request-attachment-remove{width:32px;height:32px;padding:0;border:0;border-radius:0;background:transparent;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--icon-color,#b94a4a);align-self:start;transition:transform .16s ease,color .16s ease,filter .16s ease}
.quote-request-attachment-remove:hover{transform:translateY(-1px);color:var(--icon-hover-color,var(--icon-color,#c63f3f));filter:drop-shadow(0 6px 12px rgba(198,63,63,.18))}
.quote-request-preview-modal{position:fixed;inset:0;z-index:520;display:grid;place-items:center;padding:24px;background:rgba(245,250,253,.88);backdrop-filter:blur(7px)}
.quote-request-preview-modal[hidden]{display:none}
.front-back-panel{width:min(720px,calc(100vw - 32px));max-height:calc(100vh - 48px);overflow:auto;border:1px solid #d7e2ea;border-radius:18px;background:#fff;box-shadow:0 24px 60px rgba(15,38,56,.22)}
.front-back-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:18px 20px;border-bottom:1px solid #dfe8ee}
.front-back-head h3{margin:0;font-size:18px;color:#17354a}
.front-back-head p{margin:4px 0 0;font-size:13px;color:#647789}
.front-back-body{display:grid;gap:14px;padding:18px 20px}
.front-back-current,.front-back-option,.front-back-warning{border:1px solid #dfe8ee;border-radius:12px;background:#f8fbfd;padding:12px}
.front-back-option{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;align-items:start;cursor:pointer}
.front-back-option strong,.front-back-current strong{display:block;color:#17354a;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.front-back-option span,.front-back-current span,.front-back-warning{font-size:12px;color:#607286}
.front-back-actions{display:flex;justify-content:flex-end;gap:10px;padding:0 20px 18px}
.front-back-remove{margin-right:auto}
.front-back-warning[hidden]{display:none}
.quote-request-preview-panel{width:var(--preview-panel-width,min(960px,calc(100vw - 32px)));max-height:calc(100vh - 32px);display:grid;grid-template-rows:auto minmax(0,1fr);gap:14px;padding:18px;border-radius:22px;background:#fff;box-shadow:0 26px 50px rgba(15,23,42,.24)}
.quote-request-preview-head{display:flex;align-items:center;justify-content:space-between;gap:16px}
.quote-request-preview-head h3{margin:0;font-size:16px;color:#1d3c52;font-weight:600}
.quote-request-preview-close{width:40px;height:40px;border:1px solid #d4e1ea;border-radius:14px;background:#fff;cursor:pointer;color:#456175;font-size:24px;line-height:1}
.quote-request-preview-content{height:var(--preview-content-height,min(70vh,760px));min-height:320px;max-height:calc(100vh - 140px);border:1px solid #dbe6ee;border-radius:18px;background:linear-gradient(180deg,#fcfeff 0%,#f2f8fb 100%);display:grid;place-items:center;overflow:hidden}
.quote-request-preview-stage{position:relative;width:100%;height:100%;display:grid;place-items:center;overflow:hidden;overscroll-behavior:contain;background:linear-gradient(180deg,rgba(252,254,255,.96) 0%,rgba(243,248,251,.98) 100%)}
.quote-request-preview-media{display:grid;place-items:center;width:100%;height:100%;max-width:100%;max-height:100%;transform:translate(var(--preview-x,0px),var(--preview-y,0px)) scale(var(--preview-scale,1));transform-origin:center center;transition:transform .12s ease-out;will-change:transform;touch-action:none;user-select:none}
.quote-request-preview-media.is-zoomable{cursor:grab}
.quote-request-preview-media.is-zoomable.is-dragging{cursor:grabbing;transition:none}
.quote-request-preview-media img,.quote-request-preview-media video,.quote-request-preview-media iframe{width:100%;height:100%;max-width:100%;max-height:100%;display:block;border:0;object-fit:contain;object-position:center;background:transparent}
.quote-request-preview-media img{user-select:none;-webkit-user-drag:none;pointer-events:auto}
.quote-request-preview-media iframe{pointer-events:none}
.quote-request-preview-content>img,.quote-request-preview-content>video,.quote-request-preview-content>iframe,.quote-request-preview-content>audio{display:block;max-width:100%;max-height:100%;margin:auto;border:0;object-fit:contain;background:transparent}
.quote-request-preview-controls{position:absolute;right:16px;bottom:16px;display:flex;align-items:center;gap:8px;z-index:2;padding:8px 10px;border:1px solid rgba(11,129,184,.12);border-radius:16px;background:rgba(255,255,255,.62);backdrop-filter:blur(10px);box-shadow:0 10px 24px rgba(15,23,42,.12)}
.quote-request-preview-zoom{min-width:40px;height:40px;padding:0 12px;border:1px solid rgba(11,129,184,.14);border-radius:12px;background:rgba(255,255,255,.52);box-shadow:0 8px 18px rgba(15,23,42,.08);display:inline-flex;align-items:center;justify-content:center;color:#476378;font-size:20px;line-height:1;cursor:pointer}
.quote-request-preview-zoom:hover{border-color:rgba(11,129,184,.28);color:#0b81b8}
.quote-request-preview-zoom-value{min-width:58px;text-align:center;font-size:12px;font-weight:600;color:#476378}
.quote-request-preview-empty{display:grid;gap:6px;place-items:center;text-align:center;padding:24px;color:#8295a5}
.quote-request-preview-empty strong{font-size:14px;font-weight:500;color:#5f7689}
.quote-request-create-floating{position:fixed;top:164px;left:calc(50% + 360px);z-index:400;transition:transform 0.2s ease-out}
.process-launcher-stack{position:relative;width:58px;height:58px;display:flex;align-items:center;justify-content:center}
.process-launcher-primary{position:relative;z-index:10;width:58px;height:58px}
.floating-action-button{touch-action:none;user-select:none;width:58px;height:58px;min-width:58px;border-radius:18px;border:1px solid rgba(11,129,184,.18);background:linear-gradient(135deg,rgba(255,255,255,.98) 0%,rgba(237,247,253,.98) 100%);box-shadow:0 12px 28px rgba(15,23,42,.12);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7580;transition:all .3s cubic-bezier(0.34, 1.56, 0.64, 1);backdrop-filter:blur(10px);z-index:10}
.floating-action-button:hover{transform:translateY(-2px);border-color:rgba(11,129,184,.28);box-shadow:0 18px 34px rgba(15,23,42,.16);color:#0b81b8}
.process-launcher-stack.is-active .floating-action-button{transform:rotate(45deg);background:linear-gradient(135deg,#fff 0%,#f0f9ff 100%);border-color:#0b81b8;color:#0b81b8;box-shadow:0 20px 40px rgba(11,129,184,.2)}
.process-launcher-bridge{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:5}
.process-launcher-stack.is-active .process-launcher-bridge{pointer-events:auto}
.process-launcher-menu{position:relative;width:100%;height:100%}
.process-launcher-item{position:absolute;left:50%;top:50%;width:48px;height:48px;margin-left:-24px;margin-top:-24px;border-radius:15px;border:1px solid rgba(11,129,184,.12);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .4s cubic-bezier(0.34, 1.56, 0.64, 1);opacity:0;transform:translate(0, 0) scale(0.4);pointer-events:none;box-shadow:0 10px 20px rgba(0,0,0,.08);z-index:5}
.process-launcher-item:hover{border-color:#0b81b8;box-shadow:0 14px 28px rgba(11,129,184,.18);z-index:20}
.process-launcher-stack.is-active .process-launcher-item{opacity:1;pointer-events:auto}

.is-invalid{border-color:#ef4444 !important;box-shadow:0 0 0 3px rgba(239, 68, 68, 0.12) !important}
.quote-request-field.is-invalid .quote-request-tab{border-color:#ef4444 !important;box-shadow:0 0 0 3px rgba(239,68,68,.12) !important;color:#b42323}
.process-launcher-errors{position:absolute;bottom:calc(100% + 14px);right:0;width:min(320px, calc(100vw - 32px));max-height:280px;overflow-y:auto;background:rgba(240, 244, 248, 0.98);backdrop-filter:blur(10px);border:1px solid rgba(203, 213, 225, 0.6);border-radius:18px;padding:16px;color:#1e293b;box-shadow:0 18px 40px rgba(15, 23, 42, 0.12);z-index:20;display:grid;gap:10px;animation:slideUpFade 0.4s cubic-bezier(0.16, 1, 0.3, 1);transition:top 0.3s ease, bottom 0.3s ease}
.process-launcher-errors.is-below{bottom:auto;top:calc(100% + 14px);animation-name:slideDownFade}
@keyframes slideDownFade{from{opacity:0;transform:translateY(-15px) scale(0.98)}to{opacity:1;transform:translateY(0) scale(1)}}
.process-launcher-errors[hidden]{display:none}
.process-launcher-errors-head{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.06em}
.process-launcher-errors-list{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.process-launcher-errors-item{font-size:12px;color:#334155;display:flex;gap:8px;align-items:baseline;line-height:1.4}
.process-launcher-errors-item::before{content:'•';color:#ef4444;font-weight:bold}

@keyframes slideUpFade{from{opacity:0;transform:translateY(15px) scale(0.98)}to{opacity:1;transform:translateY(0) scale(1)}}
/* Radial Positions with combined transform */
.process-launcher-stack.is-active .process-launcher-item:nth-child(1){--tx:-84px; --ty:0px; transform:translate(var(--tx), var(--ty)) scale(1)}
.process-launcher-stack.is-active .process-launcher-item:nth-child(2){--tx:-60px; --ty:-60px; transform:translate(var(--tx), var(--ty)) scale(1);transition-delay:0.04s}
.process-launcher-stack.is-active .process-launcher-item:nth-child(3){--tx:0px; --ty:-84px; transform:translate(var(--tx), var(--ty)) scale(1);transition-delay:0.08s}
.process-launcher-stack.is-active .process-launcher-item:hover{transform:translate(var(--tx), var(--ty)) scale(1.15)}

.process-launcher-item-text{display:none}
/* Tooltip styles */
.process-launcher-item::after{content:attr(title);position:absolute;right:calc(100% + 14px);top:50%;transform:translateY(-50%) translateX(10px);background:rgba(15,35,50,0.95);color:#fff;padding:5px 10px;border-radius:8px;font-size:11px;font-weight:600;white-space:nowrap;opacity:0;pointer-events:none;transition:all 0.25s cubic-bezier(0.23, 1, 0.32, 1);backdrop-filter:blur(5px);box-shadow:0 10px 20px rgba(0,0,0,0.15);border:1px solid rgba(255,255,255,0.1)}
.process-launcher-item:hover::after{opacity:1;transform:translateY(-50%) translateX(0)}

@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(239,68,68,.5)}70%{box-shadow:0 0 0 9px rgba(239,68,68,0)}100%{box-shadow:0 0 0 0 rgba(239,68,68,0)}}
@media (max-width:980px){
    .quote-request-create-floating{top:auto !important;left:auto !important;bottom:22px !important;right:22px !important}
    .process-launcher-item::after{right:auto;left:calc(100% + 14px);transform:translateY(-50%) translateX(-10px)}
    .process-launcher-item:hover::after{transform:translateY(-50%) translateX(0)}
    .process-launcher-stack.is-active .process-launcher-item:nth-child(1){--tx:-85px; --ty:0px}
    .process-launcher-stack.is-active .process-launcher-item:nth-child(2){--tx:-60px; --ty:-60px}
    .process-launcher-stack.is-active .process-launcher-item:nth-child(3){--tx:0px; --ty:-85px}
}

.icon-glyph{display:inline-flex;align-items:center;justify-content:center;line-height:1}
.icon-image{display:block;object-fit:contain}
.icon-svg-mask{display:inline-block;background:currentColor;background-repeat:no-repeat;background-position:center;background-size:contain}
.sap-config-popover-panel{width:min(1480px,calc(100vw - 26px));max-height:calc(100vh - 24px);overflow:hidden}
.sap-config-shell{display:grid;grid-template-columns:320px minmax(0,1fr);gap:16px;min-height:0}
.sap-config-sidebar,.sap-config-main{display:grid;gap:14px;min-height:0}
.sap-config-main{grid-template-rows:auto auto minmax(0,1fr)}
.sap-config-card{border:1px solid #d8e2ea;border-radius:18px;background:linear-gradient(180deg,#fff 0%,#f7fbfc 100%);box-shadow:0 8px 22px rgba(13,35,52,.06);padding:16px;display:grid;gap:12px}
.sap-config-card h3,.sap-config-card h4{margin:0;color:#17354a}
.sap-config-card p{margin:0;color:#5f7487;font-size:12px;line-height:1.4}
