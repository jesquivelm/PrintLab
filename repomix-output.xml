.sap-config-actions{display:flex;flex-wrap:wrap;gap:10px}
.sap-config-actions .action-btn{min-height:38px}
.sap-config-subtitle{font-size:12px;color:#61788b}
.sap-config-result{min-height:140px;max-height:320px;overflow:auto;border:1px solid #d9e4ec;border-radius:16px;background:#0f1720;color:#dbe8f3;padding:14px;font:12px/1.5 Consolas,"Courier New",monospace;white-space:pre-wrap;word-break:break-word}
.sap-config-log-list{display:grid;gap:10px;max-height:220px;overflow:auto}
.sap-config-log-item{padding:12px;border:1px solid #d9e4ec;border-radius:14px;background:#fff}
.sap-config-log-item strong{display:block;color:#17354a;font-size:12px}
.sap-config-log-item span{display:block;color:#708493;font-size:11px;line-height:1.4}
.sap-config-json-actions{display:flex;justify-content:space-between;gap:10px;align-items:center}
.sap-config-json-actions .action-btn{min-height:36px}
.sap-config-textarea{min-height:210px;font:12px/1.5 Consolas,"Courier New",monospace}
.sap-config-empty{padding:12px;border:1px dashed #cad8e3;border-radius:14px;background:#fff;color:#7990a2;font-size:12px}
.sap-config-inline{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.sap-config-inline label{display:inline-flex;align-items:center;gap:8px;font-size:12px;color:#37566f}
.sap-config-status-note{font-size:12px;color:#4d677b}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(239,68,68,.5)}70%{box-shadow:0 0 0 9px rgba(239,68,68,0)}100%{box-shadow:0 0 0 0 rgba(239,68,68,0)}}
@media (max-width:1180px){.sap-config-shell{grid-template-columns:1fr}.sap-config-main{grid-template-rows:auto auto auto}.sap-config-grid-compact{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:980px){.quote-request-columns,.quote-request-grid,.quote-request-finishes-grid,.quote-request-shape-grid,.sap-config-grid,.sap-config-grid-compact,.sap-config-counts{grid-template-columns:1fr}.quote-request-step-one-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quote-request-create-floating{top:auto !important;left:auto !important;bottom:22px !important;right:22px !important}}
@media (max-width:1500px) and (max-height:820px){.quote-request-finishes-grid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.quote-request-finishes-column{gap:10px}.quote-request-subblock[data-finish-key]{gap:0;padding:0;overflow:hidden}.quote-request-subblock[data-finish-key]>h4{display:none}.quote-request-finish-compact-head{width:100%;min-height:48px;border:0;background:transparent;color:#17354a;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:10px;padding:0 14px;text-align:left;font:inherit;font-weight:700;cursor:pointer}.quote-request-subblock[data-finish-key]>:not(h4):not(.quote-request-finish-compact-head){display:none}.quote-request-subblock[data-finish-key].is-compact-open{padding-bottom:12px}.quote-request-subblock[data-finish-key].is-compact-open>:not(h4):not(.quote-request-finish-compact-head){display:grid;margin:0 12px 0}.quote-request-subblock[data-finish-key].is-compact-open>.quote-request-tabset{display:flex !important}.quote-request-subblock[data-finish-key].is-compact-open>.quote-request-finish-popover-wrap{display:grid}.quote-request-subblock[data-finish-key="diecut"]{order:1}.quote-request-subblock[data-finish-key="numbering"]{order:2}}
@media (max-width:720px){.quote-request-step-two-layout{grid-template-columns:1fr}}
@media (max-width:760px){.quote-request-step-one-grid{grid-template-columns:1fr}.quote-request-quantity-field{grid-column:auto}.quote-request-quantity-repeater .quantity-row{overflow:auto}}
</style>
