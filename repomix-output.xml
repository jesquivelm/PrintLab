        async function readNotificationAttachmentDraft(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => {
                    const result = String(reader.result || '');
                    const base64 = result.includes(',') ? result.split(',').pop() : result;
                    resolve({
                        fileName: file.name || 'adjunto',
                        mimeType: file.type || 'application/octet-stream',
                        fileExt: (String(file.name || '').split('.').pop() || '').toLowerCase(),
                        sizeBytes: Number(file.size || 0),
                        contentBase64: base64 || ''
                    });
                };
                reader.onerror = () => reject(new Error('No fue posible leer el archivo adjunto.'));
                reader.readAsDataURL(file);
            });
        }

        async function sendNotificationCenterMessage() {
            if (!selectedNotificationThreadCode) {
                throw new Error('Debes seleccionar una conversación antes de responder.');
            }
            const bodyText = String(notificationCenterComposeBody?.value || '').trim();
            if (!bodyText && !notificationCenterAttachmentDraft) {
                throw new Error('Debes escribir un mensaje o adjuntar un archivo.');
            }
            setNotificationCenterStatus('Enviando respuesta...', false);
            const response = await fetch(`/api/notification-center/threads/${encodeURIComponent(selectedNotificationThreadCode)}/messages`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    bodyText,
                    attachments: notificationCenterAttachmentDraft ? [notificationCenterAttachmentDraft] : []
                })
            });
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(payload.error || 'No fue posible enviar el mensaje.');
            }
            if (notificationCenterComposeBody) notificationCenterComposeBody.value = '';
            resetNotificationAttachmentDraft();
            notificationCenterLoadedOnce = false;
            notificationCenterThreadsLoadedOnce = false;
            await loadNotificationCenterOverview(true);
            await loadNotificationCenterThreads(true);
            await loadNotificationCenterThread(selectedNotificationThreadCode, { preserveStatus: true });
            setNotificationCenterStatus('Respuesta enviada correctamente.', false);
        }

        function applyNotificationCenterAccess() {
            const permissionName = String(currentAdminProfile?.permissionName || '').trim();
            const canManageNotificationCenter = /administrador(?:es)?|implementador(?:es)?/i.test(permissionName);
            if (configTabNotificaciones) configTabNotificaciones.hidden = !canManageNotificationCenter;
            if (securityTabLlaves) securityTabLlaves.hidden = !canManageNotificationCenter;
            if (!canManageNotificationCenter) {
                document.getElementById('tab-notificaciones')?.classList.remove('active');
                if (document.querySelector('.config-tab.active')?.dataset.tab === 'notificaciones') {
                    document.querySelectorAll('.config-tab').forEach((tab) => tab.classList.remove('active'));
                    document.querySelectorAll('.config-tab-content').forEach((panel) => panel.classList.remove('active'));
                    document.querySelector('.config-tab[data-tab="diseno"]')?.classList.add('active');
                    document.getElementById('tab-diseno')?.classList.add('active');
                }
                if (document.querySelector('.security-subtab.active')?.dataset.securityTab === 'llaves') {
                    activateSecurityTab('usuarios');
                }
            }
        }

