        .notifications-empty-strong {
            display: block;
            margin-bottom: 6px;
            color: var(--app-text);
            font-size: 14px;
            font-weight: 700;
        }
        .notifications-status {
            padding: 10px 20px 0;
            color: var(--app-text-muted);
            font-size: 12px;
