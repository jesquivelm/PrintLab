.info-popover-panel {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 9999;
  width: min(640px, calc(100vw - 32px));
  max-width: min(640px, calc(100vw - 32px));
  padding: 14px;
  border: 1px solid #d6e0e7;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 12px 30px rgba(20, 42, 74, 0.15);
}

