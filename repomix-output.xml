                this.dragState = {
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    originX: rect.left,
                    originY: rect.top,
                    moved: false
                };
                this.button.setPointerCapture(event.pointerId);
                this.shell.classList.add('dragging');
