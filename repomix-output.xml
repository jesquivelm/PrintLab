@media (max-width: 640px) {
    .topbar-profile-popover {
        padding: 14px;
    }

    .topbar-profile-head {
        align-items: flex-start;
        padding: 18px;
    }

    .topbar-profile-tabs {
        margin: 14px 18px;
    }

    .topbar-profile-form {
        padding: 0 18px 18px;
    }

    .topbar-profile-grid {
        grid-template-columns: 1fr;
    }

    .topbar-profile-logout {
        margin-right: 0;
    }
}

.theme-toggle {
    box-shadow: none;
}

.theme-toggle .theme-toggle-icon {
    width: 16px;
    height: 16px;
}

.theme-toggle-icon-sun {
    border-width: 1.8px;
    box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 12%, transparent);
}

.theme-toggle-icon-moon {
    box-shadow: inset -4px 0 0 var(--app-surface-soft);
}

.product-catalog-card .product-catalog-head {
    margin-bottom: 18px;
}

.product-catalog-card .product-catalog-title h1 {
    color: var(--app-text);
    font-size: 26px;
}

.product-catalog-card .product-catalog-title p,
.product-catalog-card .product-catalog-kpi,
.product-catalog-card .product-detail-title span {
    color: var(--app-text-muted);
}

.product-catalog-card .product-catalog-kpi strong,
.product-catalog-card .product-detail-title strong {
    color: var(--app-text);
}

.product-catalog-card .product-detail-row > td {
    background: transparent !important;
}

.product-catalog-card .product-detail-shell {
    gap: 16px;
    padding: 18px 8px 8px;
    border-top: 1px solid var(--app-border);
}

.product-catalog-card .product-readonly-field,
.product-catalog-card .product-history-item {
    border-color: var(--app-border);
    background: var(--app-surface-raised);
    border-radius: 12px;
}

.product-catalog-card .product-readonly-field span,
.product-catalog-card .product-history-meta,
.product-catalog-card .product-history-main span {
    color: var(--app-text-muted);
}

.product-catalog-card .product-readonly-field strong,
.product-catalog-card .product-history-main strong {
    color: var(--app-text);
}

.product-detail-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
}

.product-detail-tab {
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--app-surface) 82%, var(--app-primary-soft));
    color: var(--app-text-soft);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.product-detail-tab:hover,
.product-detail-tab:focus-visible {
    color: var(--app-primary-strong);
    border-color: color-mix(in srgb, var(--app-primary) 30%, var(--app-border));
    background: color-mix(in srgb, var(--app-primary) 10%, var(--app-surface));
    transform: translateY(-1px);
}

.product-detail-tab.is-active {
    color: #ffffff;
    border-color: transparent;
    background: linear-gradient(180deg, var(--app-primary) 0%, var(--app-primary-strong) 100%);
}

.product-detail-tab-panel[hidden] {
    display: none !important;
}

.product-detail-tab-panel.is-active {
    display: block;
}

html[data-theme="dark"] .product-catalog-card .product-readonly-field,
html[data-theme="dark"] .product-catalog-card .product-history-item,
