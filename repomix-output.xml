            const image = String(user?.photoUrl || '').trim();
            if (image) {
                container.innerHTML = `<img src="${image}" alt="${user?.name || 'Usuario'}">`;
                return;
            }
            container.className = className || container.className;
            container.textContent = getAdminUserInitials(user?.name);
        }

        function getSelectedAdminUser() {
            return adminUsers.find((user) => Number(user.id) === Number(selectedAdminUserId)) || null;
        }

        function getAdminPermissionById(permissionId) {
            return adminPermissions.find((item) => Number(item.id) === Number(permissionId)) || null;
        }

        function normalizeAdminUserPermissionToken(value = '') {
            return String(value || '')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim()
                .toLowerCase()
                .replace(/\s+/g, ' ');
        }

        function adminUserPermissionRequiresSapSalesperson(permissionName = '') {
            const normalized = normalizeAdminUserPermissionToken(permissionName);
            return normalized === 'vendedores' || normalized === 'vendedores cotizadores';
        }

        function getCurrentAdminUserPermission() {
            const selectedPermissionId = userAdminFieldPermission?.value || getSelectedAdminUser()?.permissionId;
            return getAdminPermissionById(selectedPermissionId);
        }

        function currentAdminUserRequiresSapSalesperson() {
            const user = getSelectedAdminUser();
            const permission = getCurrentAdminUserPermission();
            return adminUserPermissionRequiresSapSalesperson(permission?.name || user?.permissionName || '');
        }

        function getSelectedAdminUserSapSalespersonOption() {
            const selectedCode = String(userAdminFieldSapSalesperson?.value || userAdminFieldSapSalespersonCode?.value || '').trim();
            if (!selectedCode) return null;
            return sapSalespersonProfitCenters.find((item) => String(item.salesPersonCode || '').trim() === selectedCode) || null;
        }

        function renderAdminUserSapSalespersonOptions(selectedCode = '') {
            if (!userAdminFieldSapSalesperson) return;
            const current = String(selectedCode || userAdminFieldSapSalesperson.value || userAdminFieldSapSalespersonCode?.value || '').trim();
            const items = sapSalespersonProfitCenters
                .filter((item) => item.isActive !== false && Number(item.salesPersonCode) > 0)
                .sort((left, right) => String(left.salespersonName || '').localeCompare(String(right.salespersonName || ''), 'es', { sensitivity: 'base' }));
            userAdminFieldSapSalesperson.innerHTML = ['<option value="">Selecciona un vendedor SAP</option>']
                .concat(items.map((item) => `<option value="${escapeHtml(String(item.salesPersonCode || '').trim())}">${escapeHtml(item.salespersonName || 'Sin nombre')}</option>`))
                .join('');
            if ([...userAdminFieldSapSalesperson.options].some((option) => option.value === current)) {
                userAdminFieldSapSalesperson.value = current;
            } else {
                userAdminFieldSapSalesperson.value = '';
            }
            if (userAdminFieldSapSalespersonCode) {
                userAdminFieldSapSalespersonCode.value = String(userAdminFieldSapSalesperson.value || '').trim();
            }
        }

        function setAdminUserSapSalespersonInvalidState(isInvalid) {
            userAdminFieldSapSalespersonWrapper?.classList.toggle('is-required-empty', isInvalid);
            userAdminFieldSapSalesperson?.classList.toggle('is-invalid', isInvalid);
        }

        function validateSelectedAdminUserSapSalesperson(showFeedback = false) {
            const user = getSelectedAdminUser();
            if (!user) return true;
            const requiresSalesperson = currentAdminUserRequiresSapSalesperson();
            if (userAdminFieldSapSalespersonWrapper) {
                userAdminFieldSapSalespersonWrapper.hidden = !requiresSalesperson;
            }
            if (!requiresSalesperson) {
                setAdminUserSapSalespersonInvalidState(false);
                if (userAdminFieldSapSalespersonCode) {
                    userAdminFieldSapSalespersonCode.value = String(userAdminFieldSapSalesperson?.value || user?.sapSalespersonCode || '').trim();
                }
                return true;
            }
            const selectedCode = String(userAdminFieldSapSalesperson?.value || userAdminFieldSapSalespersonCode?.value || '').trim();
            const isValid = selectedCode !== '';
            setAdminUserSapSalespersonInvalidState(!isValid);
            if (userAdminFieldSapSalespersonCode) {
                userAdminFieldSapSalespersonCode.value = selectedCode;
            }
            if (!isValid && showFeedback) {
                setConfigStatus('Vendedor SAP pendiente: se mantiene marcado para completar después.', true);
            }
            return true;
        }

        async function ensureSapSalespersonOptionsLoaded(force = false) {
            if (sapSalespersonOptionsLoadedOnce && !force) return;
            const response = await fetch('/api/sap/salesperson-profit-centers');
            const payload = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(payload.error || 'No fue posible cargar los vendedores SAP.');
            }
            sapSalespersonProfitCenters = Array.isArray(payload.items)
                ? payload.items.map(normalizeSapSalespersonProfitCenter)
                : [];
            sapSalespersonOptionsLoadedOnce = true;
            renderAdminUserSapSalespersonOptions(String(getSelectedAdminUser()?.sapSalespersonCode || ''));
            validateSelectedAdminUserSapSalesperson(false);
        }

        function getAdminUserPermissionAccess(user) {
            const permission = getAdminPermissionById(user?.permissionId);
            const modules = createEmptyPermissionModules(permission?.modules);
            const edit = [];
            const create = [];
            const view = [];
            PERMISSION_PRESENTATION_KEYS.forEach((key) => {
                const label = getPermissionPresentationLabel(key);
                if (modules[key]?.edit) edit.push(label);
                if (modules[key]?.create) create.push(label);
                if (modules[key]?.view) view.push(label);
            });
            return { permission, edit, create, view };
        }

        function formatAdminUserProcessLine(user) {
            const department = String(user?.department || '').trim() || 'Sin departamento';
            const process = String(user?.process || '').trim();
            const base = process ? `${department} - ${process}` : department;
            return user?.active === false ? `${base} · Inactivo` : base;
        }

        function formatAdminUserPermissionLine(user) {
            const { permission, edit, create, view } = getAdminUserPermissionAccess(user);
            const permissionName = permission?.name || user?.permissionName || 'Sin permiso';
            const summary = [];
            if (edit.length) summary.push(`Edita ${edit.length}`);
            if (create.length) summary.push(`Crea ${create.length}`);
            if (view.length) summary.push(`Visualiza ${view.length}`);
            return summary.length ? `${permissionName} | ${summary.join(' · ')}` : permissionName;
        }

        function renderAdminUserPermissionBadges(items, emptyLabel) {
            if (!items.length) {
                return `<span class="user-admin-permissions-empty">${escapeHtml(emptyLabel)}</span>`;
            }
            return items.map((item) => `<span class="user-admin-permissions-badge">${escapeHtml(item)}</span>`).join('');
        }

        function renderAdminUserStatusBadge(user) {
            const active = user?.active !== false;
            return `<span class="user-admin-row-status ${active ? '' : 'is-inactive'}">${active ? 'Activo' : 'Inactivo'}</span>`;
        }

        function renderAdminUserPermissionAccessSummary(user) {
            if (!userAdminPermissionsNote || !userAdminPermissionAccessSummary) return;
            const { permission, edit, create, view } = getAdminUserPermissionAccess(user);
            const permissionName = permission?.name || user?.permissionName || '';
            if (!permissionName) {
                userAdminPermissionsNote.textContent = 'Este usuario todavía no tiene un permiso asignado.';
                userAdminPermissionAccessSummary.innerHTML = `
                    <div class="user-admin-permissions-group">
                        <strong>Sin accesos configurados</strong>
                        <div class="user-admin-permissions-badges">
                            <span class="user-admin-permissions-empty">Asigna un permiso para ver sus módulos.</span>
                        </div>
                    </div>
                `;
                return;
            }
            userAdminPermissionsNote.textContent = `Permiso asignado: ${permissionName}`;
            userAdminPermissionAccessSummary.innerHTML = `
                <div class="user-admin-permissions-group">
                    <strong>Puede editar</strong>
                    <div class="user-admin-permissions-badges">${renderAdminUserPermissionBadges(edit, 'Sin módulos con edición')}</div>
                </div>
                <div class="user-admin-permissions-group">
                    <strong>Puede crear</strong>
                    <div class="user-admin-permissions-badges">${renderAdminUserPermissionBadges(create, 'Sin módulos con creación')}</div>
                </div>
                <div class="user-admin-permissions-group">
                    <strong>Puede visualizar</strong>
                    <div class="user-admin-permissions-badges">${renderAdminUserPermissionBadges(view, 'Sin módulos en consulta')}</div>
                </div>
            `;
        }

        function populateUserPermissionOptions() {
            if (!userAdminFieldPermission) return;
            const current = String(userAdminFieldPermission.value || '');
            const options = ['<option value="">Sin permiso asignado</option>']
                .concat(adminPermissions.map((permission) => `<option value="${permission.id}">${escapeHtml(permission.name || 'Permiso')}</option>`));
            userAdminFieldPermission.innerHTML = options.join('');
            if ([...userAdminFieldPermission.options].some((option) => option.value === current)) {
                userAdminFieldPermission.value = current;
            }
            if (userAdminCreatePermissionField) {
                const createCurrent = String(userAdminCreatePermissionField.value || '');
                userAdminCreatePermissionField.innerHTML = options.join('');
                if ([...userAdminCreatePermissionField.options].some((option) => option.value === createCurrent)) {
                    userAdminCreatePermissionField.value = createCurrent;
                }
            }
        }

        function populateUserLandingOptions(selectedValue = null) {
            if (!userAdminFieldLanding) return;
            const current = normalizeOptionalPresentationKey(selectedValue === null ? userAdminFieldLanding.value : selectedValue);
            userAdminFieldLanding.innerHTML = ['<option value="">Usar permiso</option>']
                .concat(PERMISSION_PRESENTATION_KEYS.map((key) => `<option value="${key}">${escapeHtml(getPermissionPresentationLabel(key))}</option>`))
                .join('');
            userAdminFieldLanding.value = current;
        }

        function renderAdminUserList() {
            if (!userAdminTableBody) return;
            const deleteIcon = getAdminUserIconConfig('adminUserDelete', '#b94848', 18, '🗑');
            if (!adminUsers.length) {
                userAdminTableBody.innerHTML = '<tr><td class="user-admin-empty">Todavía no hay usuarios creados.</td></tr>';
                return;
            }
            userAdminTableBody.innerHTML = adminUsers.map((user) => `
                <tr class="${Number(user.id) === Number(selectedAdminUserId) ? 'is-selected' : ''} ${user.active === false ? 'is-inactive' : ''}" data-user-id="${user.id}">
                    <td>
                        <div class="user-admin-row-shell">
                            <div class="user-admin-row-main">
                                <div class="user-admin-avatar" data-user-avatar="${user.id}">${getAdminUserInitials(user.name)}</div>
                                <div class="user-admin-row-text">
                                    <span class="user-admin-row-name">${escapeHtml(user.name || 'Sin nombre')}</span>
                                    <span class="user-admin-row-department">${escapeHtml(formatAdminUserProcessLine(user))}</span>
                                    <span class="user-admin-row-permission">${escapeHtml(formatAdminUserPermissionLine(user))}</span>
                                </div>
                            </div>
                            <div class="user-admin-row-actions">
                                ${renderAdminUserStatusBadge(user)}
                                <button type="button" class="user-admin-delete-button" data-user-delete="${user.id}" aria-label="Dar de baja usuario" title="Dar de baja usuario"></button>
                            </div>
                        </div>
                    </td>
                </tr>
            `).join('');
            adminUsers.forEach((user) => {
                const avatar = userAdminTableBody.querySelector(`[data-user-avatar="${user.id}"]`);
                if (avatar) {
                    renderAdminUserAvatar(avatar, user, 'user-admin-avatar');
                }
                const deleteButton = userAdminTableBody.querySelector(`[data-user-delete="${user.id}"]`);
                if (deleteButton) {
                    renderButtonIcon(deleteButton, deleteIcon.value, deleteIcon.color, deleteIcon.size, '🗑');
                }
            });
        }

        function renderAdminUserCreateButton() {
            if (!userAdminCreateButton) return;
            const createIcon = getAdminUserIconConfig('adminUserCreate', '#118fc6', 22, '+');
            renderButtonIcon(userAdminCreateButton, createIcon.value, createIcon.color, createIcon.size, '+');
        }

        function updateAdminUserDetail() {
            const user = getSelectedAdminUser();
            if (!user) {
                if (userAdminDetailEmpty) userAdminDetailEmpty.hidden = false;
                if (userAdminDetailShell) userAdminDetailShell.hidden = true;
                if (userAdminPermissionsNote) userAdminPermissionsNote.textContent = 'Selecciona un permiso para ver los accesos disponibles.';
                if (userAdminPermissionAccessSummary) userAdminPermissionAccessSummary.innerHTML = '';
                populateUserLandingOptions('');
                return;
            }
            if (userAdminDetailEmpty) userAdminDetailEmpty.hidden = true;
            if (userAdminDetailShell) userAdminDetailShell.hidden = false;

            if (userAdminFieldName) userAdminFieldName.value = user.name || '';
            if (userAdminFieldUsername) userAdminFieldUsername.value = user.username || '';
            if (userAdminFieldPassword) userAdminFieldPassword.value = user.password || '';
            if (userAdminFieldPassword) userAdminFieldPassword.type = userAdminPasswordVisible ? 'text' : 'password';
            if (userAdminFieldName) userAdminFieldName.readOnly = true;
            if (userAdminFieldUsername) userAdminFieldUsername.readOnly = true;
            if (userAdminFieldDepartment) userAdminFieldDepartment.value = user.department || '';
            if (userAdminFieldProcess) userAdminFieldProcess.value = user.process || '';
            if (userAdminFieldDepartment) userAdminFieldDepartment.readOnly = true;
            if (userAdminFieldProcess) userAdminFieldProcess.readOnly = true;
            renderAdminUserSapSalespersonOptions(String(user.sapSalespersonCode || ''));
            if (userAdminFieldSapSalespersonCode) {
                userAdminFieldSapSalespersonCode.value = String(user.sapSalespersonCode || '').trim();
            }
            if (userAdminFieldEmail) userAdminFieldEmail.value = user.email || '';
            if (userAdminFieldPhone) userAdminFieldPhone.value = user.phone || '';
            if (userAdminFieldNotifyEmail) userAdminFieldNotifyEmail.checked = user.notificationEmail === true;
            if (userAdminFieldNotifyWhatsapp) userAdminFieldNotifyWhatsapp.checked = user.notificationWhatsapp === true;
            if (userAdminFieldNotifySms) userAdminFieldNotifySms.checked = user.notificationSms === true;
            populateUserPermissionOptions();
            populateUserLandingOptions(user.defaultLanding || '');
            if (userAdminFieldPermission) userAdminFieldPermission.value = user.permissionId == null ? '' : String(user.permissionId);
            // Solo el implementador puede editar los permisos de cualquier usuario,
            // incluidos los administradores. El administrador puede editar permisos
            // de usuarios que no sean super-permiso (administrador/implementador).
            const sessionPermissionName = String(currentAdminProfile?.permissionName || readStoredErpSession()?.permissionName || '').trim();
            const isImplementador = /implementador(?:es)?/i.test(sessionPermissionName);
            const isAdministrador = /administrador(?:es)?/i.test(sessionPermissionName);
            const targetPermission = getAdminPermissionById(user.permissionId);
            const targetIsSuper = /administrador(?:es)?|implementador(?:es)?/i.test(String(targetPermission?.name || user?.permissionName || '').trim());
            const canChangePermission = isImplementador || (isAdministrador && !targetIsSuper);
            if (userAdminFieldPermission) userAdminFieldPermission.disabled = !canChangePermission;
            if (userAdminFieldLanding) userAdminFieldLanding.disabled = !canChangePermission;

            if (userAdminDetailName) userAdminDetailName.textContent = user.name || 'Usuario';
            if (userAdminDetailSubline) userAdminDetailSubline.textContent = formatAdminUserProcessLine(user);
            if (userAdminPhotoDropzone) {
                renderAdminUserAvatar(userAdminPhotoDropzone, user, 'user-admin-detail-avatar');
            }
            if (userAdminSignatureDropzone) {
                userAdminSignatureDropzone.innerHTML = user.signatureUrl
                    ? `<img src="${escapeHtml(user.signatureUrl)}" alt="Firma de ${escapeHtml(user.name || 'usuario')}">`
                    : 'Sin firma';
            }
            if (userAdminDeactivateButton) {
                userAdminDeactivateButton.textContent = user.active === false ? 'Usuario inactivo' : 'Dar de baja';
                userAdminDeactivateButton.disabled = user.active === false;
                userAdminDeactivateButton.classList.toggle('is-inactive', user.active === false);
            }
            renderAdminUserPermissionAccessSummary(user);
            renderPasswordToggleButton(userAdminPasswordToggle, userAdminPasswordVisible);
            validateSelectedAdminUserSapSalesperson(false);
            if (currentAdminUserRequiresSapSalesperson() && !sapSalespersonOptionsLoadedOnce) {
                ensureSapSalespersonOptionsLoaded().catch((error) => {
                    setConfigStatus(error.message || 'No fue posible cargar los vendedores SAP.', true);
                });
            }
        }

        function selectAdminUser(id) {
            if (Number(id) !== Number(selectedAdminUserId) && !validateSelectedAdminUserSapSalesperson(true)) {
                return;
            }
            selectedAdminUserId = Number(id) || null;
            renderAdminUserList();
            updateAdminUserDetail();
        }

        function upsertAdminUser(user) {
            const index = adminUsers.findIndex((item) => Number(item.id) === Number(user.id));
            if (index >= 0) {
                adminUsers[index] = user;
            } else {
                adminUsers.push(user);
                adminUsers.sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'es', { sensitivity: 'base' }));
            }
        }

        async function loadAdminUsers(options = {}) {
            try {
                const response = await fetch('/api/admin-users');
                if (!response.ok) throw new Error('No fue posible cargar usuarios.');
                adminUsers = await response.json();
                adminUsersLoadedOnce = true;
                const targetId = options.selectedId || selectedAdminUserId || adminUsers[0]?.id || null;
                selectedAdminUserId = adminUsers.some((user) => Number(user.id) === Number(targetId)) ? Number(targetId) : (adminUsers[0]?.id || null);
                renderAdminUserCreateButton();
                populateUserPermissionOptions();
                renderAdminUserList();
                updateAdminUserDetail();
                const currentUser = adminUsers.find((user) => doesStoredSessionMatchUser(user));
                if (currentUser) syncStoredSessionFromUser(currentUser);
            } catch (error) {
                setConfigStatus(error.message || 'No fue posible cargar los usuarios.', true);
                if (userAdminTableBody) {
                    userAdminTableBody.innerHTML = `<tr><td class="user-admin-empty">${escapeHtml(error.message || 'No fue posible cargar los usuarios.')}</td></tr>`;
                }
            }
        }

        function collectAdminUserPayload() {
            const user = getSelectedAdminUser();
            if (!user) return null;
            return {
                password: userAdminFieldPassword?.value || '',
                department: userAdminFieldDepartment?.value?.trim() || '',
                process: userAdminFieldProcess?.value?.trim() || '',
                photoUrl: user.photoUrl || '',
                signatureUrl: user.signatureUrl || '',
                email: userAdminFieldEmail?.value?.trim() || '',
                phone: userAdminFieldPhone?.value?.trim() || '',
                notificationEmail: userAdminFieldNotifyEmail?.checked === true,
                notificationWhatsapp: userAdminFieldNotifyWhatsapp?.checked === true,
                notificationSms: userAdminFieldNotifySms?.checked === true,
                active: user.active !== false,
                permissionId: userAdminFieldPermission?.value ? Number(userAdminFieldPermission.value) : null,
                defaultLanding: normalizeOptionalPresentationKey(userAdminFieldLanding?.value),
                sapSalespersonCode: userAdminFieldSapSalespersonCode?.value ? Number(userAdminFieldSapSalespersonCode.value) : null,
                sapSalespersonName: getSelectedAdminUserSapSalespersonOption()?.salespersonName || ''
            };
        }

        function syncSelectedAdminUserFromInputs() {
            const user = getSelectedAdminUser();
            const payload = collectAdminUserPayload();
            if (!user || !payload) return;
            user.password = payload.password;
            user.department = payload.department;
            user.process = payload.process;
            user.email = payload.email;
            user.phone = payload.phone;
            user.notificationEmail = payload.notificationEmail;
            user.notificationWhatsapp = payload.notificationWhatsapp;
            user.notificationSms = payload.notificationSms;
            user.active = payload.active;
            user.permissionId = payload.permissionId;
            user.defaultLanding = payload.defaultLanding;
            user.permissionName = adminPermissions.find((item) => Number(item.id) === Number(payload.permissionId))?.name || '';
            user.sapSalespersonCode = payload.sapSalespersonCode;
            user.sapSalespersonName = payload.sapSalespersonName;
            renderAdminUserList();
            if (userAdminDetailName) userAdminDetailName.textContent = user.name || 'Usuario';
            if (userAdminDetailSubline) userAdminDetailSubline.textContent = formatAdminUserProcessLine(user);
            if (userAdminDeactivateButton) {
                userAdminDeactivateButton.textContent = user.active === false ? 'Usuario inactivo' : 'Dar de baja';
                userAdminDeactivateButton.disabled = user.active === false;
                userAdminDeactivateButton.classList.toggle('is-inactive', user.active === false);
            }
            renderAdminUserPermissionAccessSummary(user);
        }

        async function persistSelectedAdminUser() {
            const user = getSelectedAdminUser();
            const payload = collectAdminUserPayload();
            if (!user || !payload) return;
            if (!validateSelectedAdminUserSapSalesperson(true)) return;
            const response = await fetch(`/api/admin-users/${user.id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!response.ok) {
                throw new Error('No fue posible guardar el usuario.');
            }
            const saved = await response.json();
            upsertAdminUser(saved);
            renderAdminUserList();
            updateAdminUserDetail();
            syncStoredSessionFromUser(saved);
        }

        function queueAdminUserSave() {
            clearTimeout(adminUserSaveTimer);
            const user = getSelectedAdminUser();
            if (!user) return;
            if (!validateSelectedAdminUserSapSalesperson(false)) return;
            syncSelectedAdminUserFromInputs();
            adminUserSaveTimer = setTimeout(async () => {
                try {
                    await persistSelectedAdminUser();
                } catch (error) {
                    console.error(error);
                    setConfigStatus(error.message || 'No fue posible guardar el usuario.', true);
                }
            }, 350);
        }

        function openAdminUserCreatePopover() {
            if (!userAdminCreatePopover || !userAdminCreateButton) return;
            const rect = userAdminCreateButton.getBoundingClientRect();
            const popoverWidth = 420;
            const left = Math.min(window.innerWidth - popoverWidth - 12, Math.max(12, rect.right - popoverWidth));
            const top = rect.bottom + 10;
            userAdminCreatePopover.style.left = `${left}px`;
            userAdminCreatePopover.style.top = `${top}px`;
            userAdminCreatePopover.hidden = false;
            populateUserPermissionOptions();
            if (userAdminCreateNameField) {
                userAdminCreateNameField.value = '';
            }
            if (userAdminCreateUsernameField) userAdminCreateUsernameField.value = '';
            if (userAdminCreatePasswordField) userAdminCreatePasswordField.value = '';
            if (userAdminCreateDepartmentField) userAdminCreateDepartmentField.value = '';
            if (userAdminCreateProcessField) userAdminCreateProcessField.value = '';
            if (userAdminCreatePermissionField) userAdminCreatePermissionField.value = '';
            requestAnimationFrame(() => userAdminCreateNameField?.focus());
        }

        function closeAdminUserCreatePopover() {
            if (userAdminCreatePopover) userAdminCreatePopover.hidden = true;
        }

        async function createAdminUser() {
            const name = userAdminCreateNameField?.value?.trim() || '';
            const username = userAdminCreateUsernameField?.value?.trim() || '';
            const password = userAdminCreatePasswordField?.value || '';
            if (!name || !username || !password) {
                userAdminCreateNameField?.focus();
                return;
            }
            const response = await fetch('/api/admin-users', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name,
                    username,
                    password,
                    department: userAdminCreateDepartmentField?.value?.trim() || '',
                    process: userAdminCreateProcessField?.value?.trim() || '',
                    permissionId: userAdminCreatePermissionField?.value ? Number(userAdminCreatePermissionField.value) : null
                })
            });
            if (!response.ok) {
                if (response.status === 404) {
                    throw new Error('La API de usuarios no está disponible en este servidor. Reinicia la instancia activa para cargar el backend nuevo.');
                }
                const payload = await response.json().catch(() => ({}));
                throw new Error(payload?.error || 'No fue posible crear el usuario.');
            }
            const created = await response.json();
            upsertAdminUser(created);
            closeAdminUserCreatePopover();
            selectAdminUser(created.id);
            setConfigStatus('Usuario creado correctamente.');
        }

        async function deleteAdminUser(id) {
            const user = adminUsers.find((item) => Number(item.id) === Number(id));
            if (!user) return;
            if (user.active === false) return;
            const accepted = window.confirm(`¿Deseas dar de baja a ${user.name || 'este usuario'}?`);
            if (!accepted) return;
            const response = await fetch(`/api/admin-users/${id}`, { method: 'DELETE' });
            if (!response.ok) {
                throw new Error('No fue posible dar de baja el usuario.');
            }
            const updated = await response.json();
            upsertAdminUser(updated);
            renderAdminUserList();
            updateAdminUserDetail();
            setConfigStatus('Usuario dado de baja correctamente.');
        }

        async function updateAdminUserPhoto(file) {
            const user = getSelectedAdminUser();
            if (!user || !file) return;
            const reader = new FileReader();
            reader.onload = async (event) => {
                user.photoUrl = event.target?.result || '';
                updateAdminUserDetail();
                renderAdminUserList();
                try {
                    await persistSelectedAdminUser();
                } catch (error) {
                    console.error(error);
                }
            };
            reader.readAsDataURL(file);
        }

        async function updateAdminUserSignature(file) {
            const user = getSelectedAdminUser();
            if (!user || !file) return;
            const reader = new FileReader();
            reader.onload = async (event) => {
                user.signatureUrl = event.target?.result || '';
                updateAdminUserDetail();
                renderAdminUserList();
                try {
                    await persistSelectedAdminUser();
                } catch (error) {
                    console.error(error);
                }
            };
            reader.readAsDataURL(file);
        }

        function bindAdminUserEvents() {
            userAdminCreateButton?.addEventListener('click', openAdminUserCreatePopover);
            userAdminCreateCancel?.addEventListener('click', closeAdminUserCreatePopover);
            userAdminCreateConfirm?.addEventListener('click', async () => {
                try {
                    await createAdminUser();
                } catch (error) {
                    console.error(error);
                    setConfigStatus(error.message || 'No fue posible crear el usuario.', true);
                }
            });
            [
                userAdminCreateNameField,
                userAdminCreateUsernameField,
                userAdminCreatePasswordField,
                userAdminCreateDepartmentField,
                userAdminCreateProcessField,
                userAdminCreatePermissionField
            ].forEach((field) => {
                field?.addEventListener('keydown', async (event) => {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        try {
                            await createAdminUser();
                        } catch (error) {
                            console.error(error);
                            setConfigStatus(error.message || 'No fue posible crear el usuario.', true);
                        }
                    }
                });
            });
            document.addEventListener('pointerdown', (event) => {
                if (userAdminCreatePopover?.hidden) return;
                if (userAdminCreatePopover.contains(event.target)) return;
                if (event.target.closest('#userAdminCreateButton')) return;
                closeAdminUserCreatePopover();
            });
            userAdminTableBody?.addEventListener('click', async (event) => {
                const deleteButton = event.target.closest('[data-user-delete]');
                if (deleteButton) {
                    event.stopPropagation();
                    try {
                        await deleteAdminUser(deleteButton.dataset.userDelete);
                    } catch (error) {
                        console.error(error);
                        setConfigStatus(error.message || 'No fue posible dar de baja el usuario.', true);
                    }
                    return;
                }
                const row = event.target.closest('[data-user-id]');
                if (row) {
                    selectAdminUser(row.dataset.userId);
                }
            });
            [
                userAdminFieldPassword,
                userAdminFieldEmail,
                userAdminFieldPhone,
                userAdminFieldNotifyEmail,
                userAdminFieldNotifyWhatsapp,
                userAdminFieldNotifySms,
                userAdminFieldPermission,
                userAdminFieldLanding,
                userAdminFieldSapSalesperson
            ].forEach((field) => {
                field?.addEventListener('input', queueAdminUserSave);
                field?.addEventListener('change', queueAdminUserSave);
            });
            userAdminFieldPermission?.addEventListener('change', () => {
                validateSelectedAdminUserSapSalesperson(false);
                if (currentAdminUserRequiresSapSalesperson() && !sapSalespersonOptionsLoadedOnce) {
                    ensureSapSalespersonOptionsLoaded().catch((error) => {
                        setConfigStatus(error.message || 'No fue posible cargar los vendedores SAP.', true);
                    });
                }
            });
            userAdminFieldSapSalesperson?.addEventListener('change', () => {
                if (userAdminFieldSapSalespersonCode) {
                    userAdminFieldSapSalespersonCode.value = String(userAdminFieldSapSalesperson.value || '').trim();
                }
                validateSelectedAdminUserSapSalesperson(false);
            });
            userAdminDeactivateButton?.addEventListener('click', async () => {
                const user = getSelectedAdminUser();
                if (!user || user.active === false) return;
                try {
                    await deleteAdminUser(user.id);
                } catch (error) {
                    console.error(error);
