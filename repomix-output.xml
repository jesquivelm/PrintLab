        async function prunePartnersForTesting() {
            const target = auditPartnerPruneTargetField?.value || 'socios';
            const mode = auditPartnerPruneModeField?.value || 'keep';
            const targetLabel = target === 'materiales' ? 'materiales' : 'socios';
            const keepCount = Math.max(1, Number(auditPartnerPruneCountField?.value || 0));
            if (mode === 'keep' && (!Number.isFinite(keepCount) || keepCount <= 0)) {
                auditPartnerPruneCountField?.focus();
                throw new Error(`Indica una cantidad válida de ${targetLabel} para conservar.`);
            }
            const confirmationMessage = mode === 'delete_sap'
                ? `Se eliminarán solo los ${targetLabel} identificados como importados desde SAP. Esta acción no se puede deshacer. ¿Deseas continuar?`
                : `Se conservarán solo ${keepCount} ${targetLabel} y se eliminará el resto. Esta acción no se puede deshacer. ¿Deseas continuar?`;
            const accepted = window.confirm(confirmationMessage);
            if (!accepted) return;
            auditPartnerPruneBusy = true;
            if (auditPartnerPruneConfirm) auditPartnerPruneConfirm.disabled = true;
            if (auditPartnerPruneCancel) auditPartnerPruneCancel.disabled = true;
            setAuditPartnerPruneStatus('Procesando datos de validación...', false);
            try {
                const response = await fetch('/api/testing/external-data-admin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        target,
                        mode,
                        keepCount: mode === 'keep' ? keepCount : undefined
                    })
                });
                const payload = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(payload.error || 'No fue posible ejecutar la depuración.');
                }
                closeAuditPartnerPrunePopover();
                setAuditPartnerPruneStatus(payload.message || 'Acción ejecutada correctamente.', false);
            } finally {
                auditPartnerPruneBusy = false;
                if (auditPartnerPruneConfirm) auditPartnerPruneConfirm.disabled = false;
                if (auditPartnerPruneCancel) auditPartnerPruneCancel.disabled = false;
            }
        }

