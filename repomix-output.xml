async function init() {
    try {
        await loadConfig();
        await loadCosts();
        activateTab("general");
    } catch (error) {
        costsState = readLocalCostsConfig();
        renderCosts();
        activateTab("general");
        setSaveStatus(error.message || "No se pudo cargar el módulo.", true);
    }
}

init();
