    visibleMachines.forEach(m => {
      const mOps = machineVisibleOps(m.id_maquina);
      const machineSub = [m.sub_descripcion || '', mOps.length ? `Asignadas ${mOps.length}` : ''].filter(Boolean).join(' · ');
