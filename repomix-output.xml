        if (search) {
            values.push(`%${search}%`);
            values.push(`%${search}%`);
            whereClause = 'WHERE partner_code ILIKE $1 OR partner_name ILIKE $2';
        }

        values.push(limit);

        const result = await pgQuery(
            `SELECT
                partner_code,
                prospect_code,
                partner_name,
                salesperson_name,
                tax_id,
