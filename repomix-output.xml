            padding: 18px 20px;
        }
        .proforma-config-preview .proforma-terms-summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 18px;
        }
        .proforma-config-preview .proforma-terms-item[hidden] {
            display: none;
        }
        .proforma-config-preview .proforma-terms-card[hidden] {
            display: none;
        }
        .proforma-config-preview .proforma-terms-card p {
            margin: 0;
            line-height: 1.7;
            font-size: 13px;
            color: #536273;
            white-space: pre-line;
        }
        .proforma-config-preview .proforma-document-footer {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 20px;
            padding-top: 18px;
            padding-bottom: 10px;
            border-top: none;
            border-bottom: 5px solid #203852;
        }
        .proforma-config-preview .proforma-signature {
            min-width: 220px;
            text-align: center;
        }
        .proforma-config-preview .proforma-signature[hidden] {
            display: none;
        }
        .proforma-config-preview .proforma-signature-asset {
            min-height: 66px;
            border-bottom: 1px solid var(--proforma-navy);
            margin-bottom: 8px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            overflow: hidden;
            padding-bottom: 8px;
        }
        .proforma-config-preview .proforma-signature-asset img {
            max-width: 180px;
            max-height: 60px;
            object-fit: contain;
        }
        .proforma-config-preview .proforma-signature strong {
            display: block;
            color: #111111 !important;
            font-weight: 500;
            opacity: 1;
            text-shadow: none;
        }
        html[data-theme] .proforma-config-preview #docSellerName {
            color: #111111 !important;
            font-weight: 500 !important;
            opacity: 1 !important;
            text-shadow: none !important;
        }
        .proforma-config-preview .proforma-signature span {
            display: block;
            font-size: 12px;
            color: var(--proforma-muted);
        }
        @media (max-width: 1120px) {
            .repository-grid,
            .permission-admin-grid,
            .permission-admin-grid-fields,
            .proforma-config-grid {
                grid-template-columns: 1fr;
            }
            .permission-admin-detail-card {
                min-height: 0;
            }
