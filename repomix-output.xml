]);

const PLANNING_BASE_PROCESS_KEYS = Object.freeze(['rebobinado', 'empaque']);

const PLANNING_PROCESS_LABELS = Object.freeze({
    diseno: 'Diseño',
    preprensa: 'Preprensa',
    visto_bueno: 'Visto bueno',
    planchas: 'Planchas',
    tintas: 'Tintas',
    impresion: 'Impresión',
    acabados: 'Acabados',
    laminado: 'Laminado',
    troquelado: 'Troquelado',
    estampado: 'Estampado',
    barnizado: 'Barniz',
    embosado: 'Embosado',
