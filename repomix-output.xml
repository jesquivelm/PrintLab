                grid-template-columns: 1fr;
            }
            .proforma-preview-sections {
                grid-template-columns: 1fr;
            }
            .proforma-currency-row {
                grid-template-columns: 1fr 1fr;
            }
            .proforma-config-preview {
                --proforma-preview-zoom: 1;
            }
        }
    </style>
</head>
