        const ICON_UNUSED_KEYS = new Set([
            'orderPlanning',
            'orderPlanningRoute',
            'dashboardFabReload'
        ]);

        const ICON_TAB_ORDER = [
            'Dashboard',
            'Notificaciones',
            'Botón flotante',
            'Modulo Movil',
            'General',
            'Cotizaciones',
            'Órdenes',
            'Proforma',
            'Configuración',
            'Cálculo'
        ];

        function resolveIconRuntimeMeta(icon) {
            const key = String(icon?.key || '').trim();
            if (key.startsWith('dashboardFab')) return { tab: 'Botón flotante', section: icon.section || 'Dashboard' };
            if (key.startsWith('notificationChat')) return { tab: 'Notificaciones', section: 'Mensajería' };
            if (key === 'floatingSave' || key === 'processLauncher' || key === 'timelineLauncher') return { tab: 'Botón flotante', section: 'Cálculo' };
            if (key.startsWith('dashboard') || key === 'dashboardTabClose') return { tab: 'Dashboard', section: 'Principal' };
            if (key.startsWith('mobile')) return { tab: 'Modulo Movil', section: 'Principal' };
            if (['topUser', 'quotePrev', 'quoteNext', 'quoteLookup', 'quoteNumberBoldOn', 'quoteNumberBoldOff', 'popoverClose'].includes(key)) return { tab: 'General', section: 'Navegación' };
            if (['browserOpen', 'tableMove', 'tableOpen', 'tableAdd', 'tableActions'].includes(key)) return { tab: 'General', section: 'Tablas' };
            if (['attachmentUpload', 'attachmentDownload', 'attachmentReplace', 'lineAttachments', 'proformaView'].includes(key)) return { tab: 'General', section: 'Adjuntos' };
            if (['lineDelete', 'copyQuoteSend', 'favoriteDocumentOff', 'favoriteDocumentOn', 'refreshCosts'].includes(key)) return { tab: 'General', section: 'Compartido' };
            if (['quoteRequestSubmit', 'quoteRequestAdvanced', 'quoteRequestAttachment', 'quoteRequestRecord', 'quoteRequestRecordStop', 'quoteRequestAttachmentDelete', 'quantity.add', 'quantity.delete'].includes(key)) return { tab: 'Cotizaciones', section: 'Solicitud' };
            if (['lineDuplicate', 'lineCopy', 'lineCreateProduct', 'lineCreateQuote', 'lineExport', 'lineCreateOrder', 'lineCreateProductionOrder', 'quoteExpand', 'quoteCollapse', 'lineReorder', 'lineMenu'].includes(key)) return { tab: 'Cotizaciones', section: 'Líneas' };
            if (key === 'fieldInfo') return { tab: 'Cálculo', section: 'Campos' };
            if (key.startsWith('order')) return { tab: 'Órdenes', section: 'Detalle' };
            if (key === 'proformaClose') return { tab: 'Proforma', section: 'Documento' };
            if (key.startsWith('adminUser') || key.startsWith('adminPermission')) return { tab: 'Configuración', section: 'Usuarios y permisos' };
            if (key.startsWith('loginRepository')) return { tab: 'Configuración', section: 'Repositorio de acceso' };
            if (key.startsWith('proformaCurrency')) return { tab: 'Configuración', section: 'Proforma' };
            return { tab: icon.tab || icon.group || 'General', section: icon.section || '' };
        }

        const ACTIVE_ICON_LIBRARY = ICON_LIBRARY
            .filter((icon, index, source) => !ICON_UNUSED_KEYS.has(icon.key) && source.findIndex((entry) => entry.key === icon.key) === index)
            .map((icon) => {
                const runtimeMeta = resolveIconRuntimeMeta(icon);
                return {
                    ...icon,
                    tab: runtimeMeta.tab,
                    section: runtimeMeta.section,
                    usage: [runtimeMeta.tab, runtimeMeta.section].filter(Boolean).join(' · ')
                };
            })
            .sort((left, right) => {
                const leftTabIndex = ICON_TAB_ORDER.indexOf(left.tab);
                const rightTabIndex = ICON_TAB_ORDER.indexOf(right.tab);
                const tabDiff = (leftTabIndex === -1 ? 999 : leftTabIndex) - (rightTabIndex === -1 ? 999 : rightTabIndex);
                if (tabDiff) return tabDiff;
                const sectionDiff = String(left.section || '').localeCompare(String(right.section || ''), 'es');
                if (sectionDiff) return sectionDiff;
                return String(left.label || '').localeCompare(String(right.label || ''), 'es');
            });

        function firstFilled(...values) {
            for (const value of values) {
                if (value !== undefined && value !== null && value !== '') {
                    return value;
                }
            }
            return '';
        }

        function repairUtf8Text(value) {
            if (typeof value !== 'string' || !value) return value;
            let repaired = value;
            for (let index = 0; index < 2; index += 1) {
                try {
                    const nextValue = decodeURIComponent(escape(repaired));
                    if (!nextValue || nextValue === repaired) break;
                    repaired = nextValue;
                } catch (error) {
                    break;
                }
            }
            return repaired;
        }

        function fixCommonTextArtifacts(value) {
            if (typeof value !== 'string') return value;
            return repairUtf8Text(value)
                .replace(/Configuracion/g, 'Configuración')
                .replace(/Titulo General/g, 'Título General')
                .replace(/Pie de pagina/g, 'Pie de página')
                .replace(/Tamano/g, 'Tamaño')
                .replace(/Linea/g, 'Línea')
                .replace(/Busqueda/g, 'Búsqueda')
                .replace(/Menu/g, 'Menú');
        }

        function normalizeUiTextArtifacts(root = document) {
            const walker = document.createTreeWalker(root.body || root, NodeFilter.SHOW_TEXT);
            const textNodes = [];
            while (walker.nextNode()) {
                textNodes.push(walker.currentNode);
            }
            textNodes.forEach((node) => {
                const fixed = fixCommonTextArtifacts(node.nodeValue);
                if (fixed !== node.nodeValue) node.nodeValue = fixed;
            });

            root.querySelectorAll('[title],[placeholder],[aria-label],[data-icons]').forEach((el) => {
                ['title', 'placeholder', 'aria-label', 'data-icons'].forEach((attr) => {
                    if (!el.hasAttribute(attr)) return;
                    const current = el.getAttribute(attr);
                    const fixed = fixCommonTextArtifacts(current);
                    if (fixed !== current) el.setAttribute(attr, fixed);
                });
            });

            root.querySelectorAll('input[type="text"], input[type="search"], input[type="button"], button, option, select').forEach((el) => {
                if ('value' in el && typeof el.value === 'string') {
                    const fixedValue = fixCommonTextArtifacts(el.value);
                    if (fixedValue !== el.value) el.value = fixedValue;
                }
                if (el.textContent) {
                    const fixedText = fixCommonTextArtifacts(el.textContent);
                    if (fixedText !== el.textContent) el.textContent = fixedText;
                }
            });

            const titleEl = document.querySelector('title');
            if (titleEl) titleEl.textContent = fixCommonTextArtifacts(titleEl.textContent);
        }

        function toIconSuffix(key) {
            return String(key || '')
                .split(/[.\s_-]+/)
                .filter(Boolean)
                .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                .join('');
        }

        function ensureDieShapeConfigFields() {
            const mount = document.getElementById('dieShapeConfigGrid');
            if (!mount) return;
            const defaults = [
                { index: 1, label: 'Circular' },
                { index: 2, label: 'Cuadrado' },
                { index: 3, label: 'Rectangular' },
                { index: 4, label: 'Ovalado' },
                { index: 5, label: 'Especial' }
            ];

            defaults.forEach((item) => {
                let block = mount.querySelector(`[data-die-shape-item="${item.index}"]`);
                if (block) return;
                block = document.createElement('div');
                block.className = 'die-shape-config-item';
                block.dataset.dieShapeItem = String(item.index);
                block.innerHTML = `
                    <div id="dieShapePreview${item.index}" class="die-shape-preview">Subir imagen</div>
                    <label>
                        <span>Nombre</span>
                        <input name="general.dieShapeLabel${item.index}" type="text" value="${item.label}" placeholder="Nombre de la forma" autocomplete="off">
                    </label>
                    <input name="general.dieShapeImage${item.index}" type="hidden" value="">
                    <input data-die-shape-upload="general.dieShapeImage${item.index}" type="file" accept="image/png,image/svg+xml,image/jpeg,image/webp" hidden>
                `;
                mount.appendChild(block);
            });
        }

        function applyDieShapePreviews() {
            const defaults = [
                { index: 1, label: 'Circular' },
                { index: 2, label: 'Cuadrado' },
                { index: 3, label: 'Rectangular' },
                { index: 4, label: 'Ovalado' },
                { index: 5, label: 'Especial' }
            ];

            defaults.forEach((item) => {
                const preview = document.getElementById(`dieShapePreview${item.index}`);
                const imageInput = document.querySelector(`[name="general.dieShapeImage${item.index}"]`);
                const imageValue = loadedConfig.general?.[`dieShapeImage${item.index}`] || imageInput?.value || '';
                const labelValue = loadedConfig.general?.[`dieShapeLabel${item.index}`] || document.querySelector(`[name="general.dieShapeLabel${item.index}"]`)?.value || item.label;
                if (!preview) return;
                if (imageValue) {
                    preview.innerHTML = `<img src="${imageValue}" alt="${labelValue}">`;
                } else {
                    preview.textContent = labelValue || 'Subir imagen';
                }
            });
        }

        function bindDieShapeUploadHandlers() {
            document.querySelectorAll('[data-die-shape-upload]').forEach((uploadInput) => {
                if (uploadInput.dataset.dieShapeUploadBound === 'true') return;
                const targetName = uploadInput.dataset.dieShapeUpload;
                
                uploadInput.addEventListener('change', (event) => {
                    const file = event.target.files?.[0];
                    const textInput = document.querySelector(`[name="${targetName}"]`);
                    const preview = uploadInput.closest('.die-shape-config-item')?.querySelector('.die-shape-preview');
                    if (!file || !textInput) return;
                    
                    const reader = new FileReader();
                    reader.onload = async (loadEvent) => {
                        const dataUrl = loadEvent.target?.result || '';
                        let finalDataUrl = dataUrl;

                        // Compresión de imagen para evitar Payload Too Large (413)
                        try {
                            const isSvg = file.type === 'image/svg+xml';
                            if (!isSvg && dataUrl.startsWith('data:image/')) {
                                finalDataUrl = await new Promise((resolve) => {
                                    const img = new Image();
                                    img.onload = () => {
                                        const MAX_SIZE = 400; // Tamaño suficiente para una forma de troquel
                                        let width = img.width;
                                        let height = img.height;
                                        if (width > MAX_SIZE || height > MAX_SIZE) {
                                            if (width > height) {
                                                height *= MAX_SIZE / width;
                                                width = MAX_SIZE;
                                            } else {
                                                width *= MAX_SIZE / height;
                                                height = MAX_SIZE;
                                            }
                                        }
                                        const canvas = document.createElement('canvas');
                                        canvas.width = width;
                                        canvas.height = height;
                                        const ctx = canvas.getContext('2d');
                                        ctx.drawImage(img, 0, 0, width, height);
                                        // WebP a 0.85 ofrece gran calidad y muy poco peso
                                        resolve(canvas.toDataURL('image/webp', 0.85));
                                    };
                                    img.src = dataUrl;
                                });
                            }
                        } catch (e) {
                            console.error('Error al comprimir forma de troquel:', e);
                        }

                        textInput.value = finalDataUrl;
                        if (preview) {
                            preview.innerHTML = `<img src="${finalDataUrl}" alt="Forma de troquel" style="width:100%; height:100%; object-fit:contain; border-radius:12px; padding:4px; box-sizing:border-box;">`;
                        }
                        queueConfigSave();
                    };
                    reader.readAsDataURL(file);
                });

                const preview = uploadInput.closest('.die-shape-config-item')?.querySelector('.die-shape-preview');
                preview?.addEventListener('click', () => uploadInput.click());
                uploadInput.dataset.dieShapeUploadBound = 'true';
            });
        }

        function getOrCreateIconGroup(row, groupName) {
            let group = row.querySelector(`[data-icon-group="${groupName}"]`);
            if (group) return group;
            group = document.createElement('section');
            group.className = 'icon-group';
            group.dataset.iconGroup = groupName;
            group.innerHTML = `
                <h3 class="icon-group-title">${groupName}</h3>
                <div class="icon-group-content"></div>
            `;
            row.appendChild(group);
            return group;
        }

        function getOrCreateIconSection(row, groupName, sectionName = '') {
            const group = getOrCreateIconGroup(row, groupName);
            const content = group.querySelector('.icon-group-content');
            const normalizedSection = String(sectionName || '').trim();
            const sectionKey = normalizedSection || '__default__';
            let section = content?.querySelector(`[data-icon-section="${sectionKey}"]`);
            if (section) return section.querySelector('.icon-group-grid');
            section = document.createElement('section');
            section.className = 'icon-subgroup';
            section.dataset.iconSection = sectionKey;
            section.innerHTML = `
                ${normalizedSection ? `<h4 class="icon-subgroup-title">${normalizedSection}</h4>` : ''}
                <div class="icon-group-grid"></div>
            `;
            content?.appendChild(section);
            return section.querySelector('.icon-group-grid');
        }

        function ensureIconLibraryShell(row) {
            const host = document.getElementById('generalIconsSection') || document.getElementById('iconsTabMount');
            if (!host) return row;
            let shell = host.querySelector('.icon-library-shell');
            let tabs = host.querySelector('.icon-library-tabs');
            let panels = host.querySelector('.icon-library-panels');
            if (!shell) {
                shell = document.createElement('div');
                shell.className = 'icon-library-shell';
                tabs = document.createElement('div');
                tabs.className = 'icon-library-tabs';
                panels = document.createElement('div');
                panels.className = 'icon-library-panels';
                shell.appendChild(tabs);
                shell.appendChild(panels);
                host.appendChild(shell);
            }
            if (row.parentElement !== panels) {
                panels.appendChild(row);
            }
            row.dataset.iconRow = 'true';
            return row;
        }

        function syncIconLibraryTabs(row) {
            const host = document.getElementById('generalIconsSection') || document.getElementById('iconsTabMount');
            const tabsHost = host?.querySelector('.icon-library-tabs');
            if (!row || !tabsHost) return;
            const groups = [...row.querySelectorAll('.icon-group')];
