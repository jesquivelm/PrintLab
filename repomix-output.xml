.sap-config-field{display:grid;gap:6px;min-width:0}
.sap-config-field span{font-size:12px;font-weight:700;color:#28465c}
.sap-config-status-row{display:flex;flex-wrap:wrap;gap:8px}
.sap-config-pill{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:#edf7fb;color:#17506c;font-size:12px;font-weight:700}
.sap-config-pill[data-tone="demo"]{background:#eef9f0;color:#1d6b3c}
.sap-config-pill[data-tone="live"]{background:#e8f1fb;color:#0e5c94}
