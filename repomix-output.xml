.production-flow-compare-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}
.production-flow-compare-title strong {
    font-size: 13px;
    color: #0f1117;
}
.production-flow-compare-grid {
    display: grid;
