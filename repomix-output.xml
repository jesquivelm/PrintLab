    align-items: center;
    justify-content: center;
    border: 2px solid #dde0ed;
    color: #9499b0;
    background: #f6f7fb;
    font-size: 15px;
    font-weight: 700;
    z-index: 1;
}
.production-flow-step.is-active .production-flow-marker {
    border-color: #bfcffe;
    color: #2563eb;
    background: #eff4ff;
}
.production-flow-step.is-stopped .production-flow-marker {
    border-color: #fecaca;
    color: #dc2626;
    background: #fef2f2;
}
.production-flow-step.is-done .production-flow-marker {
    border-color: #a7f3d0;
    background: #059669;
    color: #fff;
}
.production-flow-copy {
