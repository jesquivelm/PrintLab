  color: var(--accent);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.output-copy {
  display: none;
}

.output-image-frame {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 0;
  height: 100%;
}

.output-image {
  display: block;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.process-card {
  position: relative;
}

.process-card summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 14px 52px 14px 16px;
  cursor: pointer;
}

.process-card summary::-webkit-details-marker {
  display: none;
}

.process-card summary strong {
  display: block;
  margin-bottom: 4px;
}

.process-card summary .process-summary-alert {
  display: block;
  margin-top: 4px;
  color: #d03535;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;
}

.process-card summary em {
  font-style: normal;
  color: var(--accent);
  font-weight: 700;
}

.process-summary-main {
  min-width: 0;
}

.process-summary-side {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  justify-content: flex-end;
  min-width: 132px;
}

.process-summary-side em,
.subprocess-summary-side em {
  min-width: 88px;
  text-align: right;
  font-style: normal;
}

.process-remove-button {
  position: absolute;
  right: 12px;
  bottom: 12px;
  width: 34px;
  height: 34px;
  border: 0;
  background: transparent;
  color: var(--process-delete-icon-color, var(--danger));
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
}

.process-remove-button:hover {
  color: var(--process-delete-icon-hover, var(--process-delete-icon-color, var(--danger)));
}

.process-remove-button .process-delete-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--process-delete-icon-size, 18px);
  height: var(--process-delete-icon-size, 18px);
  font-size: var(--process-delete-icon-size, 18px);
  line-height: 1;
  font-weight: 400;
}

.process-body {
  border-top: 1px solid #edf1f5;
  padding: 16px 16px 56px;
  display: grid;
  gap: 12px;
}

.subprocess-card {
  position: relative;
  padding: 0;
  overflow: hidden;
  border-radius: 14px;
}

.subprocess-summary,
.inline-process-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 16px;
  cursor: pointer;
  list-style: none;
}

.subprocess-summary-side {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  justify-content: flex-end;
  min-width: 132px;
}

.subprocess-summary-side em {
  color: #0b81b8;
  font-style: normal;
  font-weight: 800;
}

.subprocess-summary::-webkit-details-marker,
.inline-process-summary::-webkit-details-marker {
  display: none;
}

.subprocess-summary strong,
.inline-process-summary strong,
.inline-process-heading {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.subprocess-body {
  padding-top: 14px;
}

.inline-process-card {
  border-radius: 14px;
}

.inline-process-card .process-body {
  padding-top: 6px;
}

.process-summary-main strong {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.process-title-help {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.process-info-anchor {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 8px;
}

.process-card > .process-body > .process-info-anchor {
  display: none;
}

.process-card:has(.process-remove-button) > .process-body > .process-info-anchor {
  display: none;
}

.formula-help {
  display: inline-flex;
  flex: 0 0 auto;
}

.formula-help {
  width: calc(var(--info-icon-size, 13px) + 8px);
  height: calc(var(--info-icon-size, 13px) + 8px);
}

.compact-top {
  margin-top: 2px;
}

.metric-cell {
  padding: 11px 12px;
  border: 1px solid #e7edf2;
  border-radius: 14px;
  background: #fbfdff;
}

.metric-cell span,
.metric-cell strong {
  display: block;
}

.metric-cell span {
  margin-bottom: 4px;
  font-size: 0.78rem;
}

.metric-cell strong {
  font-size: 0.95rem;
}

.metric-cell-required {
  border-color: #d03535;
  background: #fff7f7;
}

.metric-cell-required span,
.metric-cell-required strong {
  color: #a74343;
}

.metric-cell-alert {
  border-color: #d03535;
  background: #fff2f2;
}

.metric-cell-alert span,
.metric-cell-alert strong {
  color: #a74343;
}

.formula-block {
  padding: 12px 14px;
  border: 1px solid #e7edf2;
  border-radius: 14px;
  background: var(--accent-soft);
}

.formula-block p {
  margin: 8px 0 0;
  line-height: 1.45;
}

.formula-issues {
  padding: 12px 14px;
  border: 1px solid rgba(208, 53, 53, 0.24);
  border-radius: 14px;
  background: #fff7f7;
  color: #8f2f2f;
}

.formula-issues strong {
  display: block;
  margin-bottom: 8px;
}

.formula-issues ul {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 4px;
}

.summary-rows {
  display: grid;
  gap: 10px;
  min-width: 0;
}

#sapPreviewSummary {
  margin-bottom: 14px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding-top: 10px;
  border-top: 1px solid #edf1f5;
}

.summary-row:first-child {
  padding-top: 0;
  border-top: 0;
}

.summary-row strong {
  text-align: right;
}

.summary-row-value {
  text-align: right;
  font-weight: 400;
  color: var(--text);
  overflow-wrap: anywhere;
  word-break: break-word;
}

.formula-pre {
  margin: 0;
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(15, 23, 42, 0.04);
  color: var(--text);
  font: 12px/1.45 Consolas, "Courier New", monospace;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
  max-height: 320px;
  overflow: auto;
  scrollbar-gutter: stable both-edges;
  scrollbar-width: thin;
  scrollbar-color: rgba(11, 129, 184, 0.55) rgba(148, 163, 184, 0.16);
}

.formula-pre::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.formula-pre::-webkit-scrollbar-track {
  background: rgba(148, 163, 184, 0.14);
  border-radius: 999px;
}

.formula-pre::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(11, 129, 184, 0.78) 0%, rgba(11, 129, 184, 0.48) 100%);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;
}

.formula-pre::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, rgba(11, 129, 184, 0.92) 0%, rgba(11, 129, 184, 0.62) 100%);
  background-clip: padding-box;
}

.table-toolbar {
  display: flex;
  justify-content: flex-end;
}

.additional-table {
  display: grid;
  gap: 8px;
}

.additional-head,
.additional-row {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(132px, 0.45fr) minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
}

.additional-head {
  font-size: 0.78rem;
  color: var(--muted);
}

.additional-item {
  display: grid;
  gap: 10px;
}

.additional-attachments-card {
  display: grid;
  gap: 10px;
  padding: 12px;
  border: 1px solid #d9e3eb;
  border-radius: 14px;
  background: linear-gradient(180deg, #fff 0%, #f6fbfd 100%);
}

.additional-attachment-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.additional-icon-action,
.additional-attachment-remove {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: var(--icon-color, #1e516d);
  cursor: pointer;
  transition: transform 0.16s ease, color 0.16s ease, filter 0.16s ease;
}

.additional-icon-action:hover,
.additional-attachment-remove:hover {
  color: var(--icon-hover-color, var(--icon-color, #0b81b8));
  filter: drop-shadow(0 6px 12px rgba(11, 129, 184, 0.18));
  transform: translateY(-1px);
}

.additional-icon-action input[type="file"] {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.additional-attachment-list {
  display: grid;
  gap: 8px;
}

.additional-attachment-empty {
  padding: 10px 12px;
  border: 1px dashed #cad8e3;
  border-radius: 12px;
  background: #fff;
  color: #7b8f9f;
  font-size: 0.82rem;
}

.additional-attachment-card {
  display: grid;
  grid-template-columns: 76px minmax(0, 1fr) 32px;
  align-items: center;
  gap: 10px;
  min-height: 72px;
  padding: 10px;
  border: 1px solid #d8e2ea;
  border-radius: 14px;
  background: #fff;
}

.additional-attachment-filetile {
  display: grid;
  place-items: center;
  gap: 2px;
  min-height: 52px;
  padding: 8px;
  border: 1px solid #dbe6ee;
  border-radius: 12px;
  background: linear-gradient(180deg, #fbfdff 0%, #f2f7fb 100%);
  color: #7890a3;
  text-align: center;
}

.additional-attachment-filetile strong {
  max-width: 100%;
  overflow: hidden;
  color: #587084;
  font-size: 0.72rem;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.additional-attachment-filetile span,
.additional-attachment-size {
  color: #94a3af;
  font-size: 0.72rem;
}

.additional-attachment-body {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.additional-attachment-name {
  overflow: hidden;
  color: #587084;
  font-size: 0.84rem;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.additional-attachment-icon,
.additional-attachment-delete-icon {
  width: var(--config-icon-size, 18px);
  height: var(--config-icon-size, 18px);
  font-size: var(--config-icon-size, 18px);
  line-height: 1;
}

.macula-table {
  display: grid;
  gap: 8px;
}

.macula-table-row {
  display: grid;
  grid-template-columns: 1.6fr 0.85fr 0.95fr 0.95fr;
  gap: 8px;
  align-items: center;
}

.macula-table-row-short {
  grid-template-columns: 1.8fr 0.8fr;
}

.macula-table-head {
  font-size: 0.78rem;
  color: var(--muted);
}

.macula-empty {
  color: var(--muted);
  font-size: 0.86rem;
  padding: 4px 0 2px;
}

.ink-profile-table {
  display: grid;
  gap: 8px;
}

.ink-profile-row {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(96px, 0.8fr));
  gap: 8px;
  align-items: center;
}

.ink-profile-head {
  font-size: 0.78rem;
  color: var(--muted);
}

@media (max-width: 1260px) {
  .calc-layout {
    grid-template-columns: 1fr;
  }

  .calc-sidebar {
    position: static;
  }

  .header-grid,
  .technical-grid,
  .editable-grid,
  .readonly-grid,
  .quantity-row,
  .macula-table-row,
  .macula-table-row-short {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ink-profile-row {
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(72px, 0.7fr));
  }

  .process-layout-print,
  .process-layout-inline,
  .process-kpi-grid,
  .process-print-grid {
    grid-template-columns: 1fr;
  }

  .print-stage-expanded-blocks .process-print-grid,
  .print-stage-expanded-blocks .process-kpi-grid-macula {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .impression-grid-compact {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .impression-check-row {
    grid-column: 1 / -1;
    justify-content: center;
    margin-top: 2px;
    flex-wrap: wrap;
  }

  .process-finish-grid {
    grid-template-columns: 1fr;
  }

  .output-layout {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .output-core-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plate-metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}

@media (max-width: 860px) {
  .front-back-element-tabs {
    grid-template-columns: 1fr;
  }

  .front-back-group-note {
    align-items: stretch;
    flex-direction: column;
  }
}

@media (max-width: 860px) {
  .process-launcher-shell {
    left: 12px;
    top: auto;
    bottom: 18px;
  }

  .process-launcher-menu {
    width: min(340px, calc(100vw - 24px));
    grid-template-columns: 1fr;
    padding: 8px 10px;
  }

  .process-launcher-bridge {
    top: calc(100% + 12px);
    left: 0;
    right: auto;
    width: min(340px, calc(100vw - 24px));
    grid-template-columns: 1fr;
    border-radius: 20px;
  }

  .process-launcher-primary.launcher-menu-left .process-launcher-bridge,
  .process-launcher-primary.launcher-menu-right .process-launcher-bridge {
    left: 0;
    right: auto;
    grid-template-columns: 1fr;
  }

  .process-launcher-primary.launcher-menu-left .process-launcher-button[aria-expanded="true"],
  .process-launcher-primary.launcher-menu-right .process-launcher-button[aria-expanded="true"] {
    border-radius: 18px;
  }

  .process-launcher-label {
    padding: 10px 12px 2px;
  }

  .process-launcher-primary.launcher-menu-left .process-launcher-menu,
  .process-launcher-primary.launcher-menu-right .process-launcher-menu {
    padding: 0 10px 10px;
  }

  .process-launcher-primary.launcher-menu-left .process-launcher-label,
  .process-launcher-primary.launcher-menu-right .process-launcher-label {
    padding: 10px 12px 2px;
  }

  .timeline-launcher-panel {
    width: min(300px, calc(100vw - 24px));
  }

  .header-grid,
  .technical-grid,
  .impression-grid-compact,
  .output-layout,
  .output-core-grid {
    grid-template-columns: 1fr;
  }

  .impression-check-row {
    justify-content: flex-start;
    margin-top: 0;
    gap: 14px;
  }

  .output-layout {
    grid-template-areas:
      "core"
      "output"
      "roll"
      "application"
      "preview";
  }
}

@media (max-width: 720px) {
  .process-launcher-button {
    min-width: 54px;
    min-height: 54px;
    padding: 10px 12px;
  }

  .calc-shell {
    width: min(100% - 16px, 1540px);
  }

  .calc-toolbar,
  .card-head {
    flex-direction: column;
    align-items: stretch;
  }

  .panel-grid,
  .editable-grid,
  .readonly-grid,
  .plate-metrics-grid,
  .commercial-grid,
  .impression-grid,
  .toggle-row,
  .additional-head,
  .additional-row {
    grid-template-columns: 1fr;
  }

  .additional-attachment-card {
    grid-template-columns: 64px minmax(0, 1fr) 32px;
  }

  .span-2 {
    grid-column: auto;
  }

  .span-3 {
    grid-column: auto;
  }

  .span-4 {
    grid-column: auto;
  }
}

/* Shared dark mode coverage for the integrated flexography calculator. */
html[data-theme="dark"] .calc-toolbar,
html[data-theme="dark"] .calc-card,
html[data-theme="dark"] .process-card,
html[data-theme="dark"] .subprocess-card,
html[data-theme="dark"] .technical-panel,
html[data-theme="dark"] .formula-block,
html[data-theme="dark"] .process-launcher-menu,
html[data-theme="dark"] .process-picker-panel,
html[data-theme="dark"] .timeline-launcher-panel,
html[data-theme="dark"] .plate-detail-panel,
html[data-theme="dark"] .plate-summary-card,
html[data-theme="dark"] .modal-panel,
html[data-theme="dark"] .import-plate-popover-panel {
  background: var(--card);
  color: var(--text);
  border-color: var(--line);
  box-shadow: var(--shadow);
}

html[data-theme="dark"] .floating-action-button,
html[data-theme="dark"] .floating-action-icon-button.is-active,
html[data-theme="dark"] .toolbar-link,
html[data-theme="dark"] .inline-button,
html[data-theme="dark"] .quantity-add-button,
html[data-theme="dark"] .plate-action-button,
html[data-theme="dark"] .process-option,
html[data-theme="dark"] .subprocess-toggle {
  background: color-mix(in srgb, var(--card) 88%, var(--accent-soft));
  color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
}

html[data-theme="dark"] .floating-action-button:hover,
html[data-theme="dark"] .floating-action-button:focus-visible,
html[data-theme="dark"] .toolbar-link:hover,
html[data-theme="dark"] .toolbar-link:focus-visible,
html[data-theme="dark"] .inline-button:hover,
html[data-theme="dark"] .inline-button:focus-visible,
html[data-theme="dark"] .quantity-add-button:hover,
html[data-theme="dark"] .quantity-add-button:focus-visible,
html[data-theme="dark"] .plate-action-button:hover,
html[data-theme="dark"] .plate-action-button:focus-visible {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}

html[data-theme="dark"] .process-picker-item {
  background: color-mix(in srgb, var(--card) 94%, var(--accent-soft));
  color: var(--text);
  border-color: color-mix(in srgb, var(--accent) 18%, var(--line));
}

html[data-theme="dark"] .process-picker-item:hover:not(:disabled),
html[data-theme="dark"] .process-picker-item:focus-visible:not(:disabled) {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}

html[data-theme="dark"] .process-sections {
  border-color: color-mix(in srgb, var(--accent) 18%, var(--line));
  background: linear-gradient(180deg, #223042 0%, #1a2535 100%);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 14px 28px rgba(0, 0, 0, 0.2);
}

html[data-theme="dark"] .process-sections.is-drop-target {
  outline-color: color-mix(in srgb, var(--accent) 58%, transparent);
}

html[data-theme="dark"] .process-sections-empty {
  border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
  background: linear-gradient(180deg, #223042 0%, #182435 100%);
  color: color-mix(in srgb, var(--muted) 92%, #d7e4f3);
}

html[data-theme="dark"] .process-card summary .process-summary-alert {
  color: #fde68a;
}

html[data-theme="dark"] label span,
html[data-theme="dark"] .card-head p,
html[data-theme="dark"] .toolbar-customer-name,
html[data-theme="dark"] .toolbar-salesperson-name,
html[data-theme="dark"] .muted,
html[data-theme="dark"] .process-card-meta,
html[data-theme="dark"] .subprocess-card-meta,
html[data-theme="dark"] .timeline-item-meta,
html[data-theme="dark"] .quantity-caption,
html[data-theme="dark"] .plate-field-caption {
  color: var(--muted);
}

html[data-theme="dark"] h1,
html[data-theme="dark"] h2,
html[data-theme="dark"] h3,
html[data-theme="dark"] h4,
html[data-theme="dark"] .process-card-title,
html[data-theme="dark"] .subprocess-card-title,
html[data-theme="dark"] .plate-summary-value {
  color: var(--text);
}

html[data-theme="dark"] input,
html[data-theme="dark"] select,
html[data-theme="dark"] textarea,
html[data-theme="dark"] .select-shell,
html[data-theme="dark"] .output-type-preview,
html[data-theme="dark"] .quantity-item,
html[data-theme="dark"] .formula-row,
html[data-theme="dark"] .cost-row,
html[data-theme="dark"] .price-row,
html[data-theme="dark"] .plate-field,
html[data-theme="dark"] .plate-upload-zone {
  background: color-mix(in srgb, var(--card) 78%, var(--bg));
  color: var(--text);
  border-color: var(--line);
}

html[data-theme="dark"] input:focus,
html[data-theme="dark"] select:focus,
html[data-theme="dark"] textarea:focus {
  background: var(--card);
  color: var(--text);
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
  outline: none;
}

html[data-theme="dark"] .process-launcher-label,
html[data-theme="dark"] .timeline-launcher-label,
html[data-theme="dark"] .output-badge,
html[data-theme="dark"] .pill,
html[data-theme="dark"] code {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 24%, var(--line));
}

html[data-theme="dark"] .modal-backdrop,
html[data-theme="dark"] .import-plate-popover-backdrop {
  background: rgba(2, 6, 23, 0.78);
}

html[data-theme="dark"] .error,
html[data-theme="dark"] .field-error,
html[data-theme="dark"] .inline-button.danger {
  color: #fecaca;
}

html[data-theme="dark"] .error-box,
html[data-theme="dark"] .warning-box {
  background: rgba(248, 113, 113, 0.14);
  color: #fecaca;
