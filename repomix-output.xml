<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="/theme.js"></script>
  <script>
    (function () {
      try {
        if (new URLSearchParams(window.location.search).get("embedded") === "1") {
          document.documentElement.classList.add("is-front-back-embedded-early");
        }
      } catch (_) {}
    })();
  </script>
  <title>Cálculo de Flexografía</title>
  <link rel="stylesheet" href="/styles.css?v=20260519-1810">
  <link rel="stylesheet" href="/calculo-flexografia/styles.css?v=20260519-1810">
</head>
<body>
  <main class="calc-shell">
    <section class="calc-toolbar">
        <div class="calc-toolbar-brand">
          <div class="toolbar-brand-copy">
            <h1 id="pageTitle">Cálculo de Flexografía</h1>
          <div id="customerNameDisplay" class="toolbar-customer-name" hidden></div>
          <div id="salespersonDisplay" class="toolbar-salesperson-name"></div>
          </div>
        </div>
    </section>

    <div class="calc-layout">
      <section class="calc-main">
        <article class="calc-card">
          <div class="card-head">
            <div><h2>Información General</h2></div>
          </div>

          <div class="header-grid">
            <input id="customerCode" class="hidden-input" type="hidden">
            <input id="customerName" class="hidden-input" type="hidden">
            <input id="salespersonName" class="hidden-input" type="hidden">

            <label class="header-field-job">
              <span>Nombre del Trabajo</span>
              <input id="jobName" type="text">
            </label>

            <div class="header-field-meta">
              <label class="header-field-work">
                <span>Tipo de Trabajo</span>
                <select id="workType"></select>
              </label>

              <label class="header-field-product">
                <span>Tipo de Producto</span>
                <select id="productType"></select>
              </label>
            </div>
          </div>
        </article>

        <article id="frontBackElementsCard" class="calc-card front-back-elements-card" hidden>
          <div class="card-head">
            <div><h2>Elementos Frente/Dorso</h2></div>
          </div>
          <div id="frontBackElementsBody" class="front-back-elements-body"></div>
        </article>

        <article id="technicalDataCard" class="calc-card">
          <div class="card-head">
            <div><h2>Datos Técnicos</h2></div>
          </div>

          <div class="technical-grid">
            <div class="technical-column technical-column-left">
