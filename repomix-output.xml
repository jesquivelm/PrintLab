        function formatSapMirrorProcedure(procedure = {}) {
            const request = procedure.request || {};
            const connector = procedure.connector || {};
            const connectorLines = connector.provider
                ? [
                    '',
                    `Estado conector: ${connector.ok === false || procedure.connectorUsesLocalSource ? 'ERROR' : 'OK'}`,
                    `Fuente conector: ${connector.dataSource || connector.raw?.dataSource || ''}`,
                    `Conteo reportado: socios=${connector.businessPartners ?? connector.raw?.businessPartners ?? ''} artículos=${connector.items ?? connector.raw?.items ?? ''} órdenes=${connector.orders ?? connector.raw?.orders ?? ''}`
                ]
                : [];
            const lines = [
                `Proceso: ${procedure.label || ''}`,
                `Proveedor: ${procedure.provider || ''}`,
                `Endpoint interno: ${procedure.endpoint || ''}`,
                `Servicio SAP: ${request.method || ''} ${request.url || ''}`,
                `Tablas destino: ${(procedure.targetTables || []).join(', ')}`,
                ...connectorLines,
                '',
                request.query ? `Parámetros enviados:\n${JSON.stringify(request.query, null, 2)}` : `Payload enviado:\n${JSON.stringify(request.payload || {}, null, 2)}`,
                '',
                `Consulta / Escritura SAP:\n${procedure.queryText || ''}`,
                ...(Array.isArray(procedure.relatedSql) && procedure.relatedSql.length ? ['', `Consultas relacionadas:\n${procedure.relatedSql.join('\n')}`] : [])
            ];
            return lines.join('\n');
        }

        async function refreshSapMirrorProcedure() {
            if (!sapMirrorQueryPreview) return;
            const payload = getSapMirrorProcessPayload();
            setSapResult(sapMirrorQueryPreview, 'Cargando procedimiento SAP...');
            const response = await fetch('/api/sap/mirror/preview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ...payload, limit: payload.limit || 1 })
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(data.error || 'No fue posible cargar la consulta SAP.');
            sapMirrorQueryPreview.textContent = formatSapMirrorProcedure(data.procedure || {});
            if (sapMirrorProcessHint) {
                const records = Number(data.records || 0);
                sapMirrorProcessHint.textContent = data.blocked
                    ? 'Error en la consulta.'
                    : data.procedure?.direction === 'import'
                    ? ''
                    : '';
            }
            return data;
        }

