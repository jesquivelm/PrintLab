.production-flow-compare-grid span {
    font-size: 11px;
    font-weight: 700;
    color: #9499b0;
}
.production-flow-compare-grid strong {
    font-size: 13px;
    color: #0f1117;
}
.production-flow-compare-grid em {
    font-size: 11px;
    color: #5c6078;
    font-style: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.production-flow-compare-grid .is-over {
    color: #dc2626;
}
.socios-table-wrap {
    overflow: auto;
    border: 1px solid #e1e8ee;
    border-radius: 16px;
    background: #fff;
}
