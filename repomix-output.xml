                }] : []);

            for (const address of partnerAddresses) {
                if (address.addressLine || address.country || address.stateProvince || address.county) {
                await client.query(
                    `INSERT INTO business_partner_addresses (
                        partner_code,
                        address_name,
                        address_type,
