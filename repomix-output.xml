</head>
<body>

<div id="error-bar" class="error-bar">
  ⚠ <span id="error-msg">No se pudo conectar a la API</span>
  <button class="btn" style="margin-left:auto" onclick="loadFromAPI()">Reintentar</button>
</div>

<div id="app"><div class="loading"><div class="spinner"></div> Cargando órdenes...</div></div>

<div class="tt" id="tt">
  <div class="tt-title" id="tt-t"></div>
  <div class="tt-cliente" id="tt-c"></div>
  <div id="tt-b"></div>
</div>

<div class="dp" id="dp">
  <div class="dp-title">
    <span id="dp-title-txt">Detalle OP</span>
    <span class="dp-close" onclick="closeDP()">✕</span>
  </div>
  <div class="dp-subtitle" id="dp-subtitle"></div>
  <div id="dp-body"></div>
  <button class="save-btn" id="save-btn" onclick="saveDP()">Guardar cambios</button>
</div>

<script>
const API = '/api/planificacion';
const HOURS = ['6am','7am','8am','9am','10am','11am','12pm','1pm','2pm','3pm','4pm','5pm','6pm','7pm','8pm'];
const SLOTS = HOURS.length;
const searchParams = new URLSearchParams(window.location.search);
const autoPlanRequested = searchParams.get('autoplan') === '1';

let orders    = [];
let machines  = [];
let procesos  = [];   // lista de procesos con sus máquinas agrupadas
let dragOp    = null;
let currentDP = null;
let activeChainIds = null;
let isOnline  = false;
let hasAutoPlanned = false;
let conflictDrawerOpen = false;
const expandedProcessIds = new Set();
const ROUTE_COLORS = ['#378ADD', '#1D9E75', '#BA7517', '#E24B4A', '#639922', '#8B5CF6', '#0EA5E9', '#F59E0B', '#64748B', ''];

function displayProcessName(value) {
  const raw = String(value || '').trim();
  const key = raw.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const labels = {
    diseno: 'Diseño',
    preprensa: 'Preprensa',
    impresion: 'Impresión',
    'impresion convencional': 'Impresión Convencional',
    'impresion digital': 'Impresión Digital',
    barnizado: 'Barniz',
    barniz: 'Barniz',
    numeracion: 'Numeración',
    rebobinado: 'Rebobinado',
    empaque: 'Empaque'
  };
  return labels[key] || raw || 'Sin proceso';
}

// ── API ────────────────────────────────────────────────────
async function loadFromAPI() {
  try {
    const [res, costsRes] = await Promise.all([
      fetch(`${API}/gantt-agrupado`),
      fetch('/api/costos-config').catch(() => null)
    ]);
    if (!res.ok) throw new Error('Error HTTP ' + res.status);
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'Error en respuesta');

    let costsProcessOrder = {};
    if (costsRes && costsRes.ok) {
      const costsData = await costsRes.json();
      const defaults = costsData?.general?.processDefaults || [];
      defaults.forEach((p, idx) => {
        const key = (p.key || '').toLowerCase().trim();
        costsProcessOrder[key] = {
          order: p.order != null ? p.order : (idx + 1) * 10,
          ganttEnabled: p.ganttEnabled !== false,
          label: p.label || key
        };
      });
    }

    // data.maquinas = máquinas con proceso_nombre, color_hex, orden_secuencia
    // data.rutas    = órdenes con sus datos completos
    machines = data.maquinas;
    orders   = data.rutas.map(r => ({
      id:          r.codigo_op,
      id_ruta:     r.id_ruta,
      cliente:     r.cliente,
      articulo:    r.articulo,
      saidel:      r.saidel || '—',
      colores:     r.colores,
      pies:        r.pies,
      proceso:     displayProcessName(r.proceso),
      maquina:     r.maquina,
      inicio:      parseFloat(r.inicio),
      dur:         parseFloat(r.dur),
      trans_costo: r.trans_costo || 0,
      dep:         r.dep || null,
      dep_ruta_id: r.dep_ruta_id || null,
      estado:      r.estado,
      alerta:      !!r.alerta,
      alerta_tipo: r.alerta || null,
      fecha_entrega_prometida: r.fecha_entrega_prometida || null,
      route_payload: r.route_payload || {},
      planning_snapshot: r.planning_snapshot || null,
      manual_lock: Boolean(r.route_payload?.manualLock),
      schedule_mode: r.route_payload?.scheduleMode || r.route_payload?.schedule_mode || '',
    }));

    // Agrupar máquinas por proceso para el render
    // Usar el orden del cálculo de costos si está disponible, filtrar por ganttEnabled
    const grupos = {};
    machines.forEach(m => {
      const processKey = (m.process_key || '').toLowerCase().trim();
      const costCfg = costsProcessOrder[processKey];
      // Si existe config de costos y ganttEnabled es false, omitir esta máquina
      if (costCfg && !costCfg.ganttEnabled) return;
      const key = m.id_proceso || processKey || 0;
      if (!grupos[key]) grupos[key] = {
        id_proceso:      m.id_proceso,
        process_key:     processKey,
        nombre:          displayProcessName(m.proceso_nombre),
        color:           m.color_hex      || '#888',
        icono:           m.proceso_icono  || '⚙',
        orden:           costCfg ? costCfg.order : (m.orden_secuencia || 99),
        maquinas:        []
      };
      grupos[key].maquinas.push(m);
    });
    procesos = Object.values(grupos).sort((a,b) => a.orden - b.orden);

    setOnline(true);
    render();
    if (autoPlanRequested && !hasAutoPlanned && orders.length) {
      hasAutoPlanned = true;
      setTimeout(() => autoSeq(), 0);
    }
  } catch (e) {
    setOnline(false);
    showError('No se pudo conectar a la planificación del ERP — ' + e.message);
    if (!orders.length) {
      document.getElementById('app').innerHTML =
        `<div class="loading" style="flex-direction:column;gap:8px">
          <span style="font-size:22px">⚡</span>
          <span>API offline. Asegúrate que el servidor Express esté corriendo.</span>
          <code style="font-size:11px;background:#f0f0ea;padding:4px 8px;border-radius:4px">node server.js</code>
         </div>`;
    }
  }
}

const COLORS = {
  RUN:       {bg:'#1D9E75', bd:'#0F6E56', tx:'#fff'},
  SETUP:     {bg:'#BA7517', bd:'#854F0B', tx:'#fff'},
  PENDIENTE: {bg:'#378ADD', bd:'#185FA5', tx:'#fff'},
  PARO:      {bg:'#E24B4A', bd:'#A32D2D', tx:'#fff'},
  COMPLETADO:{bg:'#639922', bd:'#3B6D11', tx:'#fff'},
};

function pct(v){ return (v / SLOTS * 100).toFixed(4) + '%'; }

async function apiPatch(url, body) {
  const res = await fetch(url, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  const payload = await res.json();
  if (!res.ok || payload.ok === false) throw new Error(payload.error || 'No se pudo guardar el cambio.');
  return payload;
}

function setOnline(v) {
  isOnline = v;
  const el = document.getElementById('conn-dot');
  if (el) {
    el.className = 'dot' + (v ? '' : ' offline');
    el.title = v ? 'API conectada' : 'API desconectada';
  }
  document.getElementById('error-bar').style.display = v ? 'none' : 'flex';
}

function showError(msg) {
  document.getElementById('error-msg').textContent = msg;
  document.getElementById('error-bar').style.display = 'flex';
}

// ── DETECCIÓN DE CONFLICTOS ────────────────────────────────

// Detecta todos los conflictos actuales en el tablero
function detectAllConflicts() {
  const conflicts = []; // { type, ruta_a, ruta_b, message }

  for (let i = 0; i < orders.length; i++) {
    const a = orders[i];
    const aEnd = a.inicio + a.dur;

    for (let j = i + 1; j < orders.length; j++) {
      const b = orders[j];
      const bEnd = b.inicio + b.dur;

      // ── Regla 1: Misma máquina, órdenes distintas → no solapar ──
      if (a.maquina === b.maquina && a.id_ruta !== b.id_ruta) {
        if (a.inicio < bEnd && aEnd > b.inicio) {
          conflicts.push({
            type: 'machine',
            ruta_a: a.id_ruta, ruta_b: b.id_ruta,
            message: `Máquina ${a.maquina}: "${a.id}" (${a.proceso}) y "${b.id}" (${b.proceso}) se superponen`
          });
        }
      }

      // ── Regla 2: Misma OP → sus procesos deben ser secuenciales ──
      if (a.id === b.id) {
        // Si b depende de a, b debe empezar después de que a termine
        if (b.dep_ruta_id === a.id_ruta || (b.dep === a.id && b.id_ruta !== a.id_ruta)) {
          if (b.inicio < aEnd) {
            conflicts.push({
              type: 'sequence',
              ruta_a: a.id_ruta, ruta_b: b.id_ruta,
              message: `Orden ${a.id}: "${b.proceso}" empieza antes de que "${a.proceso}" termine`
            });
          }
        }
        // Inverso
        if (a.dep_ruta_id === b.id_ruta || (a.dep === b.id && a.id_ruta !== b.id_ruta)) {
          if (a.inicio < bEnd) {
            conflicts.push({
              type: 'sequence',
              ruta_a: b.id_ruta, ruta_b: a.id_ruta,
              message: `Orden ${b.id}: "${a.proceso}" empieza antes de que "${b.proceso}" termine`
            });
          }
        }
      }
    }
  }
  return conflicts;
}

function getOrderChainBounds(orderCode) {
  const ops = orders.filter(o => o.id === orderCode);
  if (!ops.length) return null;
  return ops.reduce((acc, op) => {
    const end = op.inicio + op.dur;
    return {
      minStart: Math.min(acc.minStart, op.inicio),
      maxEnd: Math.max(acc.maxEnd, end)
    };
  }, { minStart: Number.POSITIVE_INFINITY, maxEnd: 0 });
}

function promisedHourSlot(value) {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  const hour = date.getHours() + (date.getMinutes() / 60);
  const slot = hour - 6;
  return Number.isFinite(slot) ? Math.max(0, Math.min(SLOTS, slot)) : null;
}

function detectScheduleAlerts() {
  const alerts = [];
  const seen = new Set();

  orders.forEach(op => {
    if (seen.has(op.id)) return;
    seen.add(op.id);

    const dueSlot = promisedHourSlot(op.fecha_entrega_prometida);
    if (dueSlot === null) return;

    const bounds = getOrderChainBounds(op.id);
    if (!bounds) return;

    const slack = Number((dueSlot - bounds.maxEnd).toFixed(2));
    if (slack < 0) {
      alerts.push({
        type: 'late',
        orderCode: op.id,
        slack,
        message: `${op.id} termina ${Math.abs(slack).toFixed(2)}h después de la entrega prometida`
      });
      return;
    }

    if (slack <= 1) {
      alerts.push({
        type: 'tight',
        orderCode: op.id,
        slack,
        message: `${op.id} queda con solo ${slack.toFixed(2)}h de margen antes de entrega`
      });
    }
  });

  return alerts;
}

function orderOverlapsVisible(op) {
  const start = Number(op?.inicio || 0);
  const end = start + Number(op?.dur || 0);
  return start < SLOTS && end > 0;
}

function processDomKey(proc) {
  return String(proc?.id_proceso || proc?.nombre || 'sin-proceso');
}

function machineVisibleOps(machineId) {
  return orders.filter(o => o.maquina === machineId && orderOverlapsVisible(o));
}

function toggleConflicts() {
  conflictDrawerOpen = !conflictDrawerOpen;
  render();
}

function toggleProcessMachines(key) {
  if (expandedProcessIds.has(key)) expandedProcessIds.delete(key);
  else expandedProcessIds.add(key);
  render();
}

function showToast(message, type = '') {
  document.querySelector('.gantt-toast')?.remove();
  const toast = document.createElement('div');
  toast.className = `gantt-toast ${type}`.trim();
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3600);
}

// Verifica si colocar id_ruta en newStart/newDur/newMaq genera conflictos
function checkMove(id_ruta, newStart, newDur, newMaq) {
  const op   = orders.find(o => o.id_ruta === id_ruta);
  if (!op) return [];
  const newEnd = newStart + newDur;
  const issues = [];

  // Regla 1: Máquina — ningún otro proceso en la misma máquina puede solapar
  orders.filter(o => o.id_ruta !== id_ruta && o.maquina === newMaq).forEach(o => {
    const oEnd = o.inicio + o.dur;
    if (newStart < oEnd && newEnd > o.inicio) {
      issues.push({
        type: 'machine',
        id_ruta: o.id_ruta,
        message: `Máquina ${newMaq}: conflicto con "${o.id}" · ${o.proceso} (${formatHora(o.inicio)}–${formatHora(oEnd)})`
      });
    }
  });

  // Regla 2: Secuencia de la misma OP — predecesor debe terminar antes
  const pred = orders.find(o =>
    op.dep_ruta_id === o.id_ruta || (op.dep && op.dep === o.id && o.id_ruta !== id_ruta)
  );
  if (pred) {
    const predEnd = pred.inicio + pred.dur;
    if (newStart < predEnd) {
      issues.push({
        type: 'sequence',
        id_ruta: pred.id_ruta,
        message: `"${pred.proceso}" de ${pred.id} termina a las ${formatHora(predEnd)} — no puede empezar antes`
      });
    }
  }

  // Regla 2b: Sucesores de la misma OP deben empezar después de que este termine
  orders.filter(o => o.dep_ruta_id === id_ruta || (o.dep === op.id && o.id !== op.id)).forEach(succ => {
    if (succ.inicio < newEnd) {
      issues.push({
        type: 'sequence',
        id_ruta: succ.id_ruta,
        message: `"${succ.proceso}" de ${succ.id} empieza a las ${formatHora(succ.inicio)}, antes de que este proceso termine`
      });
    }
  });

  return issues;
}

// Intenta corregir automáticamente: empuja sucesores
function autoFix(id_ruta, newEnd) {
  function push(rid, mustStartAfter) {
    orders.filter(o => o.dep_ruta_id === rid || (o.dep && orders.find(x=>x.id_ruta===rid)?.id === o.dep)).forEach(succ => {
      if (succ.inicio < mustStartAfter) {
        succ.inicio = parseFloat(mustStartAfter.toFixed(2));
        push(succ.id_ruta, succ.inicio + succ.dur);
      }
    });
  }
  push(id_ruta, newEnd);
}

function getMachineKey(machine) {
  return String(machine?.id_maquina || machine?.id || '');
}

function getDirectSuccessors(id_ruta) {
  const current = orders.find(o => o.id_ruta === id_ruta);
  return orders
    .filter(o => o.dep_ruta_id === id_ruta || (o.dep && current && o.dep === current.id && o.id !== current.id))
    .sort((a, b) => {
      const dueDiff = parsePromisedTime(a.fecha_entrega_prometida) - parsePromisedTime(b.fecha_entrega_prometida);
      if (dueDiff !== 0) return dueDiff;
      return a.inicio - b.inicio;
    });
}

function getChainOpsOrdered(rootId) {
  const ordered = [];
  const visited = new Set();

  function walk(routeId) {
    if (visited.has(routeId)) return;
    const op = orders.find(o => o.id_ruta === routeId);
    if (!op) return;
    visited.add(routeId);
    ordered.push(op);
    getDirectSuccessors(routeId).forEach(succ => walk(succ.id_ruta));
  }

  walk(rootId);
  return ordered;
}

function getOrderOps(orderCode) {
  return orders.filter(o => o.id === orderCode);
}

function getChainDuration(chain) {
  return chain.reduce((sum, op) => sum + op.dur, 0);
}

// ── CADENA DE DEPENDENCIAS ─────────────────────────────────
// Dado un id_ruta, devuelve todos los id_ruta de la misma OP
// más los de sus dependencias aguas arriba y abajo
function getChain(id_ruta) {
  const op = orders.find(o => o.id_ruta === id_ruta);
  if (!op) return new Set();

  const codigoOp = op.id; // codigo_op
  const chain = new Set();

  // 1. Todos los procesos de la misma OP
  orders.filter(o => o.id === codigoOp).forEach(o => chain.add(o.id_ruta));

  // 2. Dependencias directas que esta OP declara (dep_ruta_id hacia atrás)
  function addUpstream(rutaId) {
    const o = orders.find(x => x.id_ruta === rutaId);
    if (!o || !o.dep_ruta_id) return;
    if (chain.has(o.dep_ruta_id)) return;
    chain.add(o.dep_ruta_id);
    addUpstream(o.dep_ruta_id);
  }

  // 3. Órdenes que dependen de esta OP (hacia adelante)
  function addDownstream(rutaId) {
    orders.filter(o => o.dep_ruta_id === rutaId).forEach(o => {
      if (chain.has(o.id_ruta)) return;
      chain.add(o.id_ruta);
      addDownstream(o.id_ruta);
    });
  }

  chain.forEach(rid => { addUpstream(rid); addDownstream(rid); });
  return chain;
}

// ── HELPER: genera HTML de una barra de tarea ─────────────
function taskBar(op, machineConflictRutas, sequenceConflictRutas) {
  const baseColor = op.alerta ? COLORS.PARO : (COLORS[op.estado] || COLORS.PENDIENTE);
  const customColor = String(op.route_payload?.colorHex || '').trim();
  const c = customColor ? { bg: customColor, bd: customColor, tx: '#fff' } : baseColor;
  const routeArg = String(op.id_ruta).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
  let chainClass = '';
  if (activeChainIds) {
    chainClass = activeChainIds.has(op.id_ruta) ? ' chain-active' : ' chain-dim';
  }
  let conflictClass = '';
  if (!activeChainIds) {
    if (machineConflictRutas.has(op.id_ruta))       conflictClass = ' conflict-machine';
    else if (sequenceConflictRutas.has(op.id_ruta)) conflictClass = ' conflict-sequence';
  }
  const scheduleAlert = detectScheduleAlerts().find(entry => entry.orderCode === op.id);
  const scheduleClass = scheduleAlert
    ? (scheduleAlert.type === 'late' ? ' conflict-machine' : ' conflict-sequence')
    : '';
  const modeLabel = op.manual_lock ? 'Fijo' : op.schedule_mode === 'backward' ? 'Atrás' : op.schedule_mode === 'forward' ? 'Adelante' : '';

  // Production progress indicators
  const isRunning = op.estado === 'RUN' || op.estado === 'SETUP';
  const isLate = scheduleAlert?.type === 'late';
  const planningSnapshot = op.planning_snapshot || op.route_payload;
  const progressPct = isRunning ? Math.min(100, Math.round((Number(planningSnapshot?.progressPct || 0)))) : 0;
  const hasProgress = progressPct > 0;

  const runningClass = isRunning ? ' is-running' : '';
  return `<div class="task-bar${chainClass}${conflictClass}${scheduleClass}${runningClass}"
    id="bar-${op.id_ruta}"
    data-id="${op.id}"
    data-ruta="${op.id_ruta}"
    style="left:${pct(op.inicio)};width:${pct(op.dur)};background:${c.bg};border-color:${c.bd}"
    draggable="true"
    onmouseenter="showTT(event,'${routeArg}')"
    onmouseleave="hideTT()"
    oncontextmenu="openColorMenu(event,'${routeArg}')"
    ondragstart="dragStart(event,'${routeArg}')"
    ondragend="dragEnd(event)"
    onclick="openDP('${routeArg}')"
  >
    ${isLate ? '<div class="task-late-icon" title="Fuera de fecha prometida">⚠</div>' : ''}
    ${hasProgress ? `<div class="task-progress-track"><div class="task-progress-fill" style="width:${progressPct}%"></div></div>` : ''}
    <button type="button" class="task-config-btn" onclick="event.stopPropagation();openDP('${routeArg}')" title="Configurar">⋯</button>
    <div class="task-cliente" style="color:${c.tx}">${op.cliente}</div>
    <div class="task-lbl"    style="color:${c.tx}">${op.id} · ${op.articulo}${op.manual_lock ? ' [Fijo]' : ''}</div>
    <div class="task-sub"    style="color:${c.tx}">${op.proceso}${op.colores > 0 ? ' · ' + op.colores + 'C' : ''}${modeLabel ? `<span class="task-mode">${modeLabel}</span>` : ''}</div>
  </div>`;
}

// ── RENDER ─────────────────────────────────────────────────
function render() {
  const criticas    = orders.filter(o => o.alerta).length;
  const enRun       = orders.filter(o => o.estado === 'RUN').length;
  const transTot    = orders.reduce((a, o) => a + (o.trans_costo || 0), 0);
  const allConflicts = detectAllConflicts();
  const scheduleAlerts = detectScheduleAlerts();
  const lateAlerts = scheduleAlerts.filter(entry => entry.type === 'late');
  const tightAlerts = scheduleAlerts.filter(entry => entry.type === 'tight');
  const conflictRutas = new Set(allConflicts.flatMap(c => [c.ruta_a, c.ruta_b]));
  const machineConflictRutas   = new Set(allConflicts.filter(c=>c.type==='machine').flatMap(c=>[c.ruta_a,c.ruta_b]));
  const sequenceConflictRutas  = new Set(allConflicts.filter(c=>c.type==='sequence').flatMap(c=>[c.ruta_a,c.ruta_b]));

  let html = `
  <div class="hdr">
    <span class="hdr-title">
      <span class="dot${isOnline?'':' offline'}" id="conn-dot" title="${isOnline?'API conectada':'API desconectada'}"></span>
      Consola APS — Flexografía
    </span>
    <div class="toolbar">
      <span class="badge info" id="gantt-user-badge" style="font-weight:500">👤 <span id="ganttUserName">Cargando...</span></span>
      <span class="badge ok">● ${enRun} en ejecución</span>
      ${criticas > 0 ? `<span class="badge crit">▲ ${criticas} crítica(s)</span>` : ''}
      ${lateAlerts.length > 0 ? `<span class="badge crit">⏰ ${lateAlerts.length} fuera de fecha</span>` : ''}
      ${tightAlerts.length > 0 ? `<span class="badge warn">⌛ ${tightAlerts.length} justas</span>` : ''}
      <span class="badge info">Prioridad por fecha prometida</span>
      <span class="conn-status ${isOnline?'online':'offline'}">${isOnline?'● API online':'● API offline'}</span>
      <button class="btn" onclick="window.location.href='/planificacion/lanzamiento'">Cola de planificación</button>
      <button class="btn" onclick="clearChain()">Limpiar selección</button>
      <button class="btn conflict-toggle-btn ${allConflicts.length ? 'has-conflicts' : ''}" onclick="toggleConflicts()">Conflictos (${allConflicts.length})</button>
      <button class="btn" onclick="resolveAllConflicts()">Resolver</button>
      <button class="btn" onclick="autoSeq()">Optimizar ↺</button>
      <button class="btn" onclick="loadFromAPI()">Actualizar ↻</button>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><div class="stat-lbl">Órdenes activas</div><div class="stat-val">${orders.length}</div></div>
    <div class="stat"><div class="stat-lbl">Alertas críticas</div><div class="stat-val" style="color:#A32D2D">${criticas}</div></div>
    <div class="stat"><div class="stat-lbl">Conflictos activos</div><div class="stat-val" style="color:${allConflicts.length?'#E24B4A':'#1D9E75'}">${allConflicts.length}</div></div>
    <div class="stat"><div class="stat-lbl">Riesgo por fecha</div><div class="stat-val" style="color:${lateAlerts.length?'#E24B4A':tightAlerts.length?'#BA7517':'#1D9E75'}">${lateAlerts.length + tightAlerts.length}</div></div>
  </div>

  <div id="conflict-drawer" class="alerts conflict-drawer ${conflictDrawerOpen ? 'open' : ''}">
    ${allConflicts.slice(0,4).map(c =>
      `<span class="conflict-badge">${c.type==='machine'?'⊗ Máquina':'⧗ Secuencia'}: ${c.message}</span>`).join('')}
    ${allConflicts.length > 4 ? `<span class="badge warn">+${allConflicts.length-4} más…</span>` : ''}
    ${orders.filter(o => o.alerta).map(o =>
      `<span class="badge crit">⚠ ${o.id} — ${o.alerta_tipo || 'ALERTA'}</span>`).join('')}
    ${lateAlerts.map(entry =>
      `<span class="badge crit">⏰ ${entry.message}</span>`).join('')}
    ${tightAlerts.map(entry =>
      `<span class="badge warn">⌛ ${entry.message}</span>`).join('')}
    ${orders.filter(o => o.trans_costo >= 120).map(o =>
      `<span class="badge warn">⟳ ${o.id} — Lavado: ${o.trans_costo} min</span>`).join('')}
    ${!allConflicts.length && !orders.filter(o=>o.alerta||o.trans_costo>=120).length && !scheduleAlerts.length
      ? '<span style="font-size:11px;color:#aaa">Sin alertas activas</span>' : ''}
  </div>

  <div class="gantt-wrap"><div class="gantt-inner" id="gantt-inner">
    <div class="g-header">
      <div class="res-col">Proceso / Recurso</div>
      <div class="time-hdr">${HOURS.map(h => `<div class="t-slot">${h}</div>`).join('')}</div>
    </div>`;

  procesos.forEach(proc => {
    const procKey = processDomKey(proc);
    const expanded = expandedProcessIds.has(procKey);
    const assignedMachines = proc.maquinas.filter(m => machineVisibleOps(m.id_maquina).length > 0);
    const visibleMachines = expanded ? proc.maquinas : assignedMachines;
