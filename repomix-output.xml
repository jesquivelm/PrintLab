.dashboard-topbar .topbar-user-tools {
    gap: 10px;
}

.topbar .brand,
.dashboard-topbar .brand {
    width: 100%;
}

.topbar .brand {
    justify-content: space-between;
}

.topbar .brand h1,
.dashboard-topbar .brand h1 {
    flex: 1 1 auto;
    min-width: 0;
}

.topbar .topbar-user-tools,
.dashboard-topbar .topbar-user-tools {
    flex: 0 0 auto;
}

.dashboard-topbar .tool-icon,
.topbar .tool-icon,
.theme-toggle {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--app-text-muted);
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
}

.dashboard-topbar .tool-icon:hover,
.dashboard-topbar .tool-icon:focus-visible,
.topbar .tool-icon:hover,
.topbar .tool-icon:focus-visible,
.theme-toggle:hover,
.theme-toggle:focus-visible {
    color: var(--app-primary-strong);
    background: color-mix(in srgb, var(--app-primary) 12%, transparent);
    transform: translateY(-1px);
    box-shadow: none;
    border-color: transparent;
}

.dashboard-topbar .brand h1,
.topbar .brand h1 {
    font-weight: 700;
    letter-spacing: 0;
    color: var(--app-text);
}

.dashboard-topbar .brand-mark,
.topbar .brand-mark {
    font-weight: 700;
    letter-spacing: 0;
}

.dashboard-card {
    border-radius: 10px;
}

.dashboard-card[data-icon-key="dashboardProducts"] {
    --card-accent: color-mix(in srgb, var(--tab-accent, #b6922d) 72%, #d89e2a);
}

.dashboard-card-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--app-text);
}

.dashboard-card:hover .dashboard-card-title,
.dashboard-card:focus-visible .dashboard-card-title {
    color: var(--app-primary-strong);
}

.topbar-profile-popover {
    position: fixed;
    inset: 0;
    z-index: 5200;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgba(15, 23, 42, 0.26);
    backdrop-filter: blur(8px);
}

.topbar-profile-card {
    width: min(620px, calc(100vw - 32px));
    display: grid;
    gap: 0;
    padding: 0;
    border: 1px solid var(--app-border);
    border-radius: 18px;
    background: var(--app-surface);
    box-shadow: var(--app-shadow-lg);
    max-height: calc(100vh - 48px);
    overflow: auto;
}

.topbar-profile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 22px;
    border-bottom: 1px solid var(--app-border);
    background: linear-gradient(180deg, color-mix(in srgb, var(--app-primary) 7%, var(--app-surface)) 0%, var(--app-surface) 100%);
}

.topbar-profile-identity {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
}

.topbar-profile-avatar-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    flex: 0 0 74px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--app-primary) 18%, var(--app-border));
    border-radius: 18px;
    background: color-mix(in srgb, var(--app-primary) 12%, var(--app-surface-raised));
}

.topbar-profile-avatar {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.topbar-profile-initials {
    color: var(--app-primary-strong);
    font-size: 22px;
    font-weight: 800;
}

.topbar-profile-title {
    min-width: 0;
}

.topbar-profile-head strong {
    display: block;
    color: var(--app-text);
    font-size: 18px;
}

.topbar-profile-head span {
    display: block;
    margin-top: 4px;
    color: var(--app-text-muted);
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.topbar-profile-head .topbar-profile-initials {
    margin-top: 0;
    color: var(--app-primary-strong);
    font-size: 22px;
    font-weight: 800;
}

.topbar-profile-avatar[hidden],
.topbar-profile-initials[hidden] {
    display: none;
}

.topbar-profile-close {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--app-text-soft);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.16s ease, transform 0.16s ease;
}

.topbar-profile-close:hover,
.topbar-profile-close:focus-visible {
    color: var(--app-primary-strong);
    outline: none;
    transform: scale(1.08);
}

.topbar-profile-form {
    display: grid;
    gap: 14px;
    padding: 0 22px 20px;
}

.topbar-profile-form label,
.topbar-profile-field {
    display: grid;
    gap: 6px;
}

.topbar-profile-form span {
    color: var(--app-text-soft);
    font-size: 12px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.topbar-profile-form input {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--app-border);
    border-radius: 12px;
    padding: 10px 12px;
    background: var(--app-surface-raised);
    color: var(--app-text);
    font: inherit;
}

.topbar-profile-form input[type="color"] {
    width: 42px;
    min-width: 42px;
    height: 34px;
    min-height: 34px;
    padding: 3px;
    border-radius: 10px;
}

.topbar-profile-form select {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--app-border);
    border-radius: 12px;
    padding: 10px 12px;
    background: var(--app-surface-raised);
    color: var(--app-text);
    font: inherit;
}

.topbar-profile-form input[type="checkbox"] {
    width: 16px;
    min-height: 16px;
    height: 16px;
    padding: 0;
    margin: 0;
}

.topbar-profile-form input:focus,
.topbar-profile-form select:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--app-primary) 46%, var(--app-border));
    box-shadow: 0 0 0 3px var(--app-ring);
}

.topbar-profile-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin: 18px 22px 16px;
    padding: 4px;
    border: 1px solid var(--app-border);
    border-radius: 14px;
    background: linear-gradient(180deg, #f7fafc 0%, #eef4f8 100%);
}

.topbar-profile-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 10px 18px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: #60707f;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;
}

.topbar-profile-tab:hover {
    background: rgba(11,129,184,0.08);
    color: #23516a;
}

.topbar-profile-tab.is-active {
    background: linear-gradient(180deg, #24a8df 0%, #118fc6 100%);
    color: #ffffff;
    box-shadow: 0 8px 18px rgba(17,143,198,0.24);
}

.topbar-profile-tab.is-active:hover,
.topbar-profile-tab.is-active:focus-visible {
    background: linear-gradient(180deg, #24a8df 0%, #118fc6 100%);
    color: #eaf8ff;
    outline: none;
}

.topbar-profile-panel[hidden] {
    display: none;
}

.topbar-profile-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.topbar-profile-wide {
    grid-column: 1 / -1;
}

.topbar-profile-inline-check {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
}

.topbar-profile-color-alpha-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.topbar-profile-color-alpha-row input[type="color"] {
    flex: 0 0 42px;
    width: 42px;
    min-width: 42px;
    height: 34px;
    min-height: 34px;
    padding: 3px;
    border-radius: 10px;
}

.topbar-profile-alpha-input {
    width: 58px !important;
    min-width: 58px;
    flex: 0 0 58px;
    text-align: center;
}

.topbar-profile-alpha-label {
    flex: 0 0 auto;
    color: var(--app-text-soft);
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
    white-space: nowrap;
}

.topbar-profile-range-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 72px;
    gap: 8px;
    align-items: center;
}

.topbar-profile-range-row input[type="range"] {
    width: 100%;
    min-height: 34px;
    padding: 0;
}

.topbar-profile-range-row input[type="number"] {
    min-height: 34px;
    padding: 8px 10px;
    text-align: center;
}

.topbar-profile-status {
    min-height: 18px;
    margin: 0;
    color: var(--app-text-muted);
    font-size: 12px;
}

.topbar-profile-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 2px;
}

.topbar-profile-actions .action-btn {
    min-height: 38px;
    border-radius: 10px;
}

.topbar-profile-logout {
    margin-right: auto;
    color: #bd3f56;
    border-color: color-mix(in srgb, #bd3f56 24%, var(--app-border));
    background: color-mix(in srgb, #bd3f56 8%, var(--app-surface));
    box-shadow: none;
}

.topbar-profile-logout:hover,
.topbar-profile-logout:focus-visible {
    color: #ffffff;
    border-color: transparent;
    background: linear-gradient(180deg, #d65368 0%, #bd3f56 100%);
}

@media (max-width: 640px) {
    .topbar-profile-popover {
        padding: 14px;
    }

    .topbar-profile-head {
        align-items: flex-start;
        padding: 18px;
    }

    .topbar-profile-tabs {
        margin: 14px 18px;
    }

    .topbar-profile-form {
        padding: 0 18px 18px;
    }

    .topbar-profile-grid {
        grid-template-columns: 1fr;
    }

    .topbar-profile-logout {
        margin-right: 0;
    }
}

.theme-toggle {
    box-shadow: none;
}

.theme-toggle .theme-toggle-icon {
    width: 16px;
    height: 16px;
}

.theme-toggle-icon-sun {
    border-width: 1.8px;
    box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 12%, transparent);
}

.theme-toggle-icon-moon {
    box-shadow: inset -4px 0 0 var(--app-surface-soft);
}

.product-catalog-card .product-catalog-head {
    margin-bottom: 18px;
}

.product-catalog-card .product-catalog-title h1 {
    color: var(--app-text);
    font-size: 26px;
}

