            if (!payload.severityLow && !payload.severityMedium && !payload.severityHigh) {
                throw new Error('Debes activar al menos un nivel de severidad.');
            }
            setNotificationAlertContactsStatus(isEditing ? 'Actualizando contacto...' : 'Guardando contacto...', false);
            const response = await fetch(
                isEditing
                    ? `/api/notification-alert-contacts/${encodeURIComponent(selectedNotificationAlertContactId)}`
                    : '/api/notification-alert-contacts',
                {
                    method: isEditing ? 'PATCH' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                }
            );
            const saved = await response.json().catch(() => ({}));
