                    $1, $2, '', $3, $4, $5, $6, $7, '', '', false, NULL, $8, CURRENT_DATE, $9::jsonb, NOW()
                )`,
                [
                    partner.partnerCode,
                    partner.partnerName,
                    partner.taxId,
                    partner.contactEmail,
                    partner.email,
                    sanitizePartnerCodePrefix(partner.currencyCode).slice(0, 10) || 'USD',
