        function activateQuotesTab(tabKey = 'calculo') {
            const normalizedTabKey = tabKey === 'general' || tabKey === 'salidas' ? 'calculo' : tabKey;
            quotesSubtabs.forEach((tab) => {
                tab.classList.toggle('active', tab.dataset.quotesTab === normalizedTabKey);
            });
            quotesSubpanels.forEach((panel) => {
                const panelKey = panel.id.replace('quotes-panel-', '');
                if (normalizedTabKey === 'calculo') {
                    panel.hidden = !['general', 'calculo', 'salidas'].includes(panelKey);
                    return;
                }
                panel.hidden = panelKey !== normalizedTabKey;
            });
            if (normalizedTabKey === 'calculo') {
                loadQuoteOutputTypes().catch((error) => {
                    setQuoteOutputTypesStatus(error.message || 'No fue posible cargar los tipos de salida.', 'error');
                });
                loadInventoryClassificationMappings().catch((error) => {
                    setInventoryClassificationStatus(error.message || 'No fue posible cargar el mapeo de clasificación.', true);
                });
            }
            if (normalizedTabKey === 'tipo-cambio') {
                loadExchangeRateModule().catch((error) => {
                    setExchangeRateConfigStatus(error.message || 'No fue posible cargar el tipo de cambio.', 'error');
                });
                activateExchangeRateTab(document.querySelector('.exchange-rate-subtab.active')?.dataset.exchangeRateTab || 'tasas');
            }
            syncConfigTabHeights();
        }

