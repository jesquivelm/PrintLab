/* Theme foundation: migrated from the FlexoPrint token model. */
html {
    background: var(--app-bg);
    color: var(--app-text);
    transition: background-color 0.18s ease, color 0.18s ease;
}

html body {
    background: var(--app-bg);
    color: var(--app-text);
}

body,
.dashboard-body,
.app-shell,
.dashboard-app-shell,
.workspace,
.workspace-quote,
.dashboard-workspace-shell,
.dashboard-workspace,
.dashboard-home {
    background: var(--app-bg);
    color: var(--app-text);
}

.dashboard-topbar,
.topbar,
.brand,
.dashboard-tabs-bar {
    background: var(--app-surface);
    color: var(--app-text);
    border-color: var(--app-border);
}

.dashboard-topbar,
.topbar {
    box-shadow: var(--app-shadow-sm);
}

.brand {
    border-bottom-color: var(--app-primary);
}

.brand h1,
.dashboard-card-title,
.quote-card h2,
.copy-popover-header h2,
.dashboard-search-title,
.dashboard-inventory-title {
    color: var(--app-text);
}

.brand-mark {
    color: var(--app-primary);
    border-color: var(--app-border);
    background: var(--app-primary-soft);
}

.theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    background: var(--app-surface-soft);
    color: var(--app-text-soft);
    box-shadow: var(--app-shadow-sm);
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
}

.theme-toggle:hover,
.theme-toggle:focus-visible {
    color: var(--app-primary);
    border-color: color-mix(in srgb, var(--app-primary) 42%, var(--app-border));
    background: var(--app-primary-soft);
    transform: translateY(-1px);
    outline: none;
}

.theme-toggle-floating {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 5000;
}

.theme-toggle-label {
    display: none;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
}

.theme-toggle-icon {
    width: 15px;
    height: 15px;
    border-radius: 999px;
    position: relative;
    flex: 0 0 auto;
}

.theme-toggle-icon-sun {
    border: 2px solid currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 18%, transparent);
}

.theme-toggle-icon-moon {
    display: none;
    background: currentColor;
    box-shadow: inset -5px 0 0 var(--app-surface-soft);
}

html[data-theme="dark"] .theme-toggle-icon-sun { display: none; }
html[data-theme="dark"] .theme-toggle-icon-moon { display: inline-block; }

.dashboard-card,
.quote-card,
.quote-card-clean,
.costs-section-card,
.dashboard-search-popover,
.dashboard-inventory-popover,
.dashboard-search-item,
