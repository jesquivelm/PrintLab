        if (!name) return;
        
        let value = getValue(name);
        
        if (field.type === 'checkbox') {
            field.checked = value;
        } else if (field.tagName === 'SELECT') {
            field.value = value || '';
        } else {
            field.value = value ?? '';
        }
    });

