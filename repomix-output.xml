            <span class="row-action-menu-icon" style="--config-icon-size:${palette.size}px;width:${palette.size}px;height:${palette.size}px;flex:0 0 ${palette.size}px;">${iconMarkup(item.icon, item.label, 'table-icon-media')}</span>
