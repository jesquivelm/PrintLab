function parseTroquelDimensionsIn(value) {
    const text = asText(value);
    if (!text) return { width: null, length: null };
    const matches = text.match(/(\d+(?:[.,]\d+)?)/g) || [];
    if (matches.length < 2) return { width: null, length: null };
    return {
