    color: #5c6078;
    font-size: 13px;
    font-weight: 500;
}
.production-flow-tabs button.is-active {
    background: #ffffff;
    color: #0f1117;
    box-shadow: 0 1px 3px rgba(15,17,23,.07), 0 1px 2px rgba(15,17,23,.05);
}
.production-flow-view {
    display: none;
}
.production-flow-view.is-active {
    display: block;
}
.production-flow-panel {
    overflow: hidden;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 4px 12px rgba(15, 17, 23, .08), 0 1px 4px rgba(15, 17, 23, .06);
}
.production-flow-panel-head {
    display: flex;
    justify-content: space-between;
    padding: 16px 22px 14px;
    border-bottom: 1px solid #eceef5;
}
.production-flow-panel-head div {
    display: grid;
    gap: 1px;
}
.production-flow-panel-head strong {
    font-size: 14px;
    color: #0f1117;
}
.production-flow-panel-head span {
    font-size: 12px;
    color: #9499b0;
}
.production-flow-timeline {
    display: grid;
    padding: 20px 22px 8px;
}
.production-flow-step {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 0 14px;
    padding: 0;
    position: relative;
    border: 0;
    background: transparent;
}
.production-flow-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 25px;
    top: 46px;
    bottom: -16px;
    width: 2px;
    border-radius: 1px;
    background: repeating-linear-gradient(to bottom, #dde0ed 0, #dde0ed 5px, transparent 5px, transparent 9px);
}
.production-flow-marker {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #dde0ed;
    color: #9499b0;
    background: #f6f7fb;
    font-size: 15px;
    font-weight: 700;
    z-index: 1;
}
.production-flow-step.is-active .production-flow-marker {
    border-color: #bfcffe;
    color: #2563eb;
    background: #eff4ff;
}
.production-flow-step.is-stopped .production-flow-marker {
    border-color: #fecaca;
    color: #dc2626;
    background: #fef2f2;
}
.production-flow-step.is-done .production-flow-marker {
    border-color: #a7f3d0;
    background: #059669;
    color: #fff;
}
.production-flow-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding-bottom: 22px;
}
.production-flow-copy strong {
    font-size: 14px;
    color: #0f1117;
}
.production-flow-copy span,
.production-flow-copy small {
    color: #5c6078;
    font-size: 12px;
    line-height: 1.35;
}
.production-flow-compare {
    display: grid;
    gap: 12px;
    padding: 16px 22px 20px;
}
.production-flow-compare-row {
    display: grid;
    gap: 10px;
    padding: 14px;
    border: 1px solid #eceef5;
    border-radius: 16px;
    background: #ffffff;
}
.production-flow-compare-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}
.production-flow-compare-title strong {
    font-size: 13px;
    color: #0f1117;
}
.production-flow-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.production-flow-compare-grid > div {
    display: grid;
    gap: 5px;
    min-width: 0;
    padding: 11px;
    border-radius: 12px;
    background: #f6f7fb;
}
.production-flow-compare-grid span {
    font-size: 11px;
    font-weight: 700;
    color: #9499b0;
}
.production-flow-compare-grid strong {
    font-size: 13px;
    color: #0f1117;
}
.production-flow-compare-grid em {
    font-size: 11px;
    color: #5c6078;
    font-style: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.production-flow-compare-grid .is-over {
    color: #dc2626;
}
.socios-table-wrap {
    overflow: auto;
    border: 1px solid #e1e8ee;
    border-radius: 16px;
    background: #fff;
}
.socios-browser-table tbody tr.is-active td {
    background: #eef7fd;
    box-shadow: inset 0 1px 0 #d4ebf8, inset 0 -1px 0 #d4ebf8;
