        function getIconHtml(key, fallbackText, fallbackColor, fallbackSize) {
            const suffix = String(key || '').split(/[.\s_-]+/).filter(Boolean).map(part => part.charAt(0).toUpperCase() + part.slice(1)).join('');
            const input = document.querySelector(`input[name="icons.${key}"]`);
            const value = loadedConfig?.icons?.[key] || input?.value || fallbackText;
            const color = loadedConfig?.general?.[`iconColor${suffix}`] || fallbackColor;
            const size = Number(loadedConfig?.general?.[`iconSize${suffix}`]) || fallbackSize;
            
            if (value && String(value).startsWith('data:image/svg')) {
                return `<span class="icon-svg-mask" style="-webkit-mask-image:url('${value}');mask-image:url('${value}');width:${size}px;height:${size}px;background-color:${color};display:inline-block;vertical-align:middle;"></span>`;
            }
            if (value && String(value).startsWith('data:image')) {
                return `<img src="${value}" style="width:${size}px;height:${size}px;vertical-align:middle;object-fit:contain;">`;
            }
            // Forzar Segoe UI Emoji para evitar versiones wireframe en Windows
            return `<span style="color:${color};font-size:${size}px;vertical-align:middle;display:inline-block;line-height:1;font-family:'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji', sans-serif;">${value}&#xFE0F;</span>`;
        }

        function renderConfigButtonsIcons() {
            const productTypeAddBtn = document.getElementById('quoteProductTypeAddButton');
            if (productTypeAddBtn) productTypeAddBtn.innerHTML = getIconHtml('quantity.add', '+', '#738196', 20);

            const outputTypeAddBtn = document.getElementById('quoteOutputTypesAddButton');
            if (outputTypeAddBtn) outputTypeAddBtn.innerHTML = getIconHtml('quantity.add', '+', '#738196', 20);
        }

        function readStoredErpSession() {
            try {
                return JSON.parse(localStorage.getItem(ERP_SESSION_STORAGE_KEY) || sessionStorage.getItem(ERP_SESSION_STORAGE_KEY) || 'null');
            } catch (_) {
                return null;
            }
        }

        function writeStoredErpSession(session) {
            if (!session) return;
            const payload = JSON.stringify(session);
            try {
                if (localStorage.getItem(ERP_SESSION_STORAGE_KEY)) {
                    localStorage.setItem(ERP_SESSION_STORAGE_KEY, payload);
                    return;
                }
                if (sessionStorage.getItem(ERP_SESSION_STORAGE_KEY)) {
                    sessionStorage.setItem(ERP_SESSION_STORAGE_KEY, payload);
                    return;
                }
                sessionStorage.setItem(ERP_SESSION_STORAGE_KEY, payload);
            } catch (_) {
            }
        }

        function getErpSessionHeaders() {
            const session = readStoredErpSession();
            if (!session?.username) return {};
            return {
                'x-erp-session': JSON.stringify({
                    username: session.username || '',
                    name: session.name || session.fullName || '',
                    permissionName: session.permissionName || ''
                })
            };
        }

        function doesStoredSessionMatchUser(user) {
            const session = readStoredErpSession();
            if (!session?.username || !user) return false;
            const sessionUsername = String(session.username || '').trim().toLowerCase();
            const sessionName = String(session.name || session.fullName || '').trim().toLowerCase();
            const userUsername = String(user.username || '').trim().toLowerCase();
            const userName = String(user.name || '').trim().toLowerCase();
            if (sessionUsername && userUsername && sessionUsername === userUsername) return true;
            if (sessionName && userName && sessionName === userName) return true;
            return Number(currentAdminProfile?.id || 0) > 0 && Number(currentAdminProfile?.id) === Number(user.id);
        }

        function syncStoredSessionFromUser(user) {
            const session = readStoredErpSession();
            if (!session || !doesStoredSessionMatchUser(user)) return;
            const permission = getAdminPermissionById(user?.permissionId);
            session.name = user?.name || session.name || '';
            session.permissionId = user?.permissionId == null ? null : Number(user.permissionId);
            session.permissionName = permission?.name || user?.permissionName || '';
            session.sapSalespersonCode = user?.sapSalespersonCode == null ? null : Number(user.sapSalespersonCode);
            session.sapSalespersonName = user?.sapSalespersonName || '';
            session.userDefaultLanding = normalizeOptionalPresentationKey(user?.defaultLanding);
            session.defaultLanding = resolveAdminUserDefaultLanding(user);
            session.modules = createEmptyPermissionModules(permission?.modules || {});
            writeStoredErpSession(session);
            currentAdminProfile = {
                ...(currentAdminProfile || {}),
                id: user?.id || currentAdminProfile?.id || 0,
                name: user?.name || currentAdminProfile?.name || session.name || '',
                username: user?.username || currentAdminProfile?.username || session.username || '',
                permissionId: session.permissionId,
                permissionName: session.permissionName,
                defaultLanding: session.userDefaultLanding
            };
            applyNotificationCenterAccess();
        }

        function syncStoredSessionFromPermission(permission) {
            const session = readStoredErpSession();
            if (!session?.username || !permission) return;
            const currentPermissionId = Number(currentAdminProfile?.permissionId || session.permissionId || 0);
            if (!currentPermissionId || currentPermissionId !== Number(permission.id)) return;
            session.permissionId = Number(permission.id);
            session.permissionName = permission.name || session.permissionName || '';
            session.userDefaultLanding = normalizeOptionalPresentationKey(currentAdminProfile?.defaultLanding || session.userDefaultLanding);
            session.defaultLanding = session.userDefaultLanding || normalizeOptionalPresentationKey(permission.defaultLanding) || 'dashboard';
            session.modules = createEmptyPermissionModules(permission.modules || {});
            writeStoredErpSession(session);
            currentAdminProfile = {
                ...(currentAdminProfile || {}),
                permissionId: session.permissionId,
                permissionName: session.permissionName,
                defaultLanding: session.userDefaultLanding
            };
            applyNotificationCenterAccess();
        }

        function clearStoredSessionPermission(permissionId) {
            const session = readStoredErpSession();
            if (!session?.username) return;
            const currentPermissionId = Number(currentAdminProfile?.permissionId || session.permissionId || 0);
            if (!currentPermissionId || currentPermissionId !== Number(permissionId)) return;
            session.permissionId = null;
            session.permissionName = '';
            session.userDefaultLanding = '';
            session.defaultLanding = 'dashboard';
            session.modules = createEmptyPermissionModules();
            writeStoredErpSession(session);
            currentAdminProfile = {
                ...(currentAdminProfile || {}),
                permissionId: null,
                permissionName: '',
                defaultLanding: ''
            };
            applyNotificationCenterAccess();
        }
