    );
    const processSnapshot = buildCalculationProcessSnapshot({
        raw,
        processType,
        machineName: quotedMachine,
        dieCode: pickFirstValue(raw['GENERAL | TROQUEL | ID'], raw[`${activePrefix} | TROQUEL | ID`], row.die_code),
