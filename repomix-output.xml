    gap: 4px;
    min-width: 0;
    padding-bottom: 22px;
}
.production-flow-copy strong {
    font-size: 14px;
    color: #0f1117;
}
.production-flow-copy span,
.production-flow-copy small {
    color: #5c6078;
    font-size: 12px;
    line-height: 1.35;
