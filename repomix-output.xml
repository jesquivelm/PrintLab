            .notifications-card {
                min-height: auto;
            }
            .notifications-shell {
                min-height: auto;
            }
            .notifications-thread-list {
                max-height: 340px;
            }
            .notifications-message {
                max-width: 100%;
            }
        }
    </style>
</head>
