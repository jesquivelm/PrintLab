{
  "name": "mayaprint-flexo-web",
  "version": "0.1.0",
  "private": true,
  "description": "Base del cotizador web de flexografia para Mayaprint",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:check": "npm run build && node dist/scripts/db-check.js",
    "demo": "npm run build && node dist/demo.js",
    "start": "npm run build && node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
