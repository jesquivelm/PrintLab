<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/theme.js"></script>
    <title>Reporter&iacute;a Gerencial</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/reporteria.css">
</head>
<body class="report-body">
    <main class="report-shell">
        <header class="report-header">
            <div>
                <h1>Reporter&iacute;a Gerencial</h1>
                <p>Indicadores de cotizaciones, producci&oacute;n, costos, consumos, rendimientos y auditor&iacute;a.</p>
            </div>
            <form id="reportFilters" class="report-filters">
                <label><span>Desde</span><input id="dateFrom" type="date"></label>
                <label><span>Hasta</span><input id="dateTo" type="date"></label>
                <button type="submit">Actualizar</button>
            </form>
        </header>

        <section id="reportStatus" class="report-status">Cargando reporter&iacute;a...</section>
        <section id="kpiGrid" class="report-kpis"></section>

        <section class="report-grid">
            <article class="report-panel">
                <h2>Cotizaciones</h2>
                <div id="quotesReport" class="report-table"></div>
            </article>
            <article class="report-panel">
                <h2>Producci&oacute;n</h2>
                <div id="productionReport" class="report-table"></div>
            </article>
            <article class="report-panel">
                <h2>Costos</h2>
                <div id="costReport" class="report-table"></div>
            </article>
            <article class="report-panel">
                <h2>Consumos SAP</h2>
                <div id="consumptionReport" class="report-table"></div>
            </article>
            <article class="report-panel">
                <h2>Rendimientos</h2>
                <div id="yieldReport" class="report-table"></div>
            </article>
            <article class="report-panel report-panel-wide">
                <h2>&Oacute;rdenes por Estado / Proceso</h2>
                <div id="orderStatusReport" class="report-table"></div>
            </article>
            <article class="report-panel report-panel-wide">
                <h2>Auditor&iacute;a Operativa</h2>
                <div id="auditReport" class="report-table"></div>
            </article>
        </section>
    </main>
    <script src="/access-control.js"></script>
    <script src="/reporteria.js"></script>
</body>
</html>
