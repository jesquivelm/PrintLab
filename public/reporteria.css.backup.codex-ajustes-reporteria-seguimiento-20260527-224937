.report-body {
    margin: 0;
    min-height: 100vh;
    background: #f4f7fb;
    color: #1f2a37;
    font-family: "Segoe UI", Arial, sans-serif;
}

html[data-theme="dark"] .report-body {
    background: #101722;
    color: #e5edf7;
}

.report-shell {
    width: min(1380px, calc(100vw - 32px));
    margin: 0 auto;
    padding: 24px 0 36px;
}

.report-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
}

.report-header h1 {
    margin: 0 0 5px;
    font-size: 28px;
    font-weight: 700;
}

.report-header p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
}

.report-filters {
    display: flex;
    align-items: end;
    gap: 10px;
}

.report-filters label {
    display: grid;
    gap: 4px;
    font-size: 12px;
    color: #526174;
}

.report-filters input,
.report-filters button {
    height: 34px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0 10px;
    background: #fff;
    color: #1f2a37;
}

.report-filters button {
    background: #0b81b8;
    color: #fff;
    border-color: #0b81b8;
    cursor: pointer;
}

.report-status {
    min-height: 20px;
    margin-bottom: 14px;
    font-size: 13px;
    color: #64748b;
}

.report-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
}

.report-kpi,
.report-panel {
    background: #fff;
    border: 1px solid #dbe3ee;
    border-radius: 8px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
}

.report-kpi {
    padding: 14px;
}

.report-kpi span {
    display: block;
    color: #64748b;
    font-size: 12px;
}

.report-kpi strong {
    display: block;
    margin-top: 6px;
    font-size: 24px;
}

.report-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.report-panel {
    padding: 14px;
    min-width: 0;
}

.report-panel-wide {
    grid-column: 1 / -1;
}

.report-panel h2 {
    margin: 0 0 10px;
    font-size: 16px;
}

.report-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

.report-table th,
.report-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #e5eaf2;
    text-align: left;
    white-space: nowrap;
}

.report-table th {
    color: #64748b;
    font-weight: 700;
    background: #f8fafc;
}

html[data-theme="dark"] .report-header p,
html[data-theme="dark"] .report-status,
html[data-theme="dark"] .report-filters label,
html[data-theme="dark"] .report-kpi span,
html[data-theme="dark"] .report-table th {
    color: #9aa8bb;
}

html[data-theme="dark"] .report-kpi,
html[data-theme="dark"] .report-panel,
html[data-theme="dark"] .report-filters input {
    background: #172233;
    border-color: #2b3a4f;
    color: #e5edf7;
}

html[data-theme="dark"] .report-table th {
    background: #111b29;
}

html[data-theme="dark"] .report-table th,
html[data-theme="dark"] .report-table td {
    border-bottom-color: #2b3a4f;
}

@media (max-width: 900px) {
    .report-header,
    .report-filters {
        align-items: stretch;
        flex-direction: column;
    }

    .report-kpis,
    .report-grid {
        grid-template-columns: 1fr;
    }
}
