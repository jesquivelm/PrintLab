/* Dashboard pilot surface */
body.dashboard-body {
    width: 100%;
    min-height: 100vh;
    background:
        linear-gradient(180deg, color-mix(in srgb, var(--app-bg-soft) 88%, #ffffff) 0%, var(--app-bg) 42%),
        var(--app-bg);
}

html[data-theme="dark"] body.dashboard-body {
    background:
        linear-gradient(180deg, #111c31 0%, #0f172a 44%),
        var(--app-bg);
}

.dashboard-app-shell {
    grid-template-rows: 72px 48px 1fr;
    background: transparent;
}

.dashboard-topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--app-border);
    background: color-mix(in srgb, var(--app-surface) 92%, transparent);
    box-shadow: none;
    backdrop-filter: blur(16px);
}

.dashboard-topbar .brand {
    min-height: 72px;
    padding: 0 clamp(18px, 3vw, 40px);
    border-bottom: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 18px;
    background: transparent;
}

.dashboard-topbar .brand-logo-wrap {
    width: auto;
    min-width: 0;
    gap: 12px;
}

.dashboard-topbar .company-logo {
    width: 54px;
    height: 54px;
    object-fit: contain;
}

.dashboard-topbar .brand-mark {
    min-width: 54px;
    height: 54px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 13px;
    font-family: var(--app-font-family);
    font-weight: 800;
    letter-spacing: 0;
}

.dashboard-topbar .brand h1 {
    margin: 0;
    font-size: clamp(24px, 2.2vw, 34px);
    font-weight: 800;
    letter-spacing: 0;
    color: var(--app-text);
}

.dashboard-topbar .topbar-user-tools {
    justify-self: end;
    min-height: 0;
    padding: 0 52px 0 0;
}

.dashboard-topbar .tool-icon {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--app-text-muted);
    background: transparent;
}

.dashboard-topbar .tool-icon:hover,
.dashboard-topbar .tool-icon:focus-visible {
    color: var(--app-primary);
    background: var(--app-primary-soft);
}

.dashboard-tabs-bar {
    position: sticky;
    top: 72px;
    z-index: 35;
    display: flex;
    align-items: end;
    min-height: 48px;
    padding: 0 clamp(18px, 3vw, 40px);
    border-bottom: 1px solid var(--app-border);
    background: color-mix(in srgb, var(--app-bg-soft) 82%, var(--app-surface));
    overflow: visible;
}

html[data-theme="dark"] .dashboard-tabs-bar {
    background: color-mix(in srgb, #111c31 84%, var(--app-surface));
}

.dashboard-tabs {
    gap: 8px;
    align-items: flex-end;
    min-height: 48px;
}

.dashboard-tab {
    flex: 0 1 var(--tab-computed-width, 146px);
    width: var(--tab-computed-width, 146px);
    min-height: 36px;
    padding: 0 14px;
    border-radius: 8px 8px 0 0;
    border-color: var(--app-border);
    background: transparent;
    color: var(--app-text-muted);
    font-size: 12px;
    font-weight: 700;
    box-shadow: none;
}

.dashboard-tab:hover,
.dashboard-tab:focus-visible {
    background: var(--app-primary-soft);
    color: var(--app-primary);
    outline: none;
}

.dashboard-tab.is-active {
    min-height: 40px;
    background: var(--app-bg);
    color: var(--app-text);
    border-color: var(--app-border);
    border-bottom-color: var(--app-bg);
    box-shadow: none;
    transform: translateY(1px);
}

.dashboard-workspace-shell {
    min-height: 0;
    background:
        linear-gradient(180deg, color-mix(in srgb, var(--app-surface) 52%, transparent) 0%, transparent 320px),
        transparent;
}

.dashboard-home {
    min-height: 100%;
    padding: clamp(36px, 5vw, 68px) clamp(18px, 4vw, 56px) 48px;
    background: transparent;
}

.dashboard-grid {
    width: min(100%, 920px);
    margin: 0 auto;
    grid-template-columns: repeat(4, minmax(150px, 1fr));
    gap: 18px;
    justify-content: center;
}

.dashboard-card {
    --card-accent: var(--app-primary);
    min-height: 164px;
    aspect-ratio: auto;
    align-content: space-between;
    justify-items: start;
    gap: 18px;
    padding: 20px;
    border-radius: 8px;
    border-color: var(--app-border);
    background:
        linear-gradient(180deg, color-mix(in srgb, var(--app-surface) 96%, #ffffff) 0%, var(--app-surface-soft) 100%);
    text-align: left;
    box-shadow: var(--app-shadow-sm);
    position: relative;
    overflow: hidden;
}

html[data-theme="dark"] .dashboard-card {
    background:
        linear-gradient(180deg, color-mix(in srgb, var(--app-surface-raised) 82%, #0f172a) 0%, var(--app-surface) 100%);
}

.dashboard-card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: var(--card-accent);
    opacity: 0.9;
}

.dashboard-card::after {
    content: '';
    position: absolute;
    right: 16px;
    bottom: 14px;
    width: 22px;
    height: 22px;
    border-right: 2px solid color-mix(in srgb, var(--card-accent) 55%, transparent);
    border-bottom: 2px solid color-mix(in srgb, var(--card-accent) 55%, transparent);
    opacity: 0;
    transform: translate(-6px, -6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
}

.dashboard-card:hover,
.dashboard-card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--card-accent) 48%, var(--app-border));
    background: var(--app-surface-raised);
    box-shadow: var(--app-shadow-md);
    outline: none;
}

.dashboard-card:hover::after,
.dashboard-card:focus-visible::after {
    opacity: 1;
    transform: translate(0, 0);
}

.dashboard-card-icon {
    width: 58px !important;
    height: 58px !important;
    flex-basis: 58px !important;
    border-radius: 8px;
    background: color-mix(in srgb, var(--card-accent) 14%, var(--app-surface));
    color: var(--card-accent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 18%, transparent);
    box-shadow: none;
}

.dashboard-card:hover .dashboard-card-icon,
.dashboard-card:focus-visible .dashboard-card-icon {
    background: color-mix(in srgb, var(--card-accent) 22%, var(--app-surface));
    color: var(--card-accent);
}

.dashboard-card-icon .table-icon-media,
.dashboard-card-icon .icon-image,
.dashboard-card-icon .icon-svg-mask {
    width: min(var(--config-icon-size, 34px), 38px);
    height: min(var(--config-icon-size, 34px), 38px);
}

.dashboard-card-title {
    display: block;
    min-height: 38px;
    color: var(--app-text);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0;
}

.dashboard-card[data-icon-key="dashboardBusinessPartners"] { --card-accent: #0ea5a4; }
.dashboard-card[data-icon-key="dashboardQuotes"] { --card-accent: #0284c7; }
.dashboard-card[data-icon-key="dashboardInventory"] { --card-accent: #6366f1; }
.dashboard-card[data-icon-key="dashboardSettings"] { --card-accent: #8b5cf6; }
.dashboard-card[data-icon-key="dashboardOrders"] { --card-accent: #b7791f; }
.dashboard-card[data-icon-key="dashboardPlanning"] { --card-accent: #16a34a; }
.dashboard-card[data-icon-key="dashboardCosts"] { --card-accent: #dc2626; }

.dashboard-favorites {
    width: min(100%, 920px);
    margin: 28px auto 0;
    border: 1px solid var(--app-border);
    border-radius: 8px;
    background: var(--app-surface);
    box-shadow: var(--app-shadow-sm);
}

.dashboard-search-popover,
.dashboard-inventory-popover {
    border-radius: 8px;
}

@media (max-width: 980px) {
    .dashboard-grid {
        grid-template-columns: repeat(3, minmax(150px, 1fr));
    }
}

@media (max-width: 720px) {
    .dashboard-app-shell {
        grid-template-rows: 64px auto 1fr;
    }
    .dashboard-topbar .brand {
        min-height: 64px;
        padding: 0 14px;
        column-gap: 10px;
    }
    .dashboard-topbar .company-logo,
    .dashboard-topbar .brand-mark {
        width: 44px;
        height: 44px;
        min-width: 44px;
    }
    .dashboard-topbar .brand h1 {
        font-size: 22px;
    }
    .dashboard-tabs-bar {
        top: 64px;
        min-height: 44px;
        padding: 0 12px;
        overflow-x: auto;
    }
    .dashboard-tabs {
        flex-wrap: nowrap;
    }
    .dashboard-home {
        padding: 24px 14px 36px;
    }
    .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }
    .dashboard-card {
        min-height: 148px;
        padding: 16px;
    }
}

