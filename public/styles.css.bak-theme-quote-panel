:root {
    --app-bg: #f8fafc;
    --app-bg-soft: #f1f5f9;
    --app-surface: #ffffff;
    --app-surface-raised: #ffffff;
    --app-surface-soft: #f8fafc;
    --app-text: #0f172a;
    --app-text-soft: #475569;
    --app-text-muted: #64748b;
    --app-border: #e2e8f0;
    --app-border-strong: #cbd5e1;
    --app-primary: #0277a9;
    --app-primary-strong: #03638c;
    --app-primary-soft: rgba(2, 119, 169, 0.12);
    --app-accent: #fbbf24;
    --app-accent-soft: rgba(251, 191, 36, 0.16);
    --app-danger: #dc2626;
    --app-success: #16a34a;
    --app-warning: #b7791f;
    --app-ring: rgba(2, 119, 169, 0.18);
    --app-shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
    --app-shadow-md: 0 14px 32px rgba(15, 23, 42, 0.10);
    --app-shadow-lg: 0 24px 58px rgba(15, 23, 42, 0.16);
    --blue: #11a3dd;
    --border: #d9dee4;
    --grid: #edf1f5;
    --text: #2f3740;
    --muted: #8a93a0;
    --logo-width: 116px;
    --header-label-width: 58px;
    --field-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --field-height: 18px;
    --field-font-size: 12px;
    --quote-number-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --quote-number-font-size: 16px;
    --quote-number-font-weight: 600;
    --quote-number-width: 102px;
    --quote-number-align-self: center;
    --quote-number-justify: flex-end;
    --quote-number-text-align: center;
    --quote-number-padding-top: 0px;
    --quote-number-padding-right: 14px;
    --quote-number-padding-bottom: 0px;
    --quote-number-padding-left: 14px;
    --quote-number-height: 28px;
    --table-row-height: 22px;
    --table-header-font-size: 11px;
    --table-font-size: 12px;
    --table-header-height: 29px;
    --visible-table-rows: 10;
    --tab-width: 88px;
    --tab-height: 18px;
    --page-margin-top: 14px;
    --page-margin-right: 16px;
    --page-margin-bottom: 8px;
    --page-margin-left: 16px;
    --brand-width: 116px;
    --brand-font-family: Georgia, 'Times New Roman', serif;
    --brand-font-size: 22px;
    --brand-vertical-align: center;
    --brand-horizontal-align: center;
    --brand-text-align: center;
    --brand-margin-top: 0px;
    --brand-margin-right: 0px;
    --brand-margin-bottom: 0px;
    --brand-margin-left: 0px;
    --title-margin-left: 30px;
    --module-title-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --module-title-font-size: 16px;
    --module-title-color: #ffffff;
    --module-title-horizontal-align: flex-start;
    --module-title-text-align: left;
    --module-title-width: auto;
    --table-header-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --icon-color: #9ba2ab;
    --app-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --header-border-color: #11a3dd;
    --footer-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    --footer-font-size: 12px;
    --footer-color: #2f3740;
    --footer-margin-top: 0px;
    --footer-margin-bottom: 0px;
}

html[data-theme="dark"] {
    --app-bg: #0f172a;
    --app-bg-soft: #111c31;
    --app-surface: #162033;
    --app-surface-raised: #1b263b;
    --app-surface-soft: #1e293b;
    --app-text: #f8fafc;
    --app-text-soft: #cbd5e1;
    --app-text-muted: #94a3b8;
    --app-border: #26364d;
    --app-border-strong: #33445d;
    --app-primary: #38bdf8;
    --app-primary-strong: #7dd3fc;
    --app-primary-soft: rgba(56, 189, 248, 0.14);
    --app-accent: #fbbf24;
    --app-accent-soft: rgba(251, 191, 36, 0.18);
    --app-danger: #f87171;
    --app-success: #4ade80;
    --app-warning: #facc15;
    --app-ring: rgba(56, 189, 248, 0.22);
    --app-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.28);
    --app-shadow-md: 0 16px 34px rgba(0, 0, 0, 0.34);
    --app-shadow-lg: 0 28px 64px rgba(0, 0, 0, 0.42);
    --blue: var(--app-primary);
    --border: var(--app-border);
    --grid: #223149;
    --text: var(--app-text);
    --muted: var(--app-text-muted);
    --icon-color: var(--app-text-muted);
    --header-border-color: var(--app-primary);
    --footer-color: var(--app-text-soft);
}

* { box-sizing: border-box; }

[hidden] { display: none !important; }
html, body {
    margin: 0;
    min-height: 100%;
    background: #fff;
    color: var(--text);
    font-family: var(--app-font-family);
}
body { display: flex; overflow: auto; }
body.popover-open { overflow: hidden; }
.dashboard-body {
    margin: 0;
    min-height: 100vh;
    background: #ffffff;
}
.dashboard-shell,
.dashboard-app-shell {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto auto 1fr;
}
.dashboard-app-shell {
    position: relative;
}
.dashboard-topbar {
    position: relative;
    z-index: 32;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(17, 31, 43, 0.12), 0 1px 0 rgba(216, 225, 233, 0.9);
}
.dashboard-topbar .brand {
    padding: 8px 14px;
    min-height: 56px;
    box-shadow: none;
}
.dashboard-tabs-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 10px var(--page-margin-right) 0 var(--page-margin-left);
    background: #ffffff;
    border-bottom: 0;
    overflow: hidden;
}
.dashboard-tabs-bar.is-multirow {
    padding-bottom: 6px;
}
.dashboard-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    overflow: hidden;
    padding: 0;
    width: 100%;
    max-width: 100%;
    align-items: flex-end;
    align-content: flex-start;
    row-gap: 8px;
}
.dashboard-tab {
    --tab-accent: #d9e1e8;
    --tab-bg: transparent;
    --tab-bg-hover: #f5f8fb;
    --tab-bg-active: #ffffff;
    --tab-text: #71808d;
    --tab-text-active: #14212c;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 1 var(--tab-computed-width, 140px);
    width: var(--tab-computed-width, 140px);
    min-width: 0;
    max-width: min(100%, var(--tab-computed-width, 140px));
    overflow: hidden;
    padding: 8px 10px;
    border: 1px solid color-mix(in srgb, var(--tab-accent) 24%, transparent);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    background: var(--tab-bg);
    color: var(--tab-text);
    font-size: 13px;
    white-space: nowrap;
    position: relative;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
}
.dashboard-tab-label {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.dashboard-tab.is-draggable {
    cursor: grab;
}
.dashboard-tab.is-draggable:active {
    cursor: grabbing;
}
.dashboard-tab.is-dragging {
    opacity: 0.55;
}
.dashboard-tab.has-family-gap {
    margin-left: 10px;
}
.dashboard-tab.has-family-gap::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 12px;
    width: 1px;
    height: calc(100% - 16px);
    background: linear-gradient(180deg, rgba(176, 188, 199, 0) 0%, rgba(176, 188, 199, 0.95) 24%, rgba(176, 188, 199, 0.95) 76%, rgba(176, 188, 199, 0) 100%);
}
.dashboard-tab.is-active {
    background: var(--tab-bg-active);
    color: var(--tab-text-active);
    border-color: color-mix(in srgb, var(--tab-accent) 48%, #ffffff 52%);
    box-shadow: 0 1px 0 #ffffff, 0 10px 18px rgba(16, 31, 45, 0.08);
    transform: translateY(1px);
}
.dashboard-tab:hover,
.dashboard-tab:focus-visible {
    color: var(--tab-text-active);
    background: var(--tab-bg-hover);
}
.dashboard-tab.family-home {
    --tab-accent: #cbd5de;
    --tab-bg: rgba(236, 241, 245, 0.88);
    --tab-bg-hover: #eef3f7;
    --tab-bg-active: #ffffff;
    flex: 0 0 var(--tab-computed-width, 120px);
    width: var(--tab-computed-width, 120px);
    max-width: min(100%, var(--tab-computed-width, 120px));
}
.dashboard-tab.family-quotes.level-root {
    --tab-accent: #ee8b2d;
    --tab-bg: linear-gradient(180deg, rgba(255, 186, 120, 0.36) 0%, rgba(255, 171, 86, 0.16) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(255, 189, 126, 0.48) 0%, rgba(255, 175, 94, 0.24) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(255, 194, 140, 0.42) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #8f4f12;
    --tab-text-active: #6f3d10;
}
.dashboard-tab.family-quotes.level-child {
    --tab-accent: #f1a451;
    --tab-bg: linear-gradient(180deg, rgba(255, 212, 171, 0.32) 0%, rgba(255, 229, 206, 0.78) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(255, 218, 183, 0.48) 0%, rgba(255, 235, 217, 0.92) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(255, 224, 196, 0.7) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #99643b;
    --tab-text-active: #7a4c22;
}
.dashboard-tab.family-orders.level-root {
    --tab-accent: #b6922d;
    --tab-bg: linear-gradient(180deg, rgba(240, 214, 126, 0.38) 0%, rgba(220, 190, 83, 0.16) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(243, 220, 139, 0.5) 0%, rgba(224, 196, 95, 0.24) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(245, 226, 160, 0.42) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #735915;
    --tab-text-active: #5b450d;
}
.dashboard-tab.family-orders.level-child {
    --tab-accent: #ceb460;
    --tab-bg: linear-gradient(180deg, rgba(245, 233, 181, 0.34) 0%, rgba(247, 241, 217, 0.82) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(246, 236, 193, 0.48) 0%, rgba(248, 243, 223, 0.94) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(249, 239, 203, 0.76) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #806b2f;
    --tab-text-active: #66521f;
}
.dashboard-tab.family-partners.level-root {
    --tab-accent: #2c9f95;
    --tab-bg: linear-gradient(180deg, rgba(117, 212, 201, 0.34) 0%, rgba(56, 184, 168, 0.16) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(129, 217, 207, 0.46) 0%, rgba(64, 191, 175, 0.24) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(158, 227, 219, 0.44) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #16655e;
    --tab-text-active: #10524d;
}
.dashboard-tab.family-partners.level-child {
    --tab-accent: #6abfb6;
    --tab-bg: linear-gradient(180deg, rgba(192, 235, 230, 0.42) 0%, rgba(230, 247, 245, 0.84) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(201, 239, 235, 0.52) 0%, rgba(236, 249, 247, 0.94) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(214, 243, 239, 0.78) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #2a756d;
    --tab-text-active: #1f5f59;
}
.dashboard-tab.family-inventory.level-root {
    --tab-accent: #5f80c8;
    --tab-bg: linear-gradient(180deg, rgba(150, 180, 245, 0.34) 0%, rgba(95, 128, 200, 0.16) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(162, 189, 248, 0.44) 0%, rgba(104, 136, 206, 0.24) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(180, 202, 248, 0.42) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #35548f;
    --tab-text-active: #27406f;
}
.dashboard-tab.family-inventory.level-child {
    --tab-accent: #8fa8db;
    --tab-bg: linear-gradient(180deg, rgba(214, 224, 247, 0.42) 0%, rgba(236, 241, 251, 0.86) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(220, 229, 249, 0.52) 0%, rgba(241, 245, 252, 0.94) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(228, 235, 250, 0.8) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #536faa;
    --tab-text-active: #3e5687;
}
.dashboard-tab.family-settings {
    --tab-accent: #8b74bb;
    --tab-bg: linear-gradient(180deg, rgba(191, 174, 226, 0.34) 0%, rgba(139, 116, 187, 0.16) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(199, 183, 230, 0.46) 0%, rgba(146, 123, 193, 0.24) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(210, 197, 236, 0.42) 0%, rgba(255, 255, 255, 0.98) 100%);
    --tab-text: #5a4586;
    --tab-text-active: #47356b;
}
.dashboard-tab.family-default {
    --tab-accent: #90a2b4;
    --tab-bg: linear-gradient(180deg, rgba(223, 229, 235, 0.5) 0%, rgba(244, 247, 249, 0.92) 100%);
    --tab-bg-hover: linear-gradient(180deg, rgba(229, 234, 239, 0.7) 0%, rgba(248, 250, 252, 0.98) 100%);
    --tab-bg-active: linear-gradient(180deg, rgba(235, 239, 243, 0.78) 0%, rgba(255, 255, 255, 0.98) 100%);
}
.dashboard-tab-close {
    margin-left: auto;
    flex: 0 0 auto;
    opacity: 0.45;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
}
.dashboard-tab-close:hover,
.dashboard-tab-close:focus-visible {
    opacity: 1;
    color: var(--icon-hover-color, #0b81b8);
}
.dashboard-main {
    min-height: 0;
}
.dashboard-home {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 24px var(--page-margin-right) 18px var(--page-margin-left);
    width: 100%;
}
.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(180px, 220px));
    justify-content: center;
    gap: 18px;
}
.dashboard-card {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 12px;
    aspect-ratio: 1 / 1;
    padding: 18px;
    border: 1px solid #d8e2ea;
    border-radius: 24px;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 10px 24px rgba(19, 39, 54, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
}
.dashboard-card:hover,
.dashboard-card:focus-visible {
    transform: translateY(-2px);
    border-color: #a5d4e7;
    box-shadow: 0 16px 30px rgba(19, 39, 54, 0.11);
    background: #f8fbfd;
}
.dashboard-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    flex: 0 0 54px;
    color: var(--icon-base-color, #0b81b8);
    transition: color 0.18s ease, transform 0.18s ease;
}
.dashboard-card-icon .icon-glyph {
    color: currentColor;
    font-size: var(--config-icon-size, 38px);
}
.dashboard-card-icon .icon-svg-mask,
.dashboard-card-icon .icon-image {
    width: var(--config-icon-size, 38px);
    height: var(--config-icon-size, 38px);
}
.dashboard-card:hover .dashboard-card-icon,
.dashboard-card:focus-visible .dashboard-card-icon {
    color: var(--icon-hover-color, #17abdf);
    transform: translateY(-1px);
}
.dashboard-card-title {
    font-size: 13px;
    font-weight: 500;
    color: #7b8894;
}
.dashboard-card:hover .dashboard-card-title,
.dashboard-card:focus-visible .dashboard-card-title {
    color: #2b3c49;
}
.dashboard-access-empty {
    align-self: center;
    display: grid;
    gap: 8px;
    max-width: 520px;
    margin: 18px auto 0;
    padding: 22px 26px;
    border: 1px dashed #b8cbd8;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.78);
    color: #5d6a76;
    text-align: center;
    box-shadow: 0 16px 34px rgba(19, 39, 54, 0.07);
}
.dashboard-access-empty strong {
    color: #283643;
    font-size: 15px;
}
.dashboard-access-empty span {
    font-size: 13px;
}
.dashboard-access-toast {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 80;
    max-width: min(360px, calc(100vw - 44px));
    padding: 13px 16px;
    border: 1px solid #cddde8;
    border-radius: 16px;
    background: #ffffff;
    color: #33414f;
    font-size: 13px;
    box-shadow: 0 18px 38px rgba(19, 39, 54, 0.16);
}
.dashboard-inventory-empty {
    padding: 12px 14px;
    color: #6f7d89;
    font-size: 12px;
    text-align: center;
}
.erp-access-blocked {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 28px;
    background: linear-gradient(135deg, #eef5f9 0%, #ffffff 58%, #f5efe8 100%);
}
.erp-access-blocked section {
    display: grid;
    gap: 10px;
    max-width: 430px;
    padding: 28px;
    border: 1px solid #d6e3eb;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.9);
    color: #5c6a76;
    text-align: center;
    box-shadow: 0 20px 42px rgba(19, 39, 54, 0.11);
}
.erp-access-blocked strong {
    color: #263542;
    font-size: 20px;
}
.erp-access-blocked a {
    justify-self: center;
    margin-top: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: #0b81b8;
    color: #ffffff;
    text-decoration: none;
}
.dashboard-workspace {
    min-height: 0;
    height: 100%;
    padding: 0;
    position: relative;
}
.dashboard-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: #ffffff;
    box-shadow: none;
}
.dashboard-frame[hidden] {
    display: none;
}
.dashboard-workspace-shell {
    min-height: 0;
    padding-top: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
}
.dashboard-workspace-shell.has-tab-wrap {
    padding-top: 0;
}

.dashboard-favorites {
    position: sticky;
    bottom: 0;
    width: min(980px, 100%);
    margin: auto auto 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    z-index: 2;
}

.dashboard-favorites-head {
    display: none;
}

.dashboard-favorites-body {
    display: block;
}

.dashboard-favorites-drum-shell {
    width: 100%;
}

.dashboard-favorites-drum-viewport {
    width: min(980px, 100%);
    height: var(--favorite-drum-height, 220px);
    margin: 0 auto;
    overflow: hidden;
    cursor: grab;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.24) 10%, #000 24%, #000 76%, rgba(0,0,0,0.24) 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.24) 10%, #000 24%, #000 76%, rgba(0,0,0,0.24) 90%, transparent 100%);
}

.dashboard-favorites-drum-viewport:active {
    cursor: grabbing;
}

.dashboard-favorites-drum-canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.dashboard-favorites-empty {
    padding: 14px 16px;
    border: 1px dashed #d5e0e8;
    border-radius: 16px;
    color: #7b8894;
    background: #f9fbfd;
    font-size: 13px;
}

.dashboard-favorites-reel {
    position: relative;
    display: grid;
    gap: 6px;
    max-height: 236px;
    overflow-y: auto;
    padding: 88px 0;
    perspective: 1200px;
    scroll-snap-type: y proximity;
    scrollbar-width: none;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.25) 10%, #000 26%, #000 74%, rgba(0,0,0,0.25) 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.25) 10%, #000 26%, #000 74%, rgba(0,0,0,0.25) 90%, transparent 100%);
    transition: transform 0.28s cubic-bezier(0.22, 0.8, 0.22, 1);
}

.dashboard-favorites-reel::-webkit-scrollbar {
    display: none;
}

.dashboard-favorites-reel.is-bounce-top {
    transform: translateY(12px);
}

.dashboard-favorites-reel.is-bounce-bottom {
    transform: translateY(-12px);
}

.dashboard-favorites-reel::before,
.dashboard-favorites-reel::after {
    content: none;
}

.dashboard-favorites-item {
    display: block;
    width: min(920px, 100%);
    margin: 0 auto;
    padding: 9px 10px;
    border: 0;
    background: transparent;
    text-align: center;
    cursor: pointer;
    transform-origin: center center;
    transition: transform 0.18s ease, opacity 0.18s ease, color 0.18s ease, filter 0.18s ease;
    scroll-snap-align: center;
    pointer-events: none;
}

.dashboard-favorites-item:hover,
.dashboard-favorites-item:focus-visible {
