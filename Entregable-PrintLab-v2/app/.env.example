# ==========================================
# PrintLab - Configuracion de Entorno
# ==========================================
# Copie este archivo como .env y ajuste los valores

# Puerto del servidor Express
PORT=3000

# Conexion a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/basedatos?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/printlab?sslmode=disable

# Modo SSL para PostgreSQL (require, prefer, disable)
PGSSLMODE=disable

# Modo de entorno (development, production)
NODE_ENV=production

# Contrasena de emergencia para el usuario admin
# Por seguridad, cambie este valor en produccion
ADMIN_EMERGENCY_PASSWORD=cambiar_esta_contrasena

# Directorio de origen para imagenes de troqueles (opcional)
# Si se deja vacio, se usa la carpeta imports/troqueles dentro de la aplicacion
TROQUEL_IMAGE_SOURCE_DIR=

# Directorio de origen para importacion de datos maestros (opcional)
# Si se deja vacio, se usa la carpeta import-data dentro de la aplicacion
IMPORT_SOURCE_ROOT=

# === CONFIGURACION DE BASE DE DATOS (alternativa a DATABASE_URL) ===
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=printlab
# DB_USER=usuario
# DB_PASSWORD=password
# DB_SCHEMA=public

# === CONFIGURACION SSL ===
# PGCHANNELBINDING=require
